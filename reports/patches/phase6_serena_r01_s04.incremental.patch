 use crate::hay::SHERLOCK;
 use crate::util::{sort_lines, Dir, TestCommand};
 
+rgtest!(global_ignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    dir.create_dir(".git");
+    dir.create_dir("a/b/c/nested");
+    dir.create("a/b/c/haystack", "test");
+    dir.create("a/b/c/keep", "test");
+    dir.create("a/b/c/nested/haystack", "test");
+    dir.create(".global-ignore", "/haystack\n");
+    let ignore = dir.path().join(".global-ignore");
+    let config = format!(
+        "[core]\nexcludesFile = {}\n",
+        ignore.to_string_lossy().replace('\\', "/")
+    );
+    dir.create(".gitconfig", &config);
+    let cwd = dir.path().join("a/b/c").canonicalize().unwrap();
+    let searches = [
+        (std::path::PathBuf::from("."), vec!["keep", "nested/haystack"]),
+        (cwd.clone(), vec!["keep", "nested/haystack"]),
+        (std::path::PathBuf::from("nested"), vec!["haystack"]),
+        (cwd.join("nested"), vec!["haystack"]),
+    ];
+    for git_global in [false, true] {
+        for threads in ["1", "4"] {
+            for (search, files) in &searches {
+                let mut cmd = dir.command();
+                cmd.current_dir(&cwd);
+                cmd.cmd().env("HOME", dir.path());
+                cmd.cmd().env("USERPROFILE", dir.path());
+                cmd.cmd().env("XDG_CONFIG_HOME", dir.path().join("xdg"));
+                if !git_global {
+                    cmd.args(&["--no-ignore-global", "--ignore-file"]);
+                    cmd.arg(&ignore);
+                }
+                cmd.args(&["--files", "--threads", threads]).arg(search);
+                let expected = files
+                    .iter()
+                    .map(|file| {
+                        search.join(file).to_string_lossy().replace('\\', "/")
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                eqnice!(sort_lines(&expected), sort_lines(&cmd.stdout()));
+            }
+        }
+    }
+});
+
