+    #[test]
+    fn min_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for path in ["foo", "a/foo", "a/b/foo", "a/b/c/foo"] {
+            wfile(td.path().join(path), "");
+        }
+        let all = [
+            ("", 0),
+            ("a", 1),
+            ("foo", 1),
+            ("a/b", 2),
+            ("a/foo", 2),
+            ("a/b/c", 3),
+            ("a/b/foo", 3),
+            ("a/b/c/foo", 4),
+        ];
+        let mut builder = WalkBuilder::new(td.path());
+        for min in [None, Some(0), Some(1), Some(2), Some(4), Some(5)] {
+            let expected: Vec<_> = all
+                .iter()
+                .copied()
+                .filter(|&(_, depth)| depth >= min.unwrap_or(0))
+                .collect();
+            assert_depth_paths(td.path(), builder.min_depth(min), &expected);
+        }
+        assert_depth_paths(
+            td.path(),
+            builder.min_depth(Some(usize::MAX)),
+            &[],
+        );
+        assert_depth_paths(td.path(), builder.min_depth(None), &all);
+    }
+
+    #[test]
+    fn min_max_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for path in ["foo", "a/foo", "a/b/foo", "a/b/c/foo"] {
+            wfile(td.path().join(path), "");
+        }
+        let cases: &[(usize, usize, &[(&str, usize)])] = &[
+            (0, 0, &[("", 0)]),
+            (1, 2, &[("a", 1), ("foo", 1), ("a/b", 2), ("a/foo", 2)]),
+            (2, 2, &[("a/b", 2), ("a/foo", 2)]),
+            (3, 1, &[("a/b/c", 3), ("a/b/foo", 3)]),
+            (1, 0, &[("a", 1), ("foo", 1)]),
+            (4, 0, &[("a/b/c/foo", 4)]),
+            (5, 1, &[]),
+            (usize::MAX, 0, &[]),
+        ];
+        for &(min, max, expected) in cases {
+            let mut builder = WalkBuilder::new(td.path());
+            builder.min_depth(Some(min)).max_depth(Some(max));
+            assert_depth_paths(td.path(), &builder, expected);
+            let mut builder = WalkBuilder::new(td.path());
+            builder.max_depth(Some(max)).min_depth(Some(min));
+            assert_depth_paths(td.path(), &builder, expected);
+        }
+
+        // Normalizing a build must not overwrite the configured bounds.
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(3)).max_depth(Some(1));
+        assert_depth_paths(
+            td.path(),
+            &builder,
+            &[("a/b/c", 3), ("a/b/foo", 3)],
+        );
+        assert_depth_paths(
+            td.path(),
+            builder.min_depth(None),
+            &[("", 0), ("a", 1), ("foo", 1)],
+        );
+        assert_depth_paths(
+            td.path(),
+            builder.max_depth(None).min_depth(Some(3)),
+            &[("a/b/c", 3), ("a/b/foo", 3), ("a/b/c/foo", 4)],
+        );
+    }
+
