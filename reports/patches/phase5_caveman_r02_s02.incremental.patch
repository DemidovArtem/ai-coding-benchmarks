index 0000000000000000000000000000000000000000..54af54655f01d4c91c45bec16fcaa16b3831e8df
--- /dev/null
+++ b/crates/ignore/tests/unclosed_class.rs
@@ -0,0 +1,72 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        let ignore = GitignoreBuilder::new("")
+            .add_line(None, pattern)
+            .unwrap()
+            .build()
+            .unwrap();
+        assert!(ignore.matched(pattern, false).is_ignore(), "{pattern:?}");
+        assert!(
+            ignore.matched(format!("dir/{pattern}"), false).is_ignore(),
+            "{pattern:?}",
+        );
+        assert!(!ignore.matched("abc", false).is_ignore());
+    }
+}
+
+#[test]
+fn gitignore_toggle_affects_only_subsequent_patterns() {
+    let mut builder = GitignoreBuilder::new("");
+    builder.add_line(None, "[abc").unwrap();
+    assert!(builder
+        .allow_unclosed_class(false)
+        .add_line(None, "[def")
+        .is_err());
+    builder.add_line(None, "[xyz]").unwrap();
+    builder.allow_unclosed_class(true).add_line(None, "[ghi").unwrap();
+    let ignore = builder.build().unwrap();
+    assert!(ignore.matched("[abc", false).is_ignore());
+    assert!(ignore.matched("[ghi", false).is_ignore());
+    assert!(ignore.matched("x", false).is_ignore());
+    assert!(!ignore.matched("[def", false).is_ignore());
+}
+
+#[test]
+fn overrides_are_strict_by_default_and_allow_opt_in() {
+    let mut builder = OverrideBuilder::new("");
+    assert!(builder.add("[abc").is_err());
+    builder.allow_unclosed_class(true).add("[abc").unwrap();
+    builder.add("![def").unwrap();
+    assert!(builder.allow_unclosed_class(false).add("[ghi").is_err());
+    let overrides = builder.build().unwrap();
+    assert!(overrides.matched("[abc", false).is_whitelist());
+    assert!(overrides.matched("dir/[abc", false).is_whitelist());
+    assert!(overrides.matched("[def", false).is_ignore());
+    assert!(overrides.matched("abc", false).is_ignore());
+}
+
+#[test]
+fn unclosed_classes_combine_with_case_insensitivity() {
+    let ignore = GitignoreBuilder::new("")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .unwrap()
+        .add_line(None, "[ABC")
+        .unwrap()
+        .build()
+        .unwrap();
+    assert!(ignore.matched("[abc", false).is_ignore());
+
+    let overrides = OverrideBuilder::new("")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .unwrap()
+        .add("[ABC")
+        .unwrap()
+        .build()
+        .unwrap();
+    assert!(overrides.matched("[abc", false).is_whitelist());
+}
