+    #[test]
+    fn max_matches_multiline() {
+        for (pattern, limit, after, expected) in [
+            ("a\\nb", 1, 0, "0:a\n2:b\n"),
+            ("a\\nb", 2, 0, "0:a\n2:b\n4:a\n6:b\n"),
+            ("a\\nb", 1, 1, "0:a\n2:b\n4:a\n6:b\n8-x\n"),
+            ("(?m:^)", 1, 0, "0:a\n"),
+        ] {
+            let matcher = RegexMatcher::new(pattern);
+            for reader in [false, true] {
+                let mut searcher = SearcherBuilder::new()
+                    .multi_line(true)
+                    .max_matches(Some(limit))
+                    .after_context(after)
+                    .line_number(false)
+                    .build();
+                let mut sink = KitchenSink::new();
+                let haystack = b"a\nb\na\nb\nx\n";
+                if reader {
+                    searcher
+                        .search_reader(&matcher, &haystack[..], &mut sink)
+                        .unwrap();
+                } else {
+                    searcher
+                        .search_slice(&matcher, haystack, &mut sink)
+                        .unwrap();
+                }
+                let got = std::str::from_utf8(sink.as_bytes()).unwrap();
+                assert_eq!(
+                    got.split("\nbyte count:").next().unwrap(),
+                    expected
+                );
+            }
+        }
+    }
