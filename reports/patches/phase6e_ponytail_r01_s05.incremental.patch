+    struct ShortReads<'a> {
+        bytes: &'a [u8],
+        limit: usize,
+    }
+
+    impl io::Read for ShortReads<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            let len = buf.len().min(self.limit);
+            self.bytes.read(&mut buf[..len])
+        }
+    }
+
+    #[test]
+    fn buffer_fills_capacity_with_short_reads() {
+        let bytes = b"a\nb\nc\nd\ne";
+        let mut linebuf = LineBufferBuilder::new().capacity(6).build();
+        let input = ShortReads { bytes, limit: 2 };
+        let mut rdr = LineBufferReader::new(input, &mut linebuf);
+        assert!(rdr.fill().unwrap());
+        assert_eq!(rdr.bstr(), "a\nb\nc\n");
+        rdr.consume_all();
+        assert!(rdr.fill().unwrap());
+        assert_eq!(rdr.bstr(), "d\ne");
+        rdr.consume_all();
+        assert!(!rdr.fill().unwrap());
+        assert_eq!(rdr.absolute_byte_offset(), bytes.len() as u64);
+    }
+
+    #[test]
+    fn buffer_short_reads_detect_binary_incrementally() {
+        for binary in [BinaryDetection::Quit(0), BinaryDetection::Convert(0)] {
+            let mut linebuf = LineBufferBuilder::new()
+                .capacity(8)
+                .binary_detection(binary)
+                .build();
+            let mut input = ShortReads { bytes: b"a\nb\0c\0d\n", limit: 2 };
+            let mut rdr = LineBufferReader::new(&mut input, &mut linebuf);
+            assert!(rdr.fill().unwrap());
+            assert_eq!(rdr.binary_byte_offset(), Some(3));
+            if binary.is_quit() {
+                assert_eq!(rdr.bstr(), "a\nb");
+            } else {
+                assert_eq!(rdr.bstr(), "a\nb\nc\nd\n");
+            }
+            rdr.consume_all();
+            assert!(!rdr.fill().unwrap());
+            if binary.is_quit() {
+                assert_eq!(input.bytes, b"c\0d\n");
+            }
+        }
+    }
