+    #[test]
+    fn min_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for file in ["foo", "a/foo", "a/b/foo", "a/b/c/foo"] {
+            wfile(td.path().join(file), "");
+        }
+        let all = [
+            ("", 0),
+            ("a", 1),
+            ("foo", 1),
+            ("a/b", 2),
+            ("a/foo", 2),
+            ("a/b/c", 3),
+            ("a/b/foo", 3),
+            ("a/b/c/foo", 4),
+        ];
+        for threads in [1, 4] {
+            let mut builder = WalkBuilder::new(td.path());
+            builder.threads(threads);
+            assert_depth_entries(td.path(), &builder, &all);
+            for min in [0, 1, 2, 3, 4, 5, usize::MAX] {
+                let expected: Vec<_> = all
+                    .iter()
+                    .copied()
+                    .filter(|&(_, depth)| depth >= min)
+                    .collect();
+                assert_depth_entries(
+                    td.path(),
+                    builder.min_depth(Some(min)),
+                    &expected,
+                );
+            }
+            assert_depth_entries(td.path(), builder.min_depth(None), &all);
+        }
+    }
