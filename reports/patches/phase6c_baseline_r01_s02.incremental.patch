@@ -0,0 +1,125 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn check(pattern: &str, yes: &[&str], no: &[&str]) {
+    let glob = GlobBuilder::new(pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &(paths, expected) in &[(yes, true), (no, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+            assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_text_matches_literally() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[abc*?",
+        "[a{b,c}", "prefix[abc", "[☃é",
+    ] {
+        check(pattern, &[pattern], &["", &pattern[1..]]);
+    }
+    check("pre*[abc*?.rs", &["prefix[abc*?.rs"], &["prefix[abcxyz.rs"]);
+}
+
+#[test]
+fn unclosed_classes_keep_alternation_branches_separate() {
+    check("{[abc,xyz}", &["[abc", "xyz"], &["a", "[abc,xyz"]);
+    check("{[abc,[xyz}", &["[abc", "[xyz"], &["abc", "xyz"]);
+    check("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "xyz"]);
+    check(
+        "{a,{[bc,def},[ghi}",
+        &["a", "[bc", "def", "[ghi"],
+        &["b", "c", "ghi"],
+    );
+    check("{[],[!}", &["[]", "[!"], &["", "]", "!"]);
+    check("{[abc,xyz}*.rs", &["[abcmain.rs", "xyzlib.rs"], &["abc.rs"]);
+    assert_eq!(
+        GlobBuilder::new("{[abc,xyz")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
+
+#[test]
+fn closed_classes_keep_their_existing_semantics() {
+    check("[abc]", &["a", "b", "c"], &["[abc]", "d"]);
+    check("[[]", &["["], &["[[]"]);
+    check("[]]", &["]"], &["[]]"]);
+    check("[!]]", &["a"], &["]", "[!]]"]);
+    check("{[},],a}", &["}", ",", "a"], &["b"]);
+    for allow in [false, true] {
+        assert_eq!(
+            GlobBuilder::new("[z-a]")
+                .allow_unclosed_class(allow)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::InvalidRange('z', 'a'),
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    let glob = GlobBuilder::new("src/*[ABC")
+        .allow_unclosed_class(true)
+        .literal_separator(true)
+        .case_insensitive(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    assert!(matcher.is_match("SRC/file[abc"));
+    assert!(!matcher.is_match("src/sub/file[abc"));
+    assert!(!matcher.is_match("src/filea"));
+}
+
+#[cfg(unix)]
+#[test]
+fn unclosed_class_preserves_literal_escapes() {
+    check(r"[a\*", &[r"[a\*"], &["[a*", "[abc"]);
+    check(r"{[a\,b,c}", &[r"[a\,b", "c"], &["[a,b", "b"]);
+    check("[abc\\", &["[abc\\"], &["[abc"]);
+}
+
+#[test]
+fn many_unclosed_brackets_and_branches() {
+    // Both shapes must avoid rescanning the remaining pattern for each `[`.
+    let pattern = "[".repeat(100_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.regex().len(), 2 * pattern.len() + 7);
+
+    let pattern = format!("{{{}}}", vec!["["; 10_000].join(","));
+    GlobBuilder::new(&pattern).allow_unclosed_class(true).build().unwrap();
+}
