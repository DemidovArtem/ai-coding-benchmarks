+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[☃*?\\",
+        "prefix[abc*?{x,y}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &[pattern], true);
+        check_matches(glob, &["", "a", "abc", "prefixa"], false);
+    }
+}
+
+#[test]
+fn unclosed_classes_in_alternates() {
+    for (pattern, yes, no) in [
+        ("{[abc,xyz}", vec!["[abc", "xyz"], vec!["a", "abc", "[xyz"]),
+        ("{[abc,[xyz}", vec!["[abc", "[xyz"], vec!["a", "abc", "xyz"]),
+        ("{[abc],[xyz}", vec!["a", "b", "c", "[xyz"], vec!["[abc]", "x"]),
+        (
+            "{a,{[abc,xyz},[def}",
+            vec!["a", "[abc", "xyz", "[def"],
+            vec!["b", "d", "def"],
+        ),
+        ("{[a*,b?}", vec!["[a*", "bx"], vec!["[abc", "b"]),
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &yes, true);
+        check_matches(glob, &no, false);
+    }
+    assert_eq!(
+        GlobBuilder::new("{[abc")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
+
+#[test]
+fn unclosed_class_option_preserves_closed_classes() {
+    for pattern in ["[z-a]", "[z--]"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap_err(),
+            error,
+        );
+    }
+    for (pattern, path) in [
+        ("[abc]", "a"),
+        ("[!abc]", "x"),
+        ("[]]", "]"),
+        ("{[}],foo}", "}"),
+        ("{[a,b],foo}", ","),
+    ] {
+        check_matches(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap(),
+            &[path],
+            true,
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    let glob = GlobBuilder::new("src/*[ABC?")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    check_matches(glob.clone(), &["src/name[abc?"], true);
+    check_matches(glob, &["src/sub/name[abc?", "src/name[abcx"], false);
+}
+
+#[test]
+fn many_unclosed_classes() {
+    // Both a long literal tail and many branches must avoid repeated scans.
+    for pattern in ["[".repeat(20_000), format!("{{{}}}", "[,".repeat(5_000))]
+    {
+        GlobBuilder::new(&pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+    }
+}
