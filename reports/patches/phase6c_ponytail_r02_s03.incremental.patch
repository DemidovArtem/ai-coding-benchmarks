+    #[test]
+    fn min_depth_roots() {
+        let td = tmpdir();
+        mkdirp(td.path().join("empty"));
+        wfile(td.path().join("file"), "");
+        let mut builder = WalkBuilder::new(td.path().join("empty"));
+        builder.add(td.path().join("file")).add("-");
+        for min in [None, Some(0), Some(1), None] {
+            builder.min_depth(min);
+            let serial: Vec<_> = builder.build().map(Result::unwrap).collect();
+            let parallel = walk_collect_entries_parallel(&builder);
+            let expected = if min == Some(1) { 0 } else { 3 };
+            assert_eq!(serial.len(), expected);
+            assert_eq!(parallel.len(), expected);
+            assert!(serial.iter().all(|entry| entry.depth() == 0));
+            assert!(parallel.iter().all(|entry| entry.depth() == 0));
+        }
+        builder.max_depth(Some(0)).min_depth(Some(2));
+        builder.min_depth(None);
+        assert_eq!(builder.build().count(), 3);
+        assert_eq!(walk_collect_entries_parallel(&builder).len(), 3);
+    }
+
+    #[test]
+    fn min_depth_preserves_ignore_rules_and_errors() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b"));
