+        wfile(td.path().join(".ignore"), "excluded/\nfoo\n[z-a]\n");
+        wfile(td.path().join("a/.ignore"), "bar\n");
+        for path in ["a/foo", "a/bar", "a/keep", "a/b/keep"] {
+            wfile(td.path().join(path), "");
+        }
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(2));
+        assert_paths(td.path(), &builder, &["a/b", "a/keep", "a/b/keep"]);
+        assert_eq!(
+            builder.build().filter(|result| result.is_err()).count(),
+            1,
+        );
+        let errors = Mutex::new(0);
+        builder.build_parallel().run(|| {
+            Box::new(|result| {
+                match result {
+                    Ok(entry) => assert!(entry.depth() >= 2),
+                    Err(_) => *errors.lock().unwrap() += 1,
+                }
+                WalkState::Continue
+            })
+        });
+        assert_eq!(*errors.lock().unwrap(), 1);
+    }
