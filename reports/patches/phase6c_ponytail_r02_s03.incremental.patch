+    #[test]
+    fn min_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for path in ["foo", "a/foo", "a/b/foo", "a/b/c/foo"] {
+            wfile(td.path().join(path), "");
+        }
+        let all =
+            &["a", "a/b", "a/b/c", "foo", "a/foo", "a/b/foo", "a/b/c/foo"];
+        let cases: &[(Option<usize>, Option<usize>, &[&str])] = &[
+            (None, None, all),
+            (Some(0), None, all),
+            (Some(1), None, all),
+            (
+                Some(2),
+                None,
+                &["a/b", "a/b/c", "a/foo", "a/b/foo", "a/b/c/foo"],
+            ),
+            (Some(3), None, &["a/b/c", "a/b/foo", "a/b/c/foo"]),
+            (Some(4), None, &["a/b/c/foo"]),
+            (Some(5), None, &[]),
+            (Some(2), Some(3), &["a/b", "a/b/c", "a/foo", "a/b/foo"]),
+            (Some(2), Some(1), &["a/b", "a/foo"]),
+            (Some(3), Some(0), &["a/b/c", "a/b/foo"]),
+            (Some(usize::MAX), Some(0), &[]),
+        ];
+        for &(min, max, expected) in cases {
+            for threads in [1, 4] {
+                let mut builder = WalkBuilder::new(td.path());
+                builder.standard_filters(false).threads(threads);
+                assert_paths(
+                    td.path(),
+                    builder.min_depth(min).max_depth(max),
+                    expected,
+                );
+                let mut builder = WalkBuilder::new(td.path());
+                builder.standard_filters(false).threads(threads);
+                assert_paths(
+                    td.path(),
+                    builder.max_depth(max).min_depth(min),
+                    expected,
+                );
+            }
+        }
+    }
