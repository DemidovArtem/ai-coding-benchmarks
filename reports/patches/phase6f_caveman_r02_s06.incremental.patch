diff --git a/crates/searcher/tests/max_matches.rs b/crates/searcher/tests/max_matches.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3fb81c7f5ebd31b1ccdba6f0158706740c166748
--- /dev/null
+++ b/crates/searcher/tests/max_matches.rs
@@ -0,0 +1,325 @@
+use std::io;
+
+use grep_matcher::{LineTerminator, Match, Matcher, NoCaptures, NoError};
+use grep_regex::RegexMatcherBuilder;
+use grep_searcher::{
+    Encoding, Searcher, SearcherBuilder, Sink, SinkContext, SinkFinish,
+    SinkMatch,
+};
+
+#[derive(Default)]
+struct Output {
+    events: Vec<(bool, Vec<u8>)>,
+    begins: usize,
+    finishes: usize,
+    bytes_searched: u64,
+}
+
+struct TestMatcher {
+    regex: grep_regex::RegexMatcher,
+    fast: bool,
+}
+
+impl Matcher for TestMatcher {
+    type Captures = NoCaptures;
+    type Error = NoError;
+
+    fn find_at(
+        &self,
+        buf: &[u8],
+        at: usize,
+    ) -> Result<Option<Match>, NoError> {
+        self.regex.find_at(buf, at)
+    }
+
+    fn new_captures(&self) -> Result<NoCaptures, NoError> {
+        Ok(NoCaptures::new())
+    }
+
+    fn line_terminator(&self) -> Option<LineTerminator> {
+        if self.fast {
+            Some(LineTerminator::byte(b'\n'))
+        } else {
+            None
+        }
+    }
+}
+
+impl Sink for Output {
+    type Error = io::Error;
+
+    fn begin(&mut self, _: &Searcher) -> io::Result<bool> {
+        self.begins += 1;
+        Ok(true)
+    }
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        m: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        // Split blocks so adjacent multiline matches can still be compared.
+        for line in m.lines() {
+            self.events.push((true, line.to_vec()));
+        }
+        Ok(true)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        c: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.events.push((false, c.bytes().to_vec()));
+        Ok(true)
+    }
+
+    fn finish(&mut self, _: &Searcher, f: &SinkFinish) -> io::Result<()> {
+        self.finishes += 1;
+        self.bytes_searched = f.byte_count();
+        Ok(())
+    }
+}
+
+fn check(
+    builder: &SearcherBuilder,
+    pattern: &str,
+    haystack: &str,
+    expected: &[(bool, &str)],
+) {
+    let expected: Vec<_> = expected
+        .iter()
+        .map(|&(matched, line)| (matched, line.as_bytes().to_vec()))
+        .collect();
+    // Explicit terminators select fast line search. Otherwise, the wrapper
+    // hides the regex's optimizations to force the slow line search path.
+    for fast in [false, true] {
+        if fast && builder.build().multi_line() {
+            continue;
+        }
+        let regex = RegexMatcherBuilder::new()
+            .line_terminator(if fast { Some(b'\n') } else { None })
+            .build(pattern)
+            .unwrap();
+        let matcher = TestMatcher { regex, fast };
+        for reader in [false, true] {
+            let mut searcher = builder.build();
+            for _ in 0..2 {
+                let mut output = Output::default();
+                if reader {
+                    searcher
+                        .search_reader(
+                            &matcher,
+                            haystack.as_bytes(),
+                            &mut output,
+                        )
+                        .unwrap();
+                } else {
+                    searcher
+                        .search_slice(
+                            &matcher,
+                            haystack.as_bytes(),
+                            &mut output,
+                        )
+                        .unwrap();
+                }
+                assert_eq!(
+                    output.events, expected,
+                    "fast={fast} reader={reader}",
+                );
+                assert_eq!((output.begins, output.finishes), (1, 1));
+            }
+        }
+    }
+}
+
+#[test]
+fn configuration_and_line_limits() {
+    let mut builder = SearcherBuilder::new();
+    assert_eq!(builder.build().max_matches(), None);
+    assert_eq!(builder.max_matches(Some(1)).build().max_matches(), Some(1));
+    check(&builder, "Sherlock", "Sherlock Sherlock\nWatson\nSherlock\n", &[
+        (true, "Sherlock Sherlock\n"),
+    ]);
+    check(builder.max_matches(Some(2)), "x", "x\nx\nx\n", &[
+        (true, "x\n"), (true, "x\n"),
+    ]);
+    check(builder.max_matches(None), "x", "x\nx\nx\n", &[
+        (true, "x\n"), (true, "x\n"), (true, "x\n"),
+    ]);
+    check(builder.max_matches(Some(u64::MAX)), "x", "x\nx", &[
+        (true, "x\n"), (true, "x"),
+    ]);
+}
+
+#[test]
+fn context_matches_extend_the_window() {
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1)).before_context(1).after_context(1);
+    check(&builder, "x", "before\nx\nx\nz\nx\n", &[
+        (false, "before\n"), (true, "x\n"), (true, "x\n"), (false, "z\n"),
+    ]);
+    check(&builder, "x", "x\nx\nx\nz\nx\n", &[
+        (true, "x\n"), (true, "x\n"), (true, "x\n"), (false, "z\n"),
+    ]);
+    builder.heap_limit(Some(8)).before_context(0);
+    check(&builder, "x", "z\nz\nx\nz\nx\n", &[
+        (true, "x\n"), (false, "z\n"),
+    ]);
+    check(&builder, "x", "z\nx\nx\nx\nz\nx\n", &[
+        (true, "x\n"), (true, "x\n"), (true, "x\n"), (false, "z\n"),
+    ]);
+    builder.after_context(0).before_context(1);
+    check(&builder, "x", "z\nz\nz\nx\nz\nx\n", &[
+        (false, "z\n"), (true, "x\n"),
+    ]);
+}
+
+#[test]
+fn inverted_line_limits_and_context() {
+    let mut builder = SearcherBuilder::new();
+    builder.invert_match(true).max_matches(Some(1));
+    check(&builder, "x", "x\na\nb\nx\nc\n", &[(true, "a\n")]);
+    builder.max_matches(Some(2)).after_context(1);
+    check(&builder, "x", "a\nx\nb\nx\nc\n", &[
+        (true, "a\n"), (false, "x\n"), (true, "b\n"), (false, "x\n"),
+    ]);
+    builder.max_matches(Some(1));
+    check(&builder, "x", "a\nb\nx\nc\n", &[
+        (true, "a\n"), (true, "b\n"), (false, "x\n"),
+    ]);
+}
+
+#[test]
+fn multiline_spans_count_once() {
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).max_matches(Some(1));
+    check(&builder, "a\nb", "a\nb\na\nb\n", &[
+        (true, "a\n"), (true, "b\n"),
+    ]);
+    check(&builder, "a\nb", "a\nba\nb\n", &[
+        (true, "a\n"), (true, "ba\n"),
+    ]);
+    check(&builder, r"\z", "abc", &[(true, "abc")]);
+    builder.max_matches(Some(2));
+    check(&builder, "a\nb", "a\nb\na\nb\na\nb\n", &[
+        (true, "a\n"), (true, "b\n"), (true, "a\n"), (true, "b\n"),
+    ]);
+    check(&builder, "a\nb", "a\nb\nz\na\nb\nz\na\nb\n", &[
+        (true, "a\n"), (true, "b\n"), (true, "a\n"), (true, "b\n"),
+    ]);
+    builder.max_matches(Some(1)).after_context(1);
+    check(&builder, "a\nb", "a\nb\na\nb\nz\na\nb\n", &[
+        (true, "a\n"), (true, "b\n"), (true, "a\n"), (true, "b\n"),
+        (false, "z\n"),
+    ]);
+    check(&builder, r"q|\z", "q\nz", &[(true, "q\n"), (true, "z")]);
+}
+
+#[test]
+fn inverted_multiline_limits() {
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).invert_match(true).max_matches(Some(1));
+    check(&builder, "a\nb", "a\nb\nx\ny\na\nb\n", &[(true, "x\n")]);
+    builder.max_matches(Some(2)).after_context(1);
+    check(&builder, "a\nb", "x\na\nb\ny\na\nb\nz\n", &[
+        (true, "x\n"), (false, "a\n"), (true, "y\n"), (false, "a\n"),
+    ]);
+}
+
+#[test]
+fn passthru_preserves_all_lines() {
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1)).passthru(true);
+    check(&builder, "x", "z\nx\nx\nz\n", &[
+        (false, "z\n"), (true, "x\n"), (false, "x\n"), (false, "z\n"),
+    ]);
+    builder.multi_line(true);
+    check(&builder, "a\nb", "z\na\nb\na\nb\nz\n", &[
+        (false, "z\n"), (true, "a\n"), (true, "b\n"), (false, "a\n"),
+        (false, "b\n"), (false, "z\n"),
+    ]);
+    builder.invert_match(true);
+    check(&builder, "a\nb", "z\na\nb\nz\n", &[
+        (true, "z\n"), (false, "a\n"), (false, "b\n"), (false, "z\n"),
+    ]);
+}
+
+struct NoRead;
+
+impl io::Read for NoRead {
+    fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+        panic!("a zero match limit must not read input");
+    }
+}
+
+struct OneMatch {
+    calls: std::cell::Cell<usize>,
+    multiline: bool,
+    fast: bool,
+}
+
+impl Matcher for OneMatch {
+    type Captures = NoCaptures;
+    type Error = NoError;
+
+    fn find_at(&self, _: &[u8], at: usize) -> Result<Option<Match>, NoError> {
+        assert_eq!(self.calls.get(), 0, "searched after reaching the limit");
+        self.calls.set(1);
+        Ok(Some(Match::new(at, at + if self.multiline { 3 } else { 1 })))
+    }
+
+    fn new_captures(&self) -> Result<NoCaptures, NoError> {
+        Ok(NoCaptures::new())
+    }
+
+    fn line_terminator(&self) -> Option<LineTerminator> {
+        if self.fast {
+            Some(LineTerminator::byte(b'\n'))
+        } else {
+            None
+        }
+    }
+}
+
+#[test]
+fn no_matching_after_limit() {
+    for (multiline, fast) in [(false, false), (false, true), (true, false)] {
+        let matcher = OneMatch {
+            calls: std::cell::Cell::new(0), multiline, fast,
+        };
+        let mut searcher = SearcherBuilder::new()
+            .max_matches(Some(1))
+            .multi_line(multiline)
+            .build();
+        searcher
+            .search_slice(&matcher, b"x\ny\nx\ny\n", Output::default())
+            .unwrap();
+        assert_eq!(matcher.calls.get(), 1);
+        matcher.calls.set(0);
+        searcher
+            .search_reader(&matcher, &b"x\ny\nx\ny\n"[..], Output::default())
+            .unwrap();
+        assert_eq!(matcher.calls.get(), 1);
+    }
+}
+
+#[test]
+fn zero_limit_skips_reading_and_matching() {
+    for multiline in [false, true] {
+        let matcher = OneMatch {
+            calls: std::cell::Cell::new(0), multiline, fast: false,
+        };
+        let mut searcher = SearcherBuilder::new()
+            .max_matches(Some(0))
+            .multi_line(multiline)
+            .encoding(Some(Encoding::new("utf-16le").unwrap()))
+            .build();
+        let mut output = Output::default();
+        searcher.search_reader(&matcher, NoRead, &mut output).unwrap();
+        assert!(output.events.is_empty());
+        assert_eq!(output.bytes_searched, 0);
+        assert_eq!(matcher.calls.get(), 0);
+        assert_eq!((output.begins, output.finishes), (1, 1));
+    }
+}
