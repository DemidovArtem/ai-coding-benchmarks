+#[cfg(test)]
+mod tests {
+    use super::Core;
+    use crate::{
+        testutil::{KitchenSink, RegexMatcher},
+        SearcherBuilder,
+    };
+
+    #[test]
+    fn roll_keeps_only_before_context_and_separator_state() {
+        let buf = b"zero\none\ntwo\nthree\n";
+        for (before, after, consumed) in [
+            (0, 0, 19),
+            (0, 10_000, 18),
+            (1, 10_000, 9),
+            (2, 10_000, 5),
+        ] {
+            let searcher = SearcherBuilder::new()
+                .before_context(before)
+                .after_context(after)
+                .build();
+            let mut core = Core::new(
+                &searcher,
+                RegexMatcher::new("match"),
+                KitchenSink::new(),
+                false,
+            );
+            assert_eq!(core.roll(buf), consumed);
+            assert_eq!(core.pos(), buf.len() - consumed);
+            assert_eq!(core.absolute_byte_offset, consumed as u64);
+        }
+    }
