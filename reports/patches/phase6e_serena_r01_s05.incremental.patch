+    #[test]
+    fn context_across_buffer_rolls() {
+        use crate::{testutil::KitchenSink, SearcherBuilder};
+
+        let mut haystack = String::new();
+        for line in 0..120 {
+            if [0, 15, 18, 40, 100, 119].contains(&line) {
+                haystack.push_str("match\n");
+            } else {
+                haystack.push_str("other\n");
+            }
+        }
+        for before in [0, 1, 5] {
+            for after in [0, 1, 3, 20, 1000, 10_000] {
+                for numbered in [false, true] {
+                    for fast in [false, true] {
+                        let mut matcher =
+                            crate::testutil::RegexMatcher::new("match");
+                        if fast {
+                            matcher.set_line_term(Some(
+                                grep_matcher::LineTerminator::byte(b'\n'),
+                            ));
+                        }
+                        let mut builder = SearcherBuilder::new();
+                        builder
+                            .before_context(before)
+                            .after_context(after)
+                            .line_number(numbered);
+                        let mut expected = KitchenSink::new();
+                        builder
+                            .build()
+                            .search_slice(
+                                &matcher,
+                                haystack.as_bytes(),
+                                &mut expected,
+                            )
+                            .unwrap();
+                        let mut got = KitchenSink::new();
+                        // Force many rolls, including gaps and overlapping
+                        // context groups, even for large after-context.
+                        builder.heap_limit(Some(64));
+                        builder
+                            .build()
+                            .search_reader(
+                                &matcher,
+                                haystack.as_bytes(),
+                                &mut got,
+                            )
+                            .unwrap();
+                        assert_eq!(
+                            got.as_bytes(), expected.as_bytes(),
+                            "before={before}, after={after}, \
+                             numbered={numbered}, fast={fast}"
+                        );
+                    }
+                }
+            }
+        }
+    }
