+    struct ShortReader<'a> {
+        bytes: &'a [u8],
+        chunk_size: usize,
+        reads: usize,
+    }
+
+    impl io::Read for ShortReader<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            self.reads += 1;
+            let len = buf.len().min(self.chunk_size);
+            self.bytes.read(&mut buf[..len])
+        }
+    }
+
+    #[test]
+    fn buffer_fills_capacity_with_short_reads() {
+        let mut reader =
+            ShortReader { bytes: b"a\nb\nc\nd\ne\n", chunk_size: 2, reads: 0 };
+        let mut buffer = LineBufferBuilder::new().capacity(8).build();
+        assert!(buffer.fill(&mut reader).unwrap());
+        assert_eq!(buffer.buffer(), b"a\nb\nc\nd\n");
+        assert!(buffer.free_buffer().is_empty());
+        assert_eq!(reader.reads, 4);
+        buffer.consume_all();
+        assert!(buffer.fill(&mut reader).unwrap());
+        assert_eq!(buffer.buffer(), b"e\n");
+        assert_eq!(reader.reads, 6); // the last read reaches EOF
+        buffer.consume_all();
+        assert!(!buffer.fill(&mut reader).unwrap());
+    }
+
+    #[test]
+    fn buffer_short_reads_quit_before_reading_another_chunk() {
+        let mut reader =
+            ShortReader { bytes: b"a\nb\0c\nd\n", chunk_size: 2, reads: 0 };
+        let mut buffer = LineBufferBuilder::new()
+            .capacity(8)
+            .binary_detection(BinaryDetection::Quit(0))
+            .build();
+        assert!(buffer.fill(&mut reader).unwrap());
+        assert_eq!(reader.reads, 2);
+        assert_eq!(reader.bytes, b"c\nd\n");
+        assert_eq!(buffer.buffer(), b"a\nb");
+        assert_eq!(buffer.binary_byte_offset(), Some(3));
+        buffer.consume_all();
+        assert!(!buffer.fill(&mut reader).unwrap());
+        assert_eq!(reader.reads, 2);
+    }
+
+    #[test]
+    fn buffer_short_reads_convert_each_chunk() {
+        let mut reader =
+            ShortReader { bytes: b"a\0b\0c\n", chunk_size: 2, reads: 0 };
+        let mut buffer = LineBufferBuilder::new()
+            .capacity(6)
+            .binary_detection(BinaryDetection::Convert(0))
+            .build();
+        assert!(buffer.fill(&mut reader).unwrap());
+        assert_eq!(reader.reads, 3);
+        assert_eq!(buffer.buffer(), b"a\nb\nc\n");
+        assert_eq!(buffer.binary_byte_offset(), Some(1));
+    }
