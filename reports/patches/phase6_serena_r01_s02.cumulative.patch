--- /dev/null
+++ b/crates/ignore/tests/unclosed_classes.rs
@@ -0,0 +1,41 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    let mut builder = GitignoreBuilder::new(".");
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        builder.add_line(None, pattern).unwrap();
+    }
+    let ignore = builder.build().unwrap();
+    for path in ["[", "[abc", "dir/[abc", "[]", "[][", "[!", "[!]"] {
+        assert!(ignore.matched(path, false).is_ignore(), "{path}");
+    }
+    assert!(ignore.matched("abc", false).is_none());
+}
+
+#[test]
+fn gitignore_option_affects_only_subsequent_patterns() {
+    let mut builder = GitignoreBuilder::new(".");
+    builder.allow_unclosed_class(false);
+    assert!(builder.add_line(None, "[abc").is_err());
+    builder.allow_unclosed_class(true).add_line(None, "[abc").unwrap();
+    builder.allow_unclosed_class(false).add_line(None, "[xyz]").unwrap();
+    assert!(builder.add_line(None, "[def").is_err());
+    let ignore = builder.build().unwrap();
+    assert!(ignore.matched("[abc", false).is_ignore());
+    assert!(ignore.matched("x", false).is_ignore());
+    assert!(ignore.matched("[def", false).is_none());
+}
+
+#[test]
+fn overrides_are_strict_and_can_opt_in() {
+    let mut builder = OverrideBuilder::new(".");
+    assert!(builder.add("[abc").is_err());
+    builder.allow_unclosed_class(true).add("[abc").unwrap();
+    builder.allow_unclosed_class(false).add("[xyz]").unwrap();
+    assert!(builder.add("[def").is_err());
+    let overrides = builder.build().unwrap();
+    assert!(overrides.matched("[abc", false).is_whitelist());
+    assert!(overrides.matched("x", false).is_whitelist());
+    assert!(!overrides.matched("[def", false).is_whitelist());
+}
