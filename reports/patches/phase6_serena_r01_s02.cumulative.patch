@@ -0,0 +1,128 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn regex_preserves_alternation_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("x{{a,b},c}{d,{e,f}}y", "x(?:(?:a|b)|c)(?:d|(?:e|f))y"),
+        ("a,{b,{c,d}},e", "a,(?:b|(?:c|d)),e"),
+        ("{{a,b}}", "(?:(?:a|b))"),
+    ] {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{regex}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn malformed_alternations_report_the_unmatched_brace() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b}", "{a,{b,c"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedAlternates,
+            "{pattern}"
+        );
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{{a,b},c}}", "a}b{c"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnopenedAlternates,
+            "{pattern}"
+        );
+    }
+}
+
+fn check_matches(pattern: &str, yes: &[&str], no: &[&str]) {
+    let glob = Glob::new(pattern).unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for (paths, expected) in [(yes, true), (no, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+            assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn nested_branches_match_in_single_globs_and_sets() {
+    check_matches("{a,{b,c}}", &["a", "b", "c"], &["", "d", "ab"]);
+    check_matches("{{a,b},{c,d}}", &["a", "b", "c", "d"], &["", "ac"]);
+    check_matches("{a,b{c,d}}", &["a", "bc", "bd"], &["b", "be", "abc"]);
+    check_matches(
+        "x{{a,b},c}{d,{e,f}}y",
+        &["xady", "xbey", "xcfy"],
+        &["xay", "xdcy", "xagy"],
+    );
+    check_matches("{a,{b,c}},d", &["a,d", "b,d", "c,d"], &["a", "d"]);
+    check_matches("a,b", &["a,b"], &["a", "b"]);
+}
+
+#[test]
+fn nested_alternates_combine_with_other_glob_features() {
+    check_matches(
+        "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+        &[
+            "node_modules/pkg/ts",
+            "app/node_modules/pkg/lib/js",
+            "crates/main.rs",
+            "app/crates/core/Cargo.toml",
+        ],
+        &["crates/main.js", "node_modules/pkg/rs", "src/main.rs"],
+    );
+    check_matches(
+        "{src/{[ab]*.rs,?.{c,h}},README}",
+        &["src/abc.rs", "src/b.rs", "src/x.c", "src/y.h", "README"],
+        &["src/c.rs", "src/xx.c", "README.md"],
+    );
+    let glob = GlobBuilder::new("{src/{*.rs,*.{c,h}},README}")
+        .literal_separator(true)
+        .case_insensitive(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(glob.is_match("src/MAIN.RS"));
+    assert!(glob.is_match("src/main.h"));
+    assert!(!glob.is_match("src/sub/main.rs"));
+}
+
+#[test]
+fn empty_nested_alternates_respect_the_builder_option() {
+    for empty in [false, true] {
+        let glob = GlobBuilder::new("{a,{b,}}")
+            .empty_alternates(empty)
+            .build()
+            .unwrap();
+        assert_eq!(
+            glob.regex(),
+            if empty { "(?-u)^(?:a|(?:b|))$" } else { "(?-u)^(?:a|(?:b))$" }
+        );
+        let matcher = glob.compile_matcher();
+        assert!(matcher.is_match("a"));
+        assert!(matcher.is_match("b"));
+        assert_eq!(matcher.is_match(""), empty);
+    }
+}
+
+#[test]
+fn braces_in_classes_and_escapes_do_not_open_groups() {
+    check_matches("{[{}],{a,b}}", &["{", "}", "a", "b"], &["ab"]);
+    let matcher = GlobBuilder::new(r"{\{,{a\,b,c\}}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    for path in ["{", "a,b", "c}"] {
+        assert!(matcher.is_match(path));
+    }
+}
+
+#[test]
+fn many_levels_of_nesting_are_supported() {
+    let depth = 32;
+    let pattern = format!("{}a{}", "{b,".repeat(depth), "}".repeat(depth));
+    check_matches(&pattern, &["a", "b"], &["", "ab", "c"]);
+}
