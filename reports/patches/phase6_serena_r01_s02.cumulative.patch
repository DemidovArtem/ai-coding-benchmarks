+++ b/crates/globset/tests/unclosed_classes.rs
@@ -0,0 +1,126 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}"
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}"
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_text_matches_literally() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[a*?",
+        "[☃", "[a,b", "[{x,y}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match(&format!("{pattern}x")), "{pattern}");
+        assert!(!set.is_match(&format!("{pattern}x")), "{pattern}");
+    }
+    let matcher = GlobBuilder::new("[a*?")
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(!matcher.is_match("[abc"));
+}
+
+#[test]
+fn unclosed_classes_respect_alternation_branches() {
+    for (pattern, yes, no) in [
+        ("{[abc,xyz}", vec!["[abc", "xyz"], vec!["a", "[abc,xyz}"]),
+        ("{[abc,[xyz}", vec!["[abc", "[xyz"], vec!["a", "x"]),
+        ("{[abc],[xyz}", vec!["a", "b", "c", "[xyz"], vec!["[abc]", "x"]),
+        ("{{a,b},[xyz}", vec!["a", "b", "[xyz"], vec!["x", "ab"]),
+        ("{[abc,{[xyz,q}}", vec!["[abc", "[xyz", "q"], vec!["a", "x"]),
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        for path in yes {
+            assert!(matcher.is_match(path), "{pattern}: {path}");
+            assert!(set.is_match(path), "{pattern}: {path}");
+        }
+        for path in no {
+            assert!(!matcher.is_match(path), "{pattern}: {path}");
+            assert!(!set.is_match(path), "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn closed_classes_and_errors_keep_their_meaning() {
+    for pattern in ["[abc]", "[]]", "[!]]", "[a-z]", "{[}],foo}"] {
+        let strict = Glob::new(pattern).unwrap();
+        let permissive = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        assert_eq!(strict.regex(), permissive.regex(), "{pattern}");
+    }
+    for (pattern, error) in [
+        ("[z-a]", ErrorKind::InvalidRange('z', 'a')),
+        ("{[abc", ErrorKind::UnclosedAlternates),
+        ("{a,[xyz}}", ErrorKind::UnopenedAlternates),
+    ] {
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &error,
+            "{pattern}"
+        );
+    }
+}
+
+#[test]
+fn option_chains_and_can_be_disabled_again() {
+    let mut builder = GlobBuilder::new("*/[ABC");
+    builder.allow_unclosed_class(true).case_insensitive(true);
+    builder.literal_separator(true).backslash_escape(true);
+    let matcher = builder.build().unwrap().compile_matcher();
+    assert!(matcher.is_match("src/[abc"));
+    assert!(!matcher.is_match("src/sub/[abc"));
+    builder.allow_unclosed_class(false);
+    assert_eq!(builder.build().unwrap_err().kind(), &ErrorKind::UnclosedClass);
+}
+
+#[test]
+fn many_open_brackets_and_unclosed_branches_parse_successfully() {
+    let pattern = "[".repeat(20_000);
+    assert!(GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .is_ok());
+    let branches = vec!["["; 10_000].join(",");
+    let pattern = format!("{{{branches}}}");
+    assert!(GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .is_ok());
+}
