+    /// Check for closure before validating ranges or consuming any input.
+    /// Cache failure so unclosed classes in later branches don't rescan the
+    /// same suffix. Successful scans cover only the class consumed next.
+    fn class_is_closed(&mut self) -> bool {
+        if self.no_more_classes {
+            return false;
+        }
+        let mut chars = self.chars.clone();
+        if chars.peek() == Some(&'!') || chars.peek() == Some(&'^') {
+            chars.next();
+        }
+        // A closing bracket in the first position is a class member.
+        chars.next();
+        if chars.any(|c| c == ']') {
+            return true;
+        }
+        self.no_more_classes = true;
+        false
+    }
