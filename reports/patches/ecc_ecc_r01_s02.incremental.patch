diff --git a/crates/globset/tests/unclosed_class.rs b/crates/globset/tests/unclosed_class.rs
new file mode 100644
index 0000000000000000000000000000000000000000..03b665941d70b180ad1f54328d4cb79b2f349efb
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,142 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+        let err = GlobBuilder::new(pattern)
+            .allow_unclosed_class(false)
+            .build()
+            .unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a*?", "[☃",
+        "[a,b", r"[a\*?{b}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match(&pattern[1..]), "{pattern}");
+        assert!(!set.is_match(&pattern[1..]), "{pattern}");
+    }
+    let matcher = GlobBuilder::new("[abc*?")
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("[abc*?"));
+    assert!(!matcher.is_match("[abcxyz"));
+}
+
+#[test]
+fn closed_classes_keep_existing_semantics() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("[abc]", &["a", "b", "c"], &["[abc]", "d"]),
+        ("[]]", &["]"], &["[]", "a"]),
+        ("[!]]", &["a"], &["]", "[!]"]),
+        ("[a-z]", &["a", "m", "z"], &["A", "-"]),
+        ("[-a]", &["-", "a"], &["b"]),
+        ("[a-]", &["-", "a"], &["b"]),
+        ("{[a,b],x}", &["a", "b", ",", "x"], &["[a", "b]"]),
+        ("{[{}],x}", &["{", "}", "x"], &["[{}]"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        for allow in [false, true] {
+            let matcher = GlobBuilder::new(pattern)
+                .allow_unclosed_class(allow)
+                .build()
+                .unwrap()
+                .compile_matcher();
+            for path in matches {
+                assert!(matcher.is_match(path), "{pattern}: {path}");
+            }
+            for path in nonmatches {
+                assert!(!matcher.is_match(path), "{pattern}: {path}");
+            }
+        }
+    }
+    let err = GlobBuilder::new("[z-a]")
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap_err();
+    assert_eq!(err.kind(), &ErrorKind::InvalidRange('z', 'a'));
+}
+
+#[test]
+fn unclosed_classes_in_alternate_branches() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{[abc,xyz}", &["[abc", "xyz"], &["abc", "[abc,xyz"]),
+        ("{[abc,[xyz}", &["[abc", "[xyz"], &["abc", "xyz"]),
+        ("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "x"]),
+        (
+            "{a,{[abc,xyz},z}",
+            &["a", "[abc", "xyz", "z"],
+            &["abc", "[abc,xyz", "x"],
+        ),
+        ("{[a*?,b?}", &["[a*?", "bx"], &["[axy", "b"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        for path in matches {
+            assert!(matcher.is_match(path), "{pattern}: {path}");
+            assert!(set.is_match(path), "{pattern}: {path}");
+        }
+        for path in nonmatches {
+            assert!(!matcher.is_match(path), "{pattern}: {path}");
+            assert!(!set.is_match(path), "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    let matcher = GlobBuilder::new("src/*[ABC?")
+        .allow_unclosed_class(true)
+        .literal_separator(true)
+        .case_insensitive(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("SRC/name[abc?"));
+    assert!(!matcher.is_match("src/name[abcx"));
+    assert!(!matcher.is_match("src/nested/name[abc?"));
+
+    let mut builder = GlobBuilder::new("[abc");
+    assert!(builder.allow_unclosed_class(true).build().is_ok());
+    assert!(builder.allow_unclosed_class(false).build().is_err());
+}
+
+#[test]
+fn many_unclosed_classes() {
+    let pattern = "[".repeat(10_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.regex(), format!("(?-u)^{}$", r"\[".repeat(10_000)));
+
+    // A failed closure search must not rescan the suffix for every branch.
+    let pattern = format!("{{{}[}}", "[,".repeat(10_000));
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.regex().matches(r"\[").count(), 10_001);
+}
