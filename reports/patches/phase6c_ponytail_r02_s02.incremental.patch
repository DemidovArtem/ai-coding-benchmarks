index 0000000000000000000000000000000000000000..9a0b47be85790d47bfd41c4b2eac873def53475c
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,115 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+        );
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match(&pattern[1..]), "{pattern}");
+    }
+}
+
+#[test]
+fn literal_fallback_in_alternates() {
+    for (pattern, yes, no) in [
+        ("{[abc,xyz}", "[abc", "a"),
+        ("{[abc,xyz}", "xyz", "abc"),
+        ("{[abc,[xyz}", "[abc", "a"),
+        ("{[abc,[xyz}", "[xyz", "x"),
+        ("{[abc],[xyz}", "a", "[abc]"),
+        ("{[abc],[xyz}", "[xyz", "x"),
+        ("{[abc,{xyz,[def}}", "[def", "d"),
+        ("{[abc,*.rs}", "file.rs", "file.txt"),
+        ("{[abc,[xyz}/*.rs", "[xyz/lib.rs", "[xyz/lib.txt"),
+        ("[abc*?", "[abc*?", "[abcd"),
+        ("[z-a", "[z-a", "z"),
+        ("[é☃", "[é☃", "é"),
+        ("[a,b", "[a,b", "[a"),
+        ("[]a]", "]", "b"),
+        ("[!a]", "b", "a"),
+        ("[a-c]", "b", "d"),
+        ("{[}],foo}", "}", "a"),
+        ("{[,],foo}", ",", "a"),
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .literal_separator(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        for (path, expected) in [(yes, true), (no, false)] {
+            assert_eq!(
+                matcher.is_match(path),
+                expected,
+                "{pattern}: {path}",
+            );
+            assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn other_validation_and_options_are_preserved() {
+    assert_eq!(
+        GlobBuilder::new("[z-a]")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::InvalidRange('z', 'a'),
+    );
+    assert_eq!(
+        GlobBuilder::new("{[abc")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+    let matcher = GlobBuilder::new("src/[ABC")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("src/[abc"));
+    assert!(!matcher.is_match("src/x/[abc"));
+}
+
+#[test]
+fn many_unclosed_brackets() {
+    let pattern = "[".repeat(100_000);
+    assert!(GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher()
+        .is_match(&pattern));
+    let pattern = format!("{{{}}}", vec!["["; 10_000].join(","));
+    assert!(GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher()
+        .is_match("["));
+}
