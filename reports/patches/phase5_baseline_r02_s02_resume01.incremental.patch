index 0000000000000000000000000000000000000000..32e9f096d8383af206690af5d910305924fd9059
--- /dev/null
+++ b/crates/ignore/tests/unclosed_class.rs
@@ -0,0 +1,53 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    let mut builder = GitignoreBuilder::new("");
+    for pattern in ["[abc", "[]", "[][", "[!", "[!]"] {
+        builder.add_line(None, pattern).unwrap();
+    }
+    let gitignore = builder.build().unwrap();
+    for path in ["[abc", "sub/[abc", "[]", "[][", "[!", "[!]"] {
+        assert!(gitignore.matched(path, false).is_ignore(), "{path}");
+    }
+    assert!(gitignore.matched("abc", false).is_none());
+}
+
+#[test]
+fn gitignore_can_switch_to_strict_parsing() {
+    let mut builder = GitignoreBuilder::new("");
+    builder.add_line(None, "[abc").unwrap();
+    assert!(builder
+        .allow_unclosed_class(false)
+        .add_line(None, "[xyz")
+        .is_err());
+    let gitignore = builder.build().unwrap();
+    assert!(gitignore.matched("[abc", false).is_ignore());
+    assert!(gitignore.matched("[xyz", false).is_none());
+
+    let gitignore = builder
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .unwrap()
+        .add_line(None, "[xyz")
+        .unwrap()
+        .build()
+        .unwrap();
+    assert!(gitignore.matched("[XYZ", false).is_ignore());
+}
+
+#[test]
+fn overrides_are_strict_by_default() {
+    let mut builder = OverrideBuilder::new("");
+    assert!(builder.add("[abc").is_err());
+    let overrides = builder
+        .allow_unclosed_class(true)
+        .add("[abc")
+        .unwrap()
+        .build()
+        .unwrap();
+    assert!(overrides.matched("[abc", false).is_whitelist());
+    assert!(overrides.matched("abc", false).is_ignore());
+    assert!(builder.allow_unclosed_class(false).add("[xyz").is_err());
+    assert!(builder.build().unwrap().matched("[abc", false).is_whitelist());
+}
