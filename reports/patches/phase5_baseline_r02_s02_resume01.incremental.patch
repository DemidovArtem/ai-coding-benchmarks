index 0000000000000000000000000000000000000000..93cb18d3530e2f0b0287cff19f05091dac419759
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,111 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+        );
+    }
+}
+
+fn assert_matches(pattern: &str, matching: &[&str], nonmatching: &[&str]) {
+    let glob = GlobBuilder::new(pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &(paths, expected) in &[(matching, true), (nonmatching, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+            assert_eq!(set.is_match(path), expected, "set {pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[☃", "[*?",
+        r"[abc\*",
+    ] {
+        assert_matches(pattern, &[pattern], &["", "abc", "a"]);
+    }
+    assert_matches("prefix[abc", &["prefix[abc"], &["prefixa", "prefixabc"]);
+    assert_matches("[*?", &["[*?"], &["[anything", "[xy"]);
+}
+
+#[test]
+fn unclosed_classes_preserve_alternation_branches() {
+    assert_matches("{[abc,xyz}", &["[abc", "xyz"], &["a", "[abc,xyz}"]);
+    assert_matches("{[abc,[xyz}", &["[abc", "[xyz"], &["abc", "x"]);
+    assert_matches("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "x"]);
+    assert_matches(
+        "{foo,{[abc,[xyz}}tail",
+        &["footail", "[abctail", "[xyztail"],
+        &["[abc", "atail", "foo"],
+    );
+    assert_matches("{[][,x}", &["[][", "x"], &["[", "]"]);
+}
+
+#[test]
+fn closed_classes_keep_their_syntax() {
+    for pattern in ["[abc]", "[!abc]", "[]]", "[!]]", "[a-z]", "[,]", "[}]"] {
+        let permissive = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        assert_eq!(permissive.regex(), Glob::new(pattern).unwrap().regex());
+    }
+    assert_matches("{[}],foo}", &["}", "foo"], &["[}]", "bar"]);
+    assert_eq!(
+        GlobBuilder::new("[z-a]")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::InvalidRange('z', 'a'),
+    );
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    let mut builder = GlobBuilder::new("src/*/[ABC");
+    let glob = builder
+        .allow_unclosed_class(true)
+        .literal_separator(true)
+        .case_insensitive(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    assert!(matcher.is_match("src/lib/[abc"));
+    assert!(!matcher.is_match("src/lib/sub/[abc"));
+    assert!(builder.allow_unclosed_class(false).build().is_err());
+}
+
+#[test]
+fn many_unclosed_brackets_and_branches() {
+    let pattern = "[".repeat(100_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.glob(), pattern);
+
+    // An unsuccessful search for `]` must not rescan this entire suffix for
+    // every branch.
+    let pattern = format!("{{{}[end}}", "[abc,".repeat(10_000));
+    assert_matches(&pattern, &["[abc", "[end"], &["abc", "end"]);
+}
