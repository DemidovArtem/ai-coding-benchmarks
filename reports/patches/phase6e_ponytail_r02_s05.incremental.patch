+    #[test]
+    fn large_after_context_with_bounded_buffer() {
+        let haystack = format!(
+            "{}match\n{}match\n{}tail",
+            "x\n".repeat(32),
+            "x\n".repeat(20_032),
+            "x\n".repeat(16),
+        );
+        for before in [0, 5] {
+            for after in [0, 1, 1_000, 10_000] {
+                for line_term in
+                    [None, Some(grep_matcher::LineTerminator::byte(b'\n'))]
+                {
+                    let mut matcher = RegexMatcher::new("match");
+                    matcher.set_line_term(line_term);
+                    let mut builder = SearcherBuilder::new();
+                    builder.before_context(before).after_context(after);
+                    let mut expected = KitchenSink::new();
+                    builder
+                        .build()
+                        .search_slice(
+                            &matcher,
+                            haystack.as_bytes(),
+                            &mut expected,
+                        )
+                        .unwrap();
+                    let mut got = KitchenSink::new();
+                    builder
+                        .heap_limit(Some(64))
+                        .build()
+                        .search_reader(
+                            &matcher,
+                            haystack.as_bytes(),
+                            &mut got,
+                        )
+                        .unwrap();
+                    assert_eq!(got.as_bytes(), expected.as_bytes());
+                    let separators = got
+                        .as_bytes()
+                        .windows(3)
+                        .filter(|bytes| *bytes == b"--\n")
+                        .count();
+                    assert_eq!(
+                        separators,
+                        usize::from(before > 0 || after > 0),
+                    );
+                }
+            }
+        }
+    }
