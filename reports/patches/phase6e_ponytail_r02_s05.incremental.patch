+    struct ShortRead<'a>(&'a [u8]);
+
+    impl io::Read for ShortRead<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            let len = buf.len().min(2);
+            self.0.read(&mut buf[..len])
+        }
+    }
+
+    #[test]
+    fn buffer_partial_reads_fill_capacity() {
+        let mut input = ShortRead(b"a\nb\nc\nd\nend");
+        let mut buffer = LineBufferBuilder::new().capacity(6).build();
+        assert!(buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.buffer(), b"a\nb\nc\n");
+        assert_eq!(input.0, b"d\nend");
+        buffer.consume_all();
+        assert!(buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.buffer(), b"d\n");
+        assert!(input.0.is_empty());
+        buffer.consume_all();
+        assert!(buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.buffer(), b"end");
+        buffer.consume_all();
+        assert!(!buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.absolute_byte_offset(), 11);
+        assert_eq!(buffer.buf.len(), 6);
+    }
+
+    #[test]
+    fn buffer_partial_reads_binary_quit() {
+        let mut input = ShortRead(b"a\nb\x00c\nd\n");
+        let mut buffer = LineBufferBuilder::new()
+            .capacity(8)
+            .binary_detection(BinaryDetection::Quit(0))
+            .build();
+        assert!(buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.buffer(), b"a\nb");
+        assert_eq!(buffer.binary_byte_offset(), Some(3));
+        assert_eq!(input.0, b"c\nd\n");
+        buffer.consume_all();
+        assert!(!buffer.fill(&mut input).unwrap());
+        assert_eq!(input.0, b"c\nd\n");
+    }
+
+    #[test]
+    fn buffer_partial_reads_binary_convert() {
+        let mut input = ShortRead(b"a\nb\x00c\x00d\n");
+        let mut buffer = LineBufferBuilder::new()
+            .capacity(8)
+            .binary_detection(BinaryDetection::Convert(0))
+            .build();
+        assert!(buffer.fill(&mut input).unwrap());
+        assert_eq!(buffer.buffer(), b"a\nb\nc\nd\n");
+        assert_eq!(buffer.binary_byte_offset(), Some(3));
+        assert!(input.0.is_empty());
+    }
