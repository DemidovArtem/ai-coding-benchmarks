+
+rgtest!(global_ignore_absolute_paths, |dir: Dir, _cmd: TestCommand| {
+    dir.create_dir(".git");
+    dir.create_dir("a/b/c/nested");
+    dir.create_dir(".config/git");
+    let ignore = dir.path().join(".global-ignore");
+    dir.create(&ignore, "/haystack\n");
+    dir.create(
+        ".config/git/config",
+        &format!("[core]\nexcludesFile = {}\n", ignore.display()),
+    );
+    for subdir in ["", "a/b/c"] {
+        let cwd = dir.path().join(subdir);
+        dir.create(cwd.join("haystack"), "ignored");
+        dir.create(cwd.join("visible"), "kept");
+        dir.create_dir(cwd.join("nested"));
+        dir.create(cwd.join("nested/haystack"), "kept");
+    }
+    for custom in [false, true] {
+        for subdir in ["", "a/b/c"] {
+            let cwd = dir.path().join(subdir);
+            for search in [std::path::PathBuf::from("."), cwd.clone()] {
+                for threads in ["1", "4"] {
+                    let mut cmd = dir.command();
+                    cmd.current_dir(&cwd)
+                        .args(&["--files", "--threads", threads])
+                        .arg(&search);
+                    cmd.cmd().env("HOME", dir.path());
+                    cmd.cmd()
+                        .env("XDG_CONFIG_HOME", dir.path().join(".config"));
+                    if custom {
+                        cmd.arg("--no-ignore-global")
+                            .arg("--ignore-file")
+                            .arg(&ignore);
+                    }
+                    let output = cmd.stdout();
+                    assert!(output.lines().any(|p| p.ends_with("visible")));
+                    assert!(output.lines().any(|p| {
+                        p.ends_with("nested/haystack")
+                    }));
+                    let root_haystack = search.join("haystack");
+                    let root_haystack =
+                        root_haystack.to_str().unwrap().replace('\\', "/");
+                    assert!(output.lines().all(|p| p != root_haystack));
+                }
+            }
+        }
+    }
+});
