index 0000000000000000000000000000000000000000..26edc6e9e89f7f3e9852c7858da805661339c782
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,121 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn alternation_regex_preserves_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("{a,{b,c}}{d,e}", "(?:a|(?:b|c))(?:d|e)"),
+        ("x,{a,{b,c}},y", "x,(?:a|(?:b|c)),y"),
+    ] {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{regex}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn unmatched_alternation_braces() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b},{c,d}", "{a,{b,c"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnclosedAlternates, "{pattern}");
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnopenedAlternates, "{pattern}");
+    }
+}
+
+#[test]
+fn nested_alternation_matches() {
+    for (pattern, path, expected) in [
+        ("{a,{b,c}}", "a", true),
+        ("{a,{b,c}}", "b", true),
+        ("{a,{b,c}}", "c", true),
+        ("{a,{b,c}}", "d", false),
+        ("{{a,b},{c,d}}", "a", true),
+        ("{{a,b},{c,d}}", "b", true),
+        ("{{a,b},{c,d}}", "c", true),
+        ("{{a,b},{c,d}}", "d", true),
+        ("{{a,b},{c,d}}", "ac", false),
+        ("{a,b{c,d}}", "a", true),
+        ("{a,b{c,d}}", "bc", true),
+        ("{a,b{c,d}}", "bd", true),
+        ("{a,b{c,d}}", "b", false),
+        ("{a,b{c,d}}", "be", false),
+        ("{a,{b,c}}{d,{e,f}}", "be", true),
+        ("{a,{b,c}}{d,{e,f}}", "cf", true),
+        ("{a,{b,c}}{d,{e,f}}", "ab", false),
+        ("src/{lib[0-9],{main,mod}?}.rs", "src/lib2.rs", true),
+        ("src/{lib[0-9],{main,mod}?}.rs", "src/main1.rs", true),
+        ("src/{lib[0-9],{main,mod}?}.rs", "src/mod.rs", false),
+        ("a,b", "a,b", true),
+        ("x,{a,{b,c}},y", "x,b,y", true),
+        ("x,{a,{b,c}},y", "x,b", false),
+        ("{a,{[{}],b}}", "{", true),
+        ("{a,{[{}],b}}", "}", true),
+    ] {
+        let glob = Glob::new(pattern).unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+        assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+    }
+}
+
+#[test]
+fn nested_alternation_paths() {
+    let glob = GlobBuilder::new(
+        "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+    )
+    .literal_separator(true)
+    .build()
+    .unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for (path, expected) in [
+        ("node_modules/pkg/ts", true),
+        ("project/node_modules/pkg/lib/js", true),
+        ("crates/main.rs", true),
+        ("project/crates/globset/Cargo.toml", true),
+        ("crates/README.md", false),
+        ("node_modules/pkg/rs", false),
+        ("other/main.rs", false),
+    ] {
+        assert_eq!(matcher.is_match(path), expected, "{path}");
+        assert_eq!(set.is_match(path), expected, "{path}");
+    }
+}
+
+#[test]
+fn nested_empty_alternates_and_escapes() {
+    for empty_alternates in [false, true] {
+        let matcher = GlobBuilder::new("foo{,{,.txt}}")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap()
+            .compile_matcher();
+        assert_eq!(matcher.is_match("foo"), empty_alternates);
+        assert!(matcher.is_match("foo.txt"));
+        assert!(!matcher.is_match("foo.md"));
+    }
+    let matcher = GlobBuilder::new(r"{a,{b\,c,\{d\}}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("b,c"));
+    assert!(matcher.is_match("{d}"));
+    assert!(!matcher.is_match("b"));
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    let pattern = format!("{}z{}", "{a,".repeat(64), "}".repeat(64));
+    let matcher = Glob::new(&pattern).unwrap().compile_matcher();
+    assert!(matcher.is_match("a"));
+    assert!(matcher.is_match("z"));
+    assert!(!matcher.is_match("b"));
+}
