+
+fn assert_global_ignore_anchoring(dir: &Dir, git_global: bool) {
+    dir.create_dir(".git");
+    dir.create_dir("a/b/c/child");
+    dir.create_dir("home");
+    dir.create(".rules", "/haystack\n");
+    dir.create("a/b/c/haystack", "");
+    dir.create("a/b/c/keep", "");
+    dir.create("a/b/c/child/haystack", "");
+    let rules = dir.path().join(".rules");
+    let rules_config = rules.to_string_lossy().replace('\\', "/");
+    dir.create(
+        "home/.gitconfig",
+        &format!("[core]\nexcludesFile = {}\n", rules_config),
+    );
+    let cwd = dir.path().join("a/b/c");
+    for threads in ["1", "4"] {
+        for root in [std::path::PathBuf::from("."), cwd.clone()] {
+            let mut cmd = dir.command();
+            cmd.current_dir(&cwd).args(&["--files", "-j", threads]);
+            if git_global {
+                cmd.cmd()
+                    .env("HOME", dir.path().join("home"))
+                    .env("XDG_CONFIG_HOME", dir.path().join("xdg"));
+            } else {
+                cmd.args(&[
+                    "--no-ignore-global",
+                    "--ignore-file",
+                    "../../../.rules",
+                ]);
+            }
+            let got = cmd.arg(&root).stdout().replace('\\', "/");
+            let expected = format!(
+                "{}\n{}\n",
+                root.join("child/haystack").display(),
+                root.join("keep").display(),
+            )
+            .replace('\\', "/");
+            eqnice!(sort_lines(&expected), sort_lines(&got));
+        }
+    }
+}
+
+rgtest!(global_gitignore_anchored_absolute_paths, |dir: Dir, _: TestCommand| {
+    assert_global_ignore_anchoring(&dir, true);
+});
+
+rgtest!(custom_ignore_anchored_absolute_paths, |dir: Dir, _: TestCommand| {
+    assert_global_ignore_anchoring(&dir, false);
+});
