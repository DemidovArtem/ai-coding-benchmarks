+            let sink = search(&builder, &matcher, haystack, reader);
+            assert_eq!(sink.events, vec![matched(1, first)], "{pattern}");
+            // Sinks receive whole lines, so the same-line case must be
+            // checked through matcher calls rather than counting substrings.
+            assert_eq!(matcher.calls.get(), 1, "{pattern}");
+        }
+    }
