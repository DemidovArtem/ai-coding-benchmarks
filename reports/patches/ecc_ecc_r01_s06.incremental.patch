+struct ReadCounter<'a> {
+    bytes: &'a [u8],
+    read: usize,
+}
+
+impl Read for ReadCounter<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let len = buf.len().min(self.bytes.len());
+        buf[..len].copy_from_slice(&self.bytes[..len]);
+        self.bytes = &self.bytes[len..];
+        self.read += len;
+        Ok(len)
+    }
+}
