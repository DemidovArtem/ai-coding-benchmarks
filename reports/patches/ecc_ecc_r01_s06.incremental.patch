+#[test]
+fn after_context_limit_survives_reader_buffer_rolls() {
+    const LAST_CONTEXT: usize = 4_097 + 5_000;
+    let lines: Vec<String> = (1..=10_000)
+        .map(|number| {
+            let prefix = if [1, 4_096, 4_097, 10_000].contains(&number) {
+                "hit"
+            } else {
+                "row"
+            };
+            format!("{} {:011}\n", prefix, number)
+        })
+        .collect();
+    let haystack = lines.concat();
+    let matcher = RegexMatcher::new_line_matcher("hit").unwrap();
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1)).after_context(5_000);
+    for reader in [false, true] {
+        let sink = search(&builder, &matcher, haystack.as_bytes(), reader);
+        assert_eq!(sink.events.len(), LAST_CONTEXT);
+        for (index, event) in sink.events.iter().enumerate() {
+            let number = index + 1;
+            let expected = if [1, 4_096, 4_097].contains(&number) {
+                matched(number as u64, lines[index].as_bytes())
+            } else {
+                context(
+                    SinkContextKind::After,
+                    number as u64,
+                    lines[index].as_bytes(),
+                )
+            };
+            assert_eq!(*event, expected);
+        }
+    }
+}
