@@ -0,0 +1,633 @@
+use std::{
+    cell::Cell,
+    io::{self, Read},
+};
+
+use grep_matcher::{Match, Matcher, NoCaptures, NoError};
+use grep_regex::RegexMatcher;
+use grep_searcher::{
+    Searcher, SearcherBuilder, Sink, SinkContext, SinkContextKind, SinkFinish,
+    SinkMatch,
+};
+
+#[derive(Debug, Eq, PartialEq)]
+enum Kind {
+    Match,
+    Context(SinkContextKind),
+}
+
+#[derive(Debug, Eq, PartialEq)]
+struct Event {
+    kind: Kind,
+    number: u64,
+    bytes: Vec<u8>,
+}
+
+fn matched(number: u64, bytes: &[u8]) -> Event {
+    Event { kind: Kind::Match, number, bytes: bytes.to_vec() }
+}
+
+fn context(kind: SinkContextKind, number: u64, bytes: &[u8]) -> Event {
+    Event { kind: Kind::Context(kind), number, bytes: bytes.to_vec() }
+}
+
+#[derive(Default)]
+struct RecordingSink {
+    events: Vec<Event>,
+    finish: Option<u64>,
+}
+
+impl Sink for RecordingSink {
+    type Error = io::Error;
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        mat: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        self.events.push(matched(mat.line_number().unwrap(), mat.bytes()));
+        Ok(true)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        ctx: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.events.push(context(
+            ctx.kind().clone(),
+            ctx.line_number().unwrap(),
+            ctx.bytes(),
+        ));
+        Ok(true)
+    }
+
+    fn finish(&mut self, _: &Searcher, finish: &SinkFinish) -> io::Result<()> {
+        self.finish = Some(finish.byte_count());
+        Ok(())
+    }
+}
+
+// No line terminator or non-matching-byte hints: this matcher forces the
+// line-by-line slow path, and also supports genuine multiline expressions.
+struct CountedMatcher {
+    regex: regex::bytes::Regex,
+    calls: Cell<usize>,
+}
+
+impl CountedMatcher {
+    fn new(pattern: &str) -> CountedMatcher {
+        CountedMatcher {
+            regex: regex::bytes::Regex::new(pattern).unwrap(),
+            calls: Cell::new(0),
+        }
+    }
+}
+
+impl Matcher for CountedMatcher {
+    type Captures = NoCaptures;
+    type Error = NoError;
+
+    fn find_at(
+        &self,
+        haystack: &[u8],
+        at: usize,
+    ) -> Result<Option<Match>, NoError> {
+        self.calls.set(self.calls.get() + 1);
+        Ok(self
+            .regex
+            .find_at(haystack, at)
+            .map(|mat| Match::new(mat.start(), mat.end())))
+    }
+
+    fn new_captures(&self) -> Result<NoCaptures, NoError> {
+        Ok(NoCaptures::new())
+    }
+}
+
+fn search<M: Matcher>(
+    builder: &SearcherBuilder,
+    matcher: M,
+    haystack: &[u8],
+    reader: bool,
+) -> RecordingSink {
+    let mut sink = RecordingSink::default();
+    if reader {
+        builder.build().search_reader(matcher, haystack, &mut sink).unwrap();
+    } else {
+        builder.build().search_slice(matcher, haystack, &mut sink).unwrap();
+    }
+    sink
+}
+
+#[test]
+fn configuration_and_line_limits() {
+    let haystack = b"Sherlock Sherlock\nplain\nSherlock\nSherlock\n";
+    let matcher = RegexMatcher::new_line_matcher("Sherlock").unwrap();
+    assert_eq!(Searcher::new().max_matches(), None);
+    for limit in [None, Some(0), Some(1), Some(2)] {
+        let mut builder = SearcherBuilder::new();
+        builder.max_matches(limit);
+        assert_eq!(builder.build().max_matches(), limit);
+        let mut expected = vec![
+            matched(1, b"Sherlock Sherlock\n"),
+            matched(3, b"Sherlock\n"),
+            matched(4, b"Sherlock\n"),
+        ];
+        expected.truncate(limit.unwrap_or(3) as usize);
+        for reader in [false, true] {
+            assert_eq!(
+                search(&builder, &matcher, haystack, reader).events,
+                expected,
+            );
+        }
+    }
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1)).max_matches(None);
+    assert_eq!(builder.build().max_matches(), None);
+    assert_eq!(search(&builder, &matcher, haystack, false).events.len(), 3);
+}
