+fn passthru_emits_remaining_lines_without_discovering_more_matches() {
+    for multiline in [false, true] {
+        for reader in [false, true] {
+            let pattern = if multiline { "hit\\nnext" } else { "hit" };
+            let matcher = CountedMatcher::new(pattern);
+            let mut builder = SearcherBuilder::new();
+            builder.multi_line(multiline).passthru(true).max_matches(Some(1));
+            assert!(builder.build().passthru());
+            let haystack = if multiline {
+                &b"hit\nnext\nhit\nnext\ntail\n"[..]
+            } else {
+                &b"hit\nhit\ntail\n"[..]
+            };
+            let sink = search(&builder, &matcher, haystack, reader);
+            let expected = if multiline {
+                vec![
+                    matched(1, b"hit\nnext\n"),
+                    context(SinkContextKind::Other, 3, b"hit\n"),
+                    context(SinkContextKind::Other, 4, b"next\n"),
+                    context(SinkContextKind::Other, 5, b"tail\n"),
+                ]
+            } else {
+                vec![
+                    matched(1, b"hit\n"),
+                    context(SinkContextKind::Other, 2, b"hit\n"),
+                    context(SinkContextKind::Other, 3, b"tail\n"),
+                ]
+            };
+            assert_eq!(
+                sink.events,
+                expected,
+                "multiline={multiline}, reader={reader}",
+            );
+            assert_eq!(matcher.calls.get(), 1);
+            assert_eq!(sink.finish, Some(haystack.len() as u64));
+        }
+    }
