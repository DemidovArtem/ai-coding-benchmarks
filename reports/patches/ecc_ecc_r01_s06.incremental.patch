+#[test]
+fn multiline_after_context_matches_extend_the_window() {
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).max_matches(Some(1)).after_context(1);
+    for reader in [false, true] {
+        let sink = search(
+            &builder,
+            CountedMatcher::new("a\\nb"),
+            b"a\nb\na\nb\ngap\na\nb\n",
+            reader,
+        );
+        let mut lines = vec![];
+        for event in sink.events {
+            let event_lines = event.bytes.split_inclusive(|&b| b == b'\n');
+            for (index, bytes) in event_lines.enumerate() {
+                lines.push(Event {
+                    kind: match &event.kind {
+                        Kind::Match => Kind::Match,
+                        Kind::Context(kind) => Kind::Context(kind.clone()),
+                    },
+                    number: event.number + index as u64,
+                    bytes: bytes.to_vec(),
+                });
+            }
+        }
+        assert_eq!(
+            lines,
+            vec![
+                matched(1, b"a\n"),
+                matched(2, b"b\n"),
+                matched(3, b"a\n"),
+                matched(4, b"b\n"),
+                context(SinkContextKind::After, 5, b"gap\n"),
+            ],
+        );
+    }
+}
