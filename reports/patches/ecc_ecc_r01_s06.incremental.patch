+#[test]
+fn reader_does_not_consume_the_remaining_stream_after_limit() {
+    let mut haystack = b"plain\n".repeat(200_000);
+    haystack[..6].copy_from_slice(b"hit!!\n");
+    let matcher = RegexMatcher::new_line_matcher("hit").unwrap();
+    let mut stream = ReadCounter { bytes: &haystack, read: 0 };
+    let mut sink = RecordingSink::default();
+    SearcherBuilder::new()
+        .bom_sniffing(false)
+        .max_matches(Some(1))
+        .build()
+        .search_reader(&matcher, &mut stream, &mut sink)
+        .unwrap();
+    assert_eq!(sink.events, vec![matched(1, b"hit!!\n")]);
+    assert_eq!(sink.finish, Some(6));
+    // A search may read ahead into its buffer, but must not refill it after
+    // the limit is reached. This bound is independent of machine timing.
+    assert!(stream.read <= 64 * 1024);
+}
