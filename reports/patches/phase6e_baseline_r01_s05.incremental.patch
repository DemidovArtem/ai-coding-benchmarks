+    #[test]
+    fn large_after_context_short_reads() {
+        use std::io::Read;
+
+        // Match groups are adjacent, separated by one line, or separated by
+        // several buffers. This exercises separator state across rolls.
+        let matches = [0, 10_001, 20_003, 80_000];
+        let mut haystack = String::new();
+        for line in 0..100_000 {
+            let text = if matches.contains(&line) { "match" } else { "other" };
+            haystack.push_str(&format!("{line:06} {text} padding\n"));
+        }
+        let matcher = RegexMatcher::new("match");
+        for before in [0, 5] {
+            let mut builder = SearcherBuilder::new();
+            builder.before_context(before).after_context(10_000);
+            let mut expected = KitchenSink::new();
+            builder
+                .build()
+                .search_slice(&matcher, haystack.as_bytes(), &mut expected)
+                .unwrap();
+            for chunk in [1, 97, 8192] {
+                let short_reads =
+                    ShortReader { reader: haystack.as_bytes(), chunk };
+                let mut got = KitchenSink::new();
+                builder
+                    .build()
+                    .search_reader(&matcher, short_reads, &mut got)
+                    .unwrap();
+                assert_eq!(expected.as_bytes(), got.as_bytes());
+            }
+        }
+
+        struct ShortReader<R> {
+            reader: R,
+            chunk: usize,
+        }
+        impl<R: Read> Read for ShortReader<R> {
+            fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+                let len = buf.len().min(self.chunk);
+                self.reader.read(&mut buf[..len])
+            }
+        }
+    }
