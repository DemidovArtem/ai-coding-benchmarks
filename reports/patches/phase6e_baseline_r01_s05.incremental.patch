+#[cfg(test)]
+mod tests {
+    use super::Core;
+    use crate::{
+        searcher::SearcherBuilder,
+        testutil::{KitchenSink, RegexMatcher},
+    };
+
+    #[test]
+    fn roll_after_context_retains_only_gap_information() {
+        let searcher = SearcherBuilder::new().after_context(10_000).build();
+        let mut core = Core::new(
+            &searcher,
+            RegexMatcher::new("match"),
+            KitchenSink::new(),
+            false,
+        );
+        let buf = b"a\nb\nc\nd\ne\n";
+        assert_eq!(core.roll(buf), buf.len() - 1);
+        assert_eq!(core.pos(), 1);
+
+        // When output ends at the buffer boundary, the next buffer is
+        // adjacent and no gap needs to be retained for a separator.
+        core.last_line_visited = buf.len();
+        assert_eq!(core.roll(buf), buf.len());
+        assert_eq!(core.pos(), 0);
+    }
+
+    #[test]
+    fn roll_retains_before_context_independently_of_after_context() {
+        let searcher = SearcherBuilder::new()
+            .before_context(2)
+            .after_context(10_000)
+            .build();
+        let mut core = Core::new(
+            &searcher,
+            RegexMatcher::new("match"),
+            KitchenSink::new(),
+            false,
+        );
+        // Retain two before-context lines plus one line to detect a gap.
+        assert_eq!(core.roll(b"a\nb\nc\nd\ne\n"), 4);
+        assert_eq!(core.pos(), 6);
+    }
+}
