+    struct ShortReads<'a> {
+        bytes: &'a [u8],
+        chunk: usize,
+        calls: usize,
+    }
+
+    impl io::Read for ShortReads<'_> {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            self.calls += 1;
+            let len = buf.len().min(self.chunk).min(self.bytes.len());
+            buf[..len].copy_from_slice(&self.bytes[..len]);
+            self.bytes = &self.bytes[len..];
+            Ok(len)
+        }
+    }
+
+    #[test]
+    fn buffer_fills_capacity_with_short_reads() {
+        let mut source =
+            ShortReads { bytes: b"a\nb\nc\nd\ne", chunk: 2, calls: 0 };
+        let mut linebuf = LineBufferBuilder::new().capacity(8).build();
+        assert!(linebuf.fill(&mut source).unwrap());
+        assert_eq!(linebuf.buffer(), b"a\nb\nc\nd\n");
+        assert_eq!(source.calls, 4);
+        assert_eq!(linebuf.buf.len(), 8);
+        linebuf.consume(8);
+        assert!(linebuf.fill(&mut source).unwrap());
+        assert_eq!(linebuf.buffer(), b"e");
+        assert_eq!(source.calls, 6);
+        linebuf.consume(1);
+        assert!(!linebuf.fill(&mut source).unwrap());
+    }
