index 0000000000000000000000000000000000000000..49d6e0499925246dc720117e1f6130f259eef0f0
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,98 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_literal_only_when_enabled() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[a*?",
+    ] {
+        assert!(Glob::new(pattern).is_err(), "{pattern}");
+        assert!(GlobBuilder::new(pattern)
+            .allow_unclosed_class(false)
+            .build()
+            .is_err());
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .literal_separator(true)
+            .case_insensitive(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match("a"), "{pattern}");
+        assert!(!matcher.is_match("[abcxyz"), "{pattern}");
+    }
+    let matcher = GlobBuilder::new("[ABC")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("[abc"));
+}
+
+#[test]
+fn unclosed_alternate_branches() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{[abc,xyz}", &["[abc", "xyz"], &["a", "[abc,xyz"]),
+        ("{[abc,[xyz}", &["[abc", "[xyz"], &["a", "xyz"]),
+        ("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "x"]),
+        ("{a,{[bc,xyz}}", &["a", "[bc", "xyz"], &["b", "c"]),
+        ("{[abc,*.rs}", &["[abc", "lib.rs"], &["a", "lib.c"]),
+        ("{[}],xyz}", &["}", "xyz"], &["[}]", "x"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        let matcher = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap()
+            .compile_matcher();
+        for path in matches {
+            assert!(matcher.is_match(path), "{pattern}: {path}");
+        }
+        for path in nonmatches {
+            assert!(!matcher.is_match(path), "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn closed_classes_keep_validation_and_matching() {
+    for allowed in [false, true] {
+        assert_eq!(
+            GlobBuilder::new("[z-a]")
+                .allow_unclosed_class(allowed)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::InvalidRange('z', 'a')
+        );
+        for pattern in ["[a-c]", "[]a]", "[!x]", "[^x]"] {
+            let matcher = GlobBuilder::new(pattern)
+                .allow_unclosed_class(allowed)
+                .build()
+                .unwrap()
+                .compile_matcher();
+            assert!(matcher.is_match("a"), "{pattern}");
+            assert!(!matcher.is_match("x"), "{pattern}");
+        }
+    }
+}
+
+#[test]
+fn many_unclosed_brackets() {
+    let pattern = "[".repeat(10_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert!(glob.compile_matcher().is_match(&pattern));
+
+    let pattern = format!("{{{}}}", vec!["[a"; 10_000].join(","));
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert!(glob.compile_matcher().is_match("[a"));
+}
