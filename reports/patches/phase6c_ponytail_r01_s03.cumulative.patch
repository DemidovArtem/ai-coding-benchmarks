index 0000000000000000000000000000000000000000..6310238b8c62840c566eed9148915404a34e949a
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,109 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn alternate_regexes_preserve_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?-u)^(?:a|b)$"),
+        ("{a,{b,c}}", "(?-u)^(?:a|(?:b|c))$"),
+        ("{{a,b},{c,d}}", "(?-u)^(?:(?:a|b)|(?:c|d))$"),
+        ("{a,b{c,d}}", "(?-u)^(?:a|b(?:c|d))$"),
+        ("{a,{b,{c,d}}}", "(?-u)^(?:a|(?:b|(?:c|d)))$"),
+        ("{a,b}{c,{d,e}}", "(?-u)^(?:a|b)(?:c|(?:d|e))$"),
+        ("{a,{b,c}d,e}", "(?-u)^(?:a|(?:b|c)d|e)$"),
+        ("{a,{b,c}},d", "(?-u)^(?:a|(?:b|c)),d$"),
+    ] {
+        assert_eq!(Glob::new(pattern).unwrap().regex(), regex, "{pattern}");
+    }
+    let pattern = format!("{}a{}", "{".repeat(64), "}".repeat(64));
+    let regex = format!("(?-u)^{}a{}$", "(?:".repeat(64), ")".repeat(64));
+    assert_eq!(Glob::new(&pattern).unwrap().regex(), regex);
+}
+
+#[test]
+fn malformed_alternates() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b}", "{a,{b,c"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedAlternates, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnopenedAlternates, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn alternate_matches() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{a,{b,c}}", &["a", "b", "c"], &["", "d", "ab"]),
+        ("{{a,b},{c,d}}", &["a", "b", "c", "d"], &["", "e", "ac"]),
+        ("{a,b{c,d}}", &["a", "bc", "bd"], &["b", "be", "c", "ad"]),
+        (
+            "{a,b}{c,{d,e}}",
+            &["ac", "ad", "ae", "bc", "bd", "be"],
+            &["a", "c", "ab", "de"],
+        ),
+        ("{a,{b,c}d,e}", &["a", "bd", "cd", "e"], &["b", "c", "ed"]),
+        ("{a,{b,c}},d", &["a,d", "b,d", "c,d"], &["a", "d", "a,b"]),
+        ("a,b", &["a,b"], &["a", "b"]),
+        (
+            "{a,{[bc],d?}}*.rs",
+            &["a.rs", "bfoo.rs", "dx.rs"],
+            &["e.rs", "d.rs"],
+        ),
+        ("{[{],{[}],a}}", &["{", "}", "a"], &["b", ""]),
+        (
+            "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+            &[
+                "node_modules/pkg/ts",
+                "project/node_modules/pkg/lib/js",
+                "crates/lib.rs",
+                "project/crates/pkg/Cargo.toml",
+            ],
+            &["node_modules/pkg/rs", "crates/lib.js", "src/lib.rs"],
+        ),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        for literal_separator in [false, true] {
+            let glob = GlobBuilder::new(pattern)
+                .literal_separator(literal_separator)
+                .build()
+                .unwrap();
+            let matcher = glob.compile_matcher();
+            let set = GlobSetBuilder::new().add(glob).build().unwrap();
+            for (paths, expected) in [(matches, true), (nonmatches, false)] {
+                for path in paths {
+                    assert_eq!(
+                        matcher.is_match(path),
+                        expected,
+                        "{pattern}: {path}"
+                    );
+                    assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+                }
+            }
+        }
+    }
+}
+
+#[test]
+fn empty_alternates_keep_existing_semantics() {
+    for empty_alternates in [false, true] {
+        for pattern in ["{,a}", "{a,{,b}}", "{{},a}"] {
+            let glob = GlobBuilder::new(pattern)
+                .empty_alternates(empty_alternates)
+                .build()
+                .unwrap();
+            let matcher = glob.compile_matcher();
+            assert!(matcher.is_match("a"), "{pattern}");
+            assert_eq!(matcher.is_match(""), empty_alternates, "{pattern}");
+        }
+        for pattern in ["{}", "{,}", "{{}}"] {
+            let glob = GlobBuilder::new(pattern)
+                .empty_alternates(empty_alternates)
+                .build()
+                .unwrap();
+            assert!(glob.compile_matcher().is_match(""), "{pattern}");
+        }
+    }
+}
