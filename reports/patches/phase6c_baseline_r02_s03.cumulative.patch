diff --git a/crates/globset/tests/alternates.rs b/crates/globset/tests/alternates.rs
new file mode 100644
index 0000000000000000000000000000000000000000..98dc3ac41d7bd67eec5be5cf89d8ff47e2fce13a
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,132 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn check_matches(glob: Glob, matches: &[&str], nonmatches: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &path in matches {
+        assert!(matcher.is_match(path), "matcher should match {path:?}");
+        assert!(set.is_match(path), "set should match {path:?}");
+    }
+    for &path in nonmatches {
+        assert!(!matcher.is_match(path), "matcher should reject {path:?}");
+        assert!(!set.is_match(path), "set should reject {path:?}");
+    }
+}
+
+#[test]
+fn regex_preserves_group_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?-u)^(?:a|b)$"),
+        ("{a,{b,c}}", "(?-u)^(?:a|(?:b|c))$"),
+        ("{{a,b},{c,d}}", "(?-u)^(?:(?:a|b)|(?:c|d))$"),
+        ("{a,b{c,d}}", "(?-u)^(?:a|b(?:c|d))$"),
+        ("{a,{b,{c,d}},e}", "(?-u)^(?:a|(?:b|(?:c|d))|e)$"),
+        ("{a,b}{c,d}", "(?-u)^(?:a|b)(?:c|d)$"),
+        ("{a,{b,c}},d", "(?-u)^(?:a|(?:b|c)),d$"),
+    ] {
+        assert_eq!(Glob::new(pattern).unwrap().regex(), regex, "{pattern}");
+    }
+}
+
+#[test]
+fn nested_branches_match_complete_paths() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{a,{b,c}}", &["a", "b", "c"], &["", "d", "ab"]),
+        ("{{a,b},{c,d}}", &["a", "b", "c", "d"], &["", "ab", "e"]),
+        ("{a,b{c,d}}", &["a", "bc", "bd"], &["b", "be", "ac"]),
+        (
+            "x{a,{b,c}}{d,e}y",
+            &["xady", "xbey", "xcdy"],
+            &["xay", "xbd", "ad"],
+        ),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        check_matches(Glob::new(pattern).unwrap(), matches, nonmatches);
+    }
+}
+
+#[test]
+fn unmatched_braces_report_the_correct_error() {
+    for pattern in ["{", "{a,{b,c}", "{{a,b}", "{a,{b,c", "{{}"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedAlternates, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}", "{{a,b},{c,d}}}"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnopenedAlternates, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn commas_outside_groups_are_literal() {
+    check_matches(Glob::new("a,b").unwrap(), &["a,b"], &["a", "b"]);
+    check_matches(
+        Glob::new("{a,{b,c}},d").unwrap(),
+        &["a,d", "b,d", "c,d"],
+        &["a", "b", "c", "d"],
+    );
+}
+
+#[test]
+fn nested_groups_combine_with_other_glob_syntax() {
+    let pattern = "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}";
+    for literal_separator in [false, true] {
+        let glob = GlobBuilder::new(pattern)
+            .literal_separator(literal_separator)
+            .build()
+            .unwrap();
+        check_matches(
+            glob,
+            &[
+                "node_modules/pkg/ts",
+                "project/node_modules/pkg/src/js",
+                "crates/lib.rs",
+                "project/crates/example/Cargo.toml",
+            ],
+            &["crates/lib.js", "node_modules/pkg/rs", "other/lib.rs"],
+        );
+    }
+    check_matches(
+        Glob::new("{src/{[ab]*.rs,lib?.{rs,toml}},README}").unwrap(),
+        &["src/abc.rs", "src/lib1.toml", "src/lib2.rs", "README"],
+        &["src/c.rs", "src/lib.rs", "src/lib1.js", "README.md"],
+    );
+}
+
+#[test]
+fn empty_alternates_keep_existing_semantics() {
+    for empty_alternates in [false, true] {
+        let glob = GlobBuilder::new("x{a,{,b}}y")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap();
+        if empty_alternates {
+            check_matches(glob, &["xay", "xby", "xy"], &["xcy"]);
+        } else {
+            check_matches(glob, &["xay", "xby"], &["xy", "xcy"]);
+        }
+    }
+    check_matches(Glob::new("{{}} b").unwrap(), &[" b"], &["b"]);
+}
+
+#[test]
+fn escaped_braces_and_commas_do_not_change_group_scope() {
+    let glob = GlobBuilder::new(r"{a,{b\,c,\{d\}}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    check_matches(glob, &["a", "b,c", "{d}"], &["b", "c", "d"]);
+    check_matches(
+        Glob::new("{a,{[}],b}}").unwrap(),
+        &["a", "}", "b"],
+        &["{", "c"],
+    );
+}
+
+#[test]
+fn many_levels_of_nesting() {
+    let pattern = format!("{}a{}", "{b,".repeat(64), "}".repeat(64));
+    check_matches(Glob::new(&pattern).unwrap(), &["a", "b"], &["", "ab", "c"]);
+}
