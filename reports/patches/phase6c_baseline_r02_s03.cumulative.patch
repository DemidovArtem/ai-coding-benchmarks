@@ -0,0 +1,144 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn check_matches(glob: Glob, matches: &[&str], nonmatches: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &path in matches {
+        assert!(matcher.is_match(path), "matcher should match {path:?}");
+        assert!(set.is_match(path), "set should match {path:?}");
+    }
+    for &path in nonmatches {
+        assert!(!matcher.is_match(path), "matcher should reject {path:?}");
+        assert!(!set.is_match(path), "set should reject {path:?}");
+    }
+}
+
+#[test]
+fn strict_by_default_and_when_explicitly_disabled() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        let err = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .allow_unclosed_class(false)
+            .build()
+            .unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[☃",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob, &[pattern], &["", "a", "abc", "☃"]);
+    }
+}
+
+#[test]
+fn fallback_treats_the_remaining_text_literally() {
+    let glob = GlobBuilder::new("prefix*[a*?{b,c}")
+        .allow_unclosed_class(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    check_matches(
+        glob,
+        &["prefix[a*?{b,c}", "prefix-extra[a*?{b,c}"],
+        &["prefix[anything", "prefix[aX{b,c}", "prefixab"],
+    );
+    let glob = GlobBuilder::new(r"[\*")
+        .allow_unclosed_class(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.regex(), r"(?-u)^\[\\\*$");
+}
+
+#[test]
+fn alternation_branches_fall_back_independently() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{[abc,xyz}", &["[abc", "xyz"], &["a", "abc", "[abc,xyz}"]),
+        ("{[abc,[xyz}", &["[abc", "[xyz"], &["abc", "xyz"]),
+        ("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "xyz"]),
+        ("{a,{[b,[c}}", &["a", "[b", "[c"], &["b", "c"]),
+        ("{[abc,xyz}*", &["[abc!", "xyz!"], &["abc!", "[xyz"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob, matches, nonmatches);
+    }
+}
+
+#[test]
+fn closed_classes_and_other_errors_are_preserved() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("[abc]", &["a", "b", "c"], &["[abc]", "d"]),
+        ("[]]", &["]"], &["[]]", "["]),
+        ("[!a]", &["b", "c"], &["a", "[!a]"]),
+        ("{[}],x}", &["}", "x"], &["[}", "y"]),
+        ("{[a,b],x}", &["a", ",", "b", "x"], &["a,b", "y"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob, matches, nonmatches);
+    }
+    for (pattern, error) in [
+        ("[z-a]", ErrorKind::InvalidRange('z', 'a')),
+        ("{[abc", ErrorKind::UnclosedAlternates),
+        ("a}", ErrorKind::UnopenedAlternates),
+    ] {
+        let err = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err();
+        assert_eq!(err.kind(), &error, "{pattern}");
+    }
+}
+
+#[test]
+fn combines_with_other_builder_options() {
+    let glob = GlobBuilder::new("src/*[ABC")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .build()
+        .unwrap();
+    check_matches(
+        glob,
+        &["src/file[abc", "SRC/[ABC"],
+        &["src/sub/file[abc", "src/fileabc"],
+    );
+}
+
+#[test]
+fn many_opening_brackets() {
+    let pattern = "[".repeat(10_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    check_matches(glob, &[&pattern], &["[", ""]);
+
+    // Each branch would otherwise rescan all remaining branches for a `]`.
+    let pattern = format!("{{{}[}}", "[,".repeat(10_000));
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    check_matches(glob, &["["], &["", "[["]);
+}
