+    #[test]
+    fn min_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for name in ["foo", "a/foo", "a/b/foo", "a/b/c/foo"] {
+            wfile(td.path().join(name), "");
+        }
+        let all = &[
+            "", "a", "a/b", "a/b/c", "foo", "a/foo", "a/b/foo", "a/b/c/foo",
+        ];
+        let cases: &[(Option<usize>, Option<usize>, &[&str])] = &[
+            (None, None, all),
+            (Some(0), None, all),
+            (Some(1), None, &all[1..]),
+            (
+                Some(2),
+                None,
+                &["a/b", "a/b/c", "a/foo", "a/b/foo", "a/b/c/foo"],
+            ),
+            (Some(3), None, &["a/b/c", "a/b/foo", "a/b/c/foo"]),
+            (Some(4), None, &["a/b/c/foo"]),
+            (Some(5), None, &[]),
+            (None, Some(0), &[""]),
+            (None, Some(1), &["", "a", "foo"]),
+            (Some(1), Some(2), &["a", "a/b", "foo", "a/foo"]),
+            (Some(2), Some(2), &["a/b", "a/foo"]),
+            (Some(2), Some(0), &["a/b", "a/foo"]),
+            (Some(3), Some(1), &["a/b/c", "a/b/foo"]),
+            (Some(usize::MAX), Some(0), &[]),
+        ];
+        for &(min, max, expected) in cases {
+            for min_first in [false, true] {
+                let mut builder = WalkBuilder::new(td.path());
+                if min_first {
+                    builder.min_depth(min).max_depth(max);
+                } else {
+                    builder.max_depth(max).min_depth(min);
+                }
+                let serial =
+                    builder.build().collect::<Result<Vec<_>, _>>().unwrap();
+                let parallel = walk_collect_entries_parallel(&builder);
+                for entries in [serial, parallel] {
+                    let mut paths: Vec<_> = entries
+                        .iter()
+                        .map(|ent| {
+                            let path =
+                                ent.path().strip_prefix(td.path()).unwrap();
+                            normal_path(path.to_str().unwrap())
+                        })
+                        .collect();
+                    paths.sort();
+                    assert_eq!(
+                        paths,
+                        mkpaths(expected),
+                        "min={min:?}, max={max:?}"
+                    );
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn min_depth_preserves_ignore_rules() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b"));
+        wfile(td.path().join(".ignore"), "root-ignored\n");
+        wfile(td.path().join("a/.ignore"), "child-ignored\n");
+        for name in ["root-ignored", "child-ignored", "visible"] {
+            wfile(td.path().join("a/b").join(name), "");
+        }
+        let mut builder = WalkBuilder::new(td.path());
+        assert_paths(td.path(), builder.min_depth(Some(3)), &["a/b/visible"]);
+        builder.min_depth(Some(3)).max_depth(Some(1));
+        assert_paths(td.path(), &builder, &["a/b/visible"]);
+        assert_paths(td.path(), builder.min_depth(None), &["a"]);
+    }
+
+    #[test]
+    fn min_depth_file_and_stdin_roots() {
+        let td = tmpdir();
+        wfile(td.path().join("foo"), "");
+        for min in [None, Some(0), Some(1)] {
+            let mut builder = WalkBuilder::new(td.path().join("foo"));
+            builder.add("-").min_depth(min);
+            let serial =
+                builder.build().collect::<Result<Vec<_>, _>>().unwrap();
+            let parallel = walk_collect_entries_parallel(&builder);
+            for entries in [serial, parallel] {
+                assert_eq!(entries.len(), if min == Some(1) { 0 } else { 2 });
+                assert!(entries.iter().all(|ent| ent.depth() == 0));
+            }
+        }
+    }
+
+    #[test]
+    fn min_depth_preserves_errors() {
+        let td = tmpdir();
+        wfile(td.path().join(".ignore"), "[z-a]\n");
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(1));
+        assert!(builder.build().any(|result| result.is_err()));
+        let errors = Arc::new(Mutex::new(0));
+        builder.build_parallel().run(|| {
+            let errors = errors.clone();
+            Box::new(move |result| {
+                if result.is_err() {
+                    *errors.lock().unwrap() += 1;
+                }
+                WalkState::Continue
+            })
+        });
+        assert_eq!(*errors.lock().unwrap(), 1);
+    }
