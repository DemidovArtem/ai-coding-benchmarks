index 0000000000000000000000000000000000000000..bdcc0855e0b170533ece7de156d3bbac33262f13
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,106 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_literal_when_enabled() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^", "[^]", "[z-a",
+        "[a*?{x,y}", "[☃",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match("abc"), "{pattern}");
+        assert!(!set.is_match("abc"), "{pattern}");
+    }
+}
+
+#[test]
+fn unclosed_classes_are_errors_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+        );
+    }
+}
+
+#[test]
+fn unclosed_classes_in_alternation_branches() {
+    for (pattern, path, expected) in [
+        ("{[abc,xyz}", "[abc", true),
+        ("{[abc,xyz}", "xyz", true),
+        ("{[abc,[xyz}", "[abc", true),
+        ("{[abc,[xyz}", "[xyz", true),
+        ("{[abc],[xyz}", "a", true),
+        ("{[abc],[xyz}", "[abc]", false),
+        ("{[abc],[xyz}", "[xyz", true),
+        ("{[abc],[xyz}", "x", false),
+        ("{[abc,{[xyz,foo?}}", "[xyz", true),
+        ("{[abc,{[xyz,foo?}}", "foo1", true),
+        ("{[abc,{[xyz,foo?}}", "foo", false),
+        ("{[abc,xyz}*", "[abc123", true),
+        ("{[a*?,xyz}", "[a*?", true),
+        ("{[a*?,xyz}", "[abc", false),
+        ("{[a,b],xyz}", ",", true),
+        ("{[}],xyz}", "}", true),
+    ] {
+        let matcher = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap()
+            .compile_matcher();
+        assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+    }
+}
+
+#[test]
+fn unclosed_class_option_composes_with_other_options() {
+    let matcher = GlobBuilder::new("src/[ABC")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("src/[abc"));
+    assert!(!matcher.is_match("src/abc"));
+    assert!(!matcher.is_match("src/dir/[abc"));
+
+    let error = GlobBuilder::new("[z-a]")
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap_err();
+    assert_eq!(error.kind(), &ErrorKind::InvalidRange('z', 'a'));
+}
+
+#[test]
+fn many_unclosed_brackets() {
+    let pattern = "[".repeat(10_000);
+    let matcher = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match(&pattern));
+
+    let pattern = format!("{{{}}}", "[abc,".repeat(10_000));
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.regex().matches(r"\[abc").count(), 10_000);
+}
