+// Anchored custom ignore rules are relative to the working directory even when
+// the search root is absolute or is below the working directory.
+rgtest!(ignore_file_absolute_paths, |dir: Dir, _: TestCommand| {
+    dir.create_dir("a/b/c/nested");
+    dir.create_dir("home");
+    dir.create_dir("xdg");
+    dir.create("a/b/c/haystack", "test\n");
+    dir.create("a/b/c/visible", "test\n");
+    dir.create("a/b/c/nested/haystack", "test\n");
+    dir.create("a/b/c/nested/visible", "test\n");
+    let cwd = dir.path().join("a/b/c");
+    let ignore = dir.path().join("custom.ignore");
+    for (pattern, root_expected, nested_expected) in [
+        (
+            "/haystack\n",
+            "nested/haystack\nnested/visible\nvisible\n",
+            "nested/haystack\nnested/visible\n",
+        ),
+        ("haystack\n", "nested/visible\nvisible\n", "nested/visible\n"),
+    ] {
+        dir.create("custom.ignore", pattern);
+        for threads in ["1", "4"] {
+            for (root, expected) in [
+                (std::path::PathBuf::from("."), root_expected),
+                (cwd.clone(), root_expected),
+                (std::path::PathBuf::from("nested"), nested_expected),
+                (cwd.join("nested"), nested_expected),
+            ] {
+                let mut cmd = dir.command();
+                cmd.current_dir(&cwd)
+                    .args(&["--files", "--threads", threads, "--ignore-file"])
+                    .arg(&ignore)
+                    .arg(root);
+                cmd.cmd()
+                    .env("HOME", dir.path().join("home"))
+                    .env("USERPROFILE", dir.path().join("home"))
+                    .env("XDG_CONFIG_HOME", dir.path().join("xdg"))
+                    .env("GIT_CONFIG_NOSYSTEM", "1");
+                let prefix = format!("{}/", cwd.display()).replace('\\', "/");
+                let got = cmd.stdout().replace(&prefix, "").replace("./", "");
+                eqnice!(expected, sort_lines(&got));
+            }
+        }
+    }
+});
