+use std::io::{self, Read};
+
+use grep_regex::RegexMatcher;
+use grep_searcher::{
+    BinaryDetection, Searcher, SearcherBuilder, Sink, SinkContext, SinkFinish,
+    SinkMatch,
+};
+
+/// A stream that deterministically returns short reads, including reads that
+/// split lines, regardless of how much room the caller offers it.
+struct Chunked<'a> {
+    remaining: &'a [u8],
+    chunk_size: usize,
+    bytes_read: usize,
+}
+
+impl<'a> Chunked<'a> {
+    fn new(bytes: &'a [u8], chunk_size: usize) -> Chunked<'a> {
+        Chunked { remaining: bytes, chunk_size, bytes_read: 0 }
+    }
+}
+
+impl Read for Chunked<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        let len = buf.len().min(self.chunk_size).min(self.remaining.len());
+        buf[..len].copy_from_slice(&self.remaining[..len]);
+        self.remaining = &self.remaining[len..];
+        self.bytes_read += len;
+        Ok(len)
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+enum Event {
+    Line { matched: bool, number: u64, offset: u64, bytes: Vec<u8> },
+    Break,
+}
+
+#[derive(Default)]
+struct RecordingSink {
+    events: Vec<Event>,
+    finish: Option<(u64, Option<u64>)>,
+}
+
+impl Sink for RecordingSink {
+    type Error = io::Error;
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        mat: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        self.events.push(Event::Line {
+            matched: true,
+            number: mat.line_number().unwrap(),
+            offset: mat.absolute_byte_offset(),
+            bytes: mat.bytes().to_vec(),
+        });
+        Ok(true)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        context: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.events.push(Event::Line {
+            matched: false,
+            number: context.line_number().unwrap(),
+            offset: context.absolute_byte_offset(),
+            bytes: context.bytes().to_vec(),
+        });
+        Ok(true)
+    }
+
+    fn context_break(&mut self, _: &Searcher) -> io::Result<bool> {
+        self.events.push(Event::Break);
+        Ok(true)
+    }
+
+    fn finish(
+        &mut self,
+        _: &Searcher,
+        finish: &SinkFinish,
+    ) -> io::Result<()> {
+        self.finish =
+            Some((finish.byte_count(), finish.binary_byte_offset()));
+        Ok(())
+    }
+}
+
+#[test]
+fn large_after_context_on_partial_reads() {
+    let matches = [3_usize, 10_002, 10_004, 23_020];
+    let mut lines: Vec<String> = (1..=33_018)
+        .map(|number| {
+            let prefix = if matches.contains(&number) { "hit" } else { "row" };
+            format!("{} {:010}\n", prefix, number)
+        })
+        .collect();
+    // End in the middle of a context group with an unterminated final line.
+    lines.last_mut().unwrap().pop();
+    let haystack = lines.concat();
+    let matcher = RegexMatcher::new("hit").unwrap();
+    for before in [0, 5] {
+        // Determine the expected output from the union of requested line
+        // ranges, independently of the searcher's buffering strategy.
+        let mut expected = vec![];
+        let mut previous = None;
+        let mut offset = 0;
+        for (index, line) in lines.iter().enumerate() {
+            let number = index + 1;
+            let included = matches.iter().any(|&matched| {
+                matched.saturating_sub(before) <= number
+                    && number <= matched + 10_000
+            });
+            if included {
+                if previous.is_some_and(|last| last + 1 != number) {
+                    expected.push(Event::Break);
+                }
+                expected.push(Event::Line {
+                    matched: matches.contains(&number),
+                    number: number as u64,
+                    offset,
+                    bytes: line.as_bytes().to_vec(),
+                });
+                previous = Some(number);
+            }
+            offset += line.len() as u64;
+        }
+        for chunk_size in [31, 257] {
+            let mut stream = Chunked::new(haystack.as_bytes(), chunk_size);
+            let mut sink = RecordingSink::default();
+            SearcherBuilder::new()
+                .bom_sniffing(false)
+                .before_context(before)
+                .after_context(10_000)
+                .build()
+                .search_reader(&matcher, &mut stream, &mut sink)
+                .unwrap();
+            assert_eq!(sink.events, expected, "B{before}, chunk {chunk_size}");
+            assert_eq!(sink.finish, Some((haystack.len() as u64, None)));
+            assert_eq!(stream.bytes_read, haystack.len());
+        }
+    }
+}
+
+#[test]
+fn binary_in_second_partial_read_stops_before_searching_buffer() {
+    let mut haystack = b"match line here\n".repeat(32);
+    haystack[40] = 0;
+    let matcher = RegexMatcher::new("match").unwrap();
+    let mut stream = Chunked::new(&haystack, 32);
+    let mut sink = RecordingSink::default();
+    SearcherBuilder::new()
+        .bom_sniffing(false)
+        .after_context(10_000)
+        .binary_detection(BinaryDetection::quit(0))
+        .build()
+        .search_reader(&matcher, &mut stream, &mut sink)
+        .unwrap();
+    assert!(sink.events.is_empty());
+    assert_eq!(sink.finish, Some((0, Some(40))));
+    // The decoder may first request a small prefix. Regardless of that
+    // request, no further full chunk may be read after the one with the NUL.
+    assert!((41..=40 + 32).contains(&stream.bytes_read));
+}
+
+#[test]
+fn reader_detects_binary_in_unmatched_line_beyond_initial_capacity() {
+    // Each line is exactly 16 bytes, so the initial 64KiB buffer ends on a
+    // line boundary. The NUL lies outside that buffer and outside any match.
+    let mut haystack = b"plain line here\n".repeat(5_000);
+    haystack[..16].copy_from_slice(b"match line here\n");
+    haystack[4_999 * 16..].copy_from_slice(b"match line here\n");
+    let binary_offset = 64 * 1024 + 7;
+    haystack[binary_offset] = 0;
+    let matcher = RegexMatcher::new("match").unwrap();
+    let mut builder = SearcherBuilder::new();
+    builder
+        .bom_sniffing(false)
+        .binary_detection(BinaryDetection::quit(0));
+    let first = Event::Line {
+        matched: true,
+        number: 1,
+        offset: 0,
+        bytes: b"match line here\n".to_vec(),
+    };
+    let last = Event::Line {
+        matched: true,
+        number: 5_000,
+        offset: 4_999 * 16,
+        bytes: b"match line here\n".to_vec(),
+    };
+
+    let mut reader_sink = RecordingSink::default();
+    let mut stream = Chunked::new(&haystack, 31);
+    builder
+        .build()
+        .search_reader(&matcher, &mut stream, &mut reader_sink)
+        .unwrap();
+    assert_eq!(reader_sink.events, vec![first]);
+    assert_eq!(
+        reader_sink.finish,
+        Some((64 * 1024, Some(binary_offset as u64)))
+    );
+    assert_eq!(stream.bytes_read, 64 * 1024 + 31);
+
+    let mut slice_sink = RecordingSink::default();
+    builder
+        .build()
+        .search_slice(&matcher, &haystack, &mut slice_sink)
+        .unwrap();
+    assert_eq!(slice_sink.events.len(), 2);
+    assert_eq!(slice_sink.events[0], reader_sink.events[0]);
+    assert_eq!(slice_sink.events[1], last);
+    assert_eq!(slice_sink.finish, Some((haystack.len() as u64, None)));
+}
+
+#[test]
+fn context_break_at_first_match_after_buffer_boundary() {
+    const LINE_LEN: usize = 16;
+    const BOUNDARY_LINE: usize = 64 * 1024 / LINE_LEN;
+    const AFTER: usize = 1_000;
+    let matcher = RegexMatcher::new("hit").unwrap();
+    for before in [0, 5] {
+        for gap in [0, 1] {
+            let second_match = BOUNDARY_LINE + 1;
+            let first_match = BOUNDARY_LINE - before - AFTER - gap;
+            let matches = [first_match, second_match];
+            let lines: Vec<String> = (1..=5_100)
+                .map(|number| {
+                    let prefix =
+                        if matches.contains(&number) { "hit" } else { "row" };
+                    format!("{} {:011}\n", prefix, number)
+                })
+                .collect();
+            assert!(lines.iter().all(|line| line.len() == LINE_LEN));
+            let haystack = lines.concat();
+
+            // The second match is exactly the first line in the next 64KiB
+            // buffer. With B0 the first group's after-context either reaches
+            // the final old-buffer line, or skips just that line. With B5,
+            // adjust the first group so its end is adjacent to, or one line
+            // before, the second group's before-context.
+            let mut expected = vec![];
+            for (group, matched) in matches.into_iter().enumerate() {
+                if group == 1 && gap == 1 {
+                    expected.push(Event::Break);
+                }
+                for number in matched - before..=matched + AFTER {
+                    expected.push(Event::Line {
+                        matched: matches.contains(&number),
+                        number: number as u64,
+                        offset: ((number - 1) * LINE_LEN) as u64,
+                        bytes: lines[number - 1].as_bytes().to_vec(),
+                    });
+                }
+            }
+            let mut sink = RecordingSink::default();
+            SearcherBuilder::new()
+                .bom_sniffing(false)
+                .before_context(before)
+                .after_context(AFTER)
+                .build()
+                .search_reader(
+                    &matcher,
+                    Chunked::new(haystack.as_bytes(), 257),
+                    &mut sink,
+                )
+                .unwrap();
+            assert_eq!(sink.events, expected, "B{before}, gap {gap}");
+            assert_eq!(sink.finish, Some((haystack.len() as u64, None)));
+        }
+    }
+}
