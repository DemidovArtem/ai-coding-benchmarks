index 0000000000000000000000000000000000000000..6b6e1ddd6128f52747d3bdd3c5a509473aa05867
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,164 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(glob: Glob, matches: &[&str], nonmatches: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for path in matches {
+        assert!(matcher.is_match(path), "expected a match for {path:?}");
+        assert!(set.is_match(path), "expected a set match for {path:?}");
+        assert_eq!(set.matches(path), vec![0], "path: {path:?}");
+    }
+    for path in nonmatches {
+        assert!(!matcher.is_match(path), "unexpected match for {path:?}");
+        assert!(!set.is_match(path), "unexpected set match for {path:?}");
+        assert!(set.matches(path).is_empty(), "path: {path:?}");
+    }
+}
+
+#[test]
+fn regex_preserves_alternate_scope_and_order() {
+    let cases = [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}}}", "(?:a|(?:b|(?:c|d)))"),
+        ("{a,{b,c},d}", "(?:a|(?:b|c)|d)"),
+        ("{a,b}{c,d}", "(?:a|b)(?:c|d)"),
+        ("x{a,{b,c}d}y", "x(?:a|(?:b|c)d)y"),
+        ("{a,b},c", "(?:a|b),c"),
+        ("a,b", "a,b"),
+    ];
+    for (pattern, expected) in cases {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{expected}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn unmatched_alternate_braces() {
+    let cases = [
+        ("{", ErrorKind::UnclosedAlternates),
+        ("{a,b", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c}", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c", ErrorKind::UnclosedAlternates),
+        ("{{a,b},{c,d}", ErrorKind::UnclosedAlternates),
+        ("}", ErrorKind::UnopenedAlternates),
+        ("a,b}", ErrorKind::UnopenedAlternates),
+        ("{a,b}}", ErrorKind::UnopenedAlternates),
+        ("{a,{b,c}}}", ErrorKind::UnopenedAlternates),
+    ];
+    for (pattern, expected) in cases {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &expected, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn nested_alternate_matching() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("{a,{b,c}}", &["a", "b", "c"], &["", "d", "ab"]),
+        ("{{a,b},{c,d}}", &["a", "b", "c", "d"], &["", "ab", "e"]),
+        ("{a,b{c,d}}", &["a", "bc", "bd"], &["b", "be", "c", "abc"]),
+        ("{a,{b,c},d}", &["a", "b", "c", "d"], &["", "bc", "e"]),
+        (
+            "x{a,{b,c}d}y",
+            &["xay", "xbdy", "xcdy"],
+            &["xby", "xcy", "xady", "ay"],
+        ),
+        (
+            "{{a,b}x,{c,d}y}{e,{f,g}}",
+            &["axe", "axf", "bxg", "cye", "dyg"],
+            &["ax", "ae", "ayf", "cxf", "dyh"],
+        ),
+        ("{a,{b,c}},d", &["a,d", "b,d", "c,d"], &["a", "d", "b,c,d"]),
+        ("a,b", &["a,b"], &["a", "b"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        assert_matches(Glob::new(pattern).unwrap(), matches, nonmatches);
+    }
+}
+
+#[test]
+fn nested_alternates_with_glob_features() {
+    let pattern = "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}";
+    let glob = GlobBuilder::new(pattern)
+        .literal_separator(true)
+        .build()
+        .unwrap();
+    assert_matches(
+        glob,
+        &["node_modules/pkg/ts", "project/node_modules/pkg/src/js"],
+        &["node_modules/pkg/rs", "node_modules/pkg/src/index.js"],
+    );
+
+    let pattern = "**/{node_modules/**/*.{ts,js},crates/**/*.{rs,toml}}";
+    let glob = GlobBuilder::new(pattern)
+        .literal_separator(true)
+        .build()
+        .unwrap();
+    assert_matches(
+        glob,
+        &[
+            "node_modules/pkg/index.js",
+            "project/node_modules/pkg/src/index.ts",
+            "crates/lib.rs",
+            "project/crates/globset/Cargo.toml",
+        ],
+        &[
+            "node_modules/pkg/index.rs",
+            "crates/globset/src/lib.js",
+            "src/lib.rs",
+        ],
+    );
+
+    let glob = GlobBuilder::new("**/{a?,b{[0-9],*}}.rs")
+        .literal_separator(true)
+        .case_insensitive(true)
+        .build()
+        .unwrap();
+    assert_matches(
+        glob,
+        &["aX.rs", "src/B7.RS", "src/bname.rs"],
+        &["src/a.rs", "src/c7.rs", "src/b/name.rs"],
+    );
+}
+
+#[test]
+fn nested_alternates_with_literal_metacharacters() {
+    let glob = GlobBuilder::new(r"{a,{b\,c,[{}]}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    assert_matches(glob, &["a", "b,c", "{", "}"], &["b", "c", "{}"]);
+
+    let glob = GlobBuilder::new(r"\{a\,{b,{c,d}}\}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    assert_matches(glob, &["{a,b}", "{a,c}", "{a,d}"], &["a", "b", "{a,e}"]);
+}
+
+#[test]
+fn empty_alternates_keep_existing_semantics() {
+    for pattern in ["{,a}", "{a,}", "{a,{,}}", "{{},a}"] {
+        let glob = Glob::new(pattern).unwrap();
+        assert_matches(glob, &["a"], &["", "b"]);
+        let glob = GlobBuilder::new(pattern)
+            .empty_alternates(true)
+            .build()
+            .unwrap();
+        assert_matches(glob, &["", "a"], &["b"]);
+    }
+    for pattern in ["{}", "{,}", "{{}}", "{{,},{,}}"] {
+        assert_matches(Glob::new(pattern).unwrap(), &[""], &["a"]);
+    }
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    // Exceed the regex parser's default nesting limit as well.
+    let pattern = format!("{}z{}", "{a,".repeat(256), "}".repeat(256));
+    assert_matches(Glob::new(&pattern).unwrap(), &["a", "z"], &["", "az"]);
+}
