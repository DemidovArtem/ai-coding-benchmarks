@@ -0,0 +1,142 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+        let err = GlobBuilder::new(pattern)
+            .allow_unclosed_class(false)
+            .build()
+            .unwrap_err();
+        assert_eq!(err.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a*?", "[☃",
+        "[a,b", r"[a\*?{b}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern}");
+        assert!(set.is_match(pattern), "{pattern}");
+        assert!(!matcher.is_match(&pattern[1..]), "{pattern}");
+        assert!(!set.is_match(&pattern[1..]), "{pattern}");
+    }
+    let matcher = GlobBuilder::new("[abc*?")
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("[abc*?"));
+    assert!(!matcher.is_match("[abcxyz"));
+}
+
+#[test]
+fn closed_classes_keep_existing_semantics() {
+    let cases: &[(&str, &[&str], &[&str])] = &[
+        ("[abc]", &["a", "b", "c"], &["[abc]", "d"]),
+        ("[]]", &["]"], &["[]", "a"]),
+        ("[!]]", &["a"], &["]", "[!]"]),
+        ("[a-z]", &["a", "m", "z"], &["A", "-"]),
+        ("[-a]", &["-", "a"], &["b"]),
+        ("[a-]", &["-", "a"], &["b"]),
+        ("{[a,b],x}", &["a", "b", ",", "x"], &["[a", "b]"]),
+        ("{[{}],x}", &["{", "}", "x"], &["[{}]"]),
+    ];
+    for &(pattern, matches, nonmatches) in cases {
+        for allow in [false, true] {
+            let matcher = GlobBuilder::new(pattern)
+                .allow_unclosed_class(allow)
