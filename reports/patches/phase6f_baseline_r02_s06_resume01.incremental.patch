diff --git a/crates/searcher/src/searcher/max_matches_tests.rs b/crates/searcher/src/searcher/max_matches_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d8a1fa6499490c2e7a08c228b294230939e46219
--- /dev/null
+++ b/crates/searcher/src/searcher/max_matches_tests.rs
@@ -0,0 +1,329 @@
+use std::io;
+
+use grep_matcher::{LineTerminator, Match, Matcher, NoCaptures, NoError};
+
+use super::{Searcher, SearcherBuilder};
+use crate::{
+    sink::{Sink, SinkContext, SinkContextKind, SinkFinish, SinkMatch},
+    testutil::{RegexMatcher, ShortReads},
+};
+
+#[derive(Default)]
+struct Output {
+    text: String,
+    finished: bool,
+}
+
+impl Sink for Output {
+    type Error = io::Error;
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        mat: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        for line in mat.lines() {
+            self.text.push_str("M:");
+            self.text.push_str(std::str::from_utf8(line).unwrap());
+        }
+        Ok(true)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        context: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.text.push_str(match context.kind() {
+            SinkContextKind::Before => "B:",
+            SinkContextKind::After => "A:",
+            SinkContextKind::Other => "O:",
+        });
+        self.text.push_str(std::str::from_utf8(context.bytes()).unwrap());
+        Ok(true)
+    }
+
+    fn context_break(&mut self, _: &Searcher) -> io::Result<bool> {
+        self.text.push_str("--\n");
+        Ok(true)
+    }
+
+    fn finish(&mut self, _: &Searcher, _: &SinkFinish) -> io::Result<()> {
+        self.finished = true;
+        Ok(())
+    }
+}
+
+fn check(
+    builder: &SearcherBuilder,
+    pattern: &str,
+    haystack: &str,
+    expected: &str,
+) {
+    for reader in [false, true] {
+        for strategy in 0..3 {
+            let mut matcher = RegexMatcher::new(pattern);
+            if strategy > 0 && !builder.config.multi_line {
+                matcher.set_line_term(Some(LineTerminator::byte(b'\n')));
+                matcher.every_line_is_candidate(strategy == 2);
+            }
+            let mut searcher = builder.build();
+            let mut output = Output::default();
+            if reader {
+                searcher
+                    .search_reader(
+                        &matcher,
+                        ShortReads::new(haystack.as_bytes(), 3),
+                        &mut output,
+                    )
+                    .unwrap();
+            } else {
+                searcher
+                    .search_slice(&matcher, haystack.as_bytes(), &mut output)
+                    .unwrap();
+            }
+            assert_eq!(
+                output.text, expected,
+                "reader={reader}, strategy={strategy}",
+            );
+            assert!(output.finished);
+        }
+    }
+}
+
+#[test]
+fn limits_and_counter_reset() {
+    for multi in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multi);
+        assert_eq!(builder.build().max_matches(), None);
+        for (limit, expected) in [
+            (Some(0), ""),
+            (Some(1), "M:a\n"),
+            (Some(2), "M:a\nM:a\n"),
+            (Some(10), "M:a\nM:a\nM:a\n"),
+            (None, "M:a\nM:a\nM:a\n"),
+        ] {
+            builder.max_matches(limit);
+            assert_eq!(builder.build().max_matches(), limit);
+            check(&builder, "a", "x\na\nx\na\nx\na\n", expected);
+        }
+    }
+
+    let mut searcher = SearcherBuilder::new().max_matches(Some(1)).build();
+    let matcher = RegexMatcher::new("a");
+    for _ in 0..2 {
+        let mut output = Output::default();
+        searcher.search_slice(&matcher, b"a\na\n", &mut output).unwrap();
+        assert_eq!(output.text, "M:a\n");
+    }
+}
+
+#[test]
+fn before_and_after_context() {
+    for multi in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multi).max_matches(Some(1)).before_context(1);
+        check(&builder, "a", "x\na\ny\na\n", "B:x\nM:a\n");
+        builder.after_context(1);
+        check(&builder, "a", "x\na\ny\nz\na\n", "B:x\nM:a\nA:y\n");
+        check(
+            &builder,
+            "a",
+            "x\na\na\na\ny\nz\na\n",
+            "B:x\nM:a\nM:a\nM:a\nA:y\n",
+        );
+        check(&builder, "a", "a\na\n", "M:a\nM:a\n");
+    }
+}
+
+#[test]
+fn inverted_limits_and_context() {
+    for multi in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multi).invert_match(true).max_matches(Some(1));
+        check(&builder, "a", "a\nx\ny\na\n", "M:x\n");
+        builder.max_matches(Some(2)).after_context(1);
+        check(
+            &builder,
+            "a",
+            "x\na\ny\na\na\nz\n",
+            "M:x\nA:a\nM:y\nA:a\n",
+        );
+        builder.max_matches(Some(1));
+        check(&builder, "a", "x\ny\na\na\nz\n", "M:x\nM:y\nA:a\n");
+    }
+}
+
+#[test]
+fn multiline_counts_spans_before_coalescing() {
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).max_matches(Some(1));
+    check(&builder, "a\nb", "a\nb\na\nb\n", "M:a\nM:b\n");
+    builder.max_matches(Some(2));
+    check(
+        &builder,
+        "a\nb",
+        "a\nb\na\nb\na\nb\n",
+        "M:a\nM:b\nM:a\nM:b\n",
+    );
+    builder.max_matches(Some(1)).after_context(1);
+    check(
+        &builder,
+        "a\nb",
+        "a\nb\na\nb\nx\nz\na\nb\n",
+        "M:a\nM:b\nM:a\nM:b\nA:x\n",
+    );
+    builder.after_context(0).invert_match(true);
+    check(&builder, "a\nb", "a\nb\nx\ny\na\nb\n", "M:x\n");
+    builder.after_context(1);
+    check(&builder, "a\nb", "x\na\nb\ny\n", "M:x\nA:a\n");
+}
+
+#[test]
+fn limits_across_buffer_boundaries() {
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1)).heap_limit(Some(8)).after_context(1);
+    check(
+        &builder,
+        "a",
+        "a\nx\na\nx\na\nx\ny\na\n",
+        "M:a\nA:x\n",
+    );
+    builder.after_context(2);
+    check(
+        &builder,
+        "a",
+        "a\nx\na\nx\na\nx\ny\na\n",
+        "M:a\nA:x\nM:a\nA:x\nM:a\nA:x\nA:y\n",
+    );
+}
+
+#[test]
+fn passthrough_keeps_remaining_lines() {
+    for multi in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multi).max_matches(Some(1)).passthru(true);
+        assert!(builder.build().passthru());
+        check(&builder, "a", "x\na\nx\na\n", "O:x\nM:a\nO:x\nO:a\n");
+        builder.invert_match(true);
+        check(&builder, "a", "a\nx\ny\na\n", "O:a\nM:x\nO:y\nO:a\n");
+    }
+}
+
+#[test]
+fn zero_limit_never_reads_input() {
+    struct NoReads;
+    impl io::Read for NoReads {
+        fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+            panic!("a zero match limit must not read input");
+        }
+    }
+    for multi in [false, true] {
+        let mut searcher = SearcherBuilder::new()
+            .multi_line(multi)
+            .max_matches(Some(0))
+            .build();
+        let mut output = Output::default();
+        searcher
+            .search_reader(RegexMatcher::new("a"), NoReads, &mut output)
+            .unwrap();
+        assert_eq!(output.text, "");
+        assert!(output.finished);
+    }
+}
+
+#[test]
+fn no_matcher_calls_after_reaching_limit() {
+    struct Once {
+        calls: std::cell::Cell<usize>,
+        line_term: Option<LineTerminator>,
+    }
+    impl Matcher for Once {
+        type Captures = NoCaptures;
+        type Error = NoError;
+
+        fn find_at(
+            &self,
+            _: &[u8],
+            at: usize,
+        ) -> Result<Option<Match>, NoError> {
+            assert_eq!(self.calls.replace(self.calls.get() + 1), 0);
+            Ok(Some(Match::new(at, at + 1)))
+        }
+
+        fn new_captures(&self) -> Result<NoCaptures, NoError> {
+            Ok(NoCaptures::new())
+        }
+
+        fn line_terminator(&self) -> Option<LineTerminator> {
+            self.line_term
+        }
+    }
+    for (multi, fast) in [(false, false), (false, true), (true, false)] {
+        let matcher = Once {
+            calls: std::cell::Cell::new(0),
+            line_term: if fast {
+                Some(LineTerminator::byte(b'\n'))
+            } else {
+                None
+            },
+        };
+        let mut searcher = SearcherBuilder::new()
+            .max_matches(Some(1))
+            .multi_line(multi)
+            .build();
+        let mut output = Output::default();
+        searcher.search_slice(&matcher, b"a\na\na\n", &mut output).unwrap();
+        assert_eq!(output.text, "M:a\n");
+        assert_eq!(matcher.calls.get(), 1);
+    }
+}
+
+#[test]
+fn multiline_and_line_limits_agree_for_single_line_matches() {
+    let matcher = RegexMatcher::new("a");
+    for bits in 0..64 {
+        let haystack: String = (0..6)
+            .map(|bit| if bits & (1 << bit) == 0 { "x\n" } else { "a\n" })
+            .collect();
+        for invert in [false, true] {
+            for before in [0, 1] {
+                for after in [0, 1, 2] {
+                    for limit in [1, 2] {
+                        let mut builder = SearcherBuilder::new();
+                        builder
+                            .max_matches(Some(limit))
+                            .invert_match(invert)
+                            .before_context(before)
+                            .after_context(after);
+                        let mut line = Output::default();
+                        builder
+                            .build()
+                            .search_slice(
+                                &matcher,
+                                haystack.as_bytes(),
+                                &mut line,
+                            )
+                            .unwrap();
+                        let mut multi = Output::default();
+                        builder
+                            .multi_line(true)
+                            .build()
+                            .search_slice(
+                                &matcher,
+                                haystack.as_bytes(),
+                                &mut multi,
+                            )
+                            .unwrap();
+                        assert_eq!(
+                            multi.text, line.text,
+                            "{haystack:?}, invert={invert}, before={before}, \
+                             after={after}, limit={limit}",
+                        );
+                    }
+                }
+            }
+        }
+    }
