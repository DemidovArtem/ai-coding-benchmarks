+        for fast in [false, true] {
+            let mut matcher = RegexMatcher::new(pattern);
+            if fast && !builder.config.multi_line {
+                matcher.set_line_term(Some(grep_matcher::LineTerminator::byte(
+                    b'\n',
+                )));
