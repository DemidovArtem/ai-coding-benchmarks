+        }
+        impl std::io::Read for OneBuffer {
+            fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+                assert!(self.pos < self.bytes.len(), "read past match limit");
+                let len = buf.len().min(self.bytes.len() - self.pos);
+                buf[..len]
+                    .copy_from_slice(&self.bytes[self.pos..self.pos + len]);
+                self.pos += len;
+                Ok(len)
+            }
