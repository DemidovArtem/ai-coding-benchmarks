index 0000000000000000000000000000000000000000..9a36eafead8401e34d8d6cc2f6f0ebb074ba54ed
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,127 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern:?}",
+        );
+        let mut builder = GlobBuilder::new(pattern);
+        builder.allow_unclosed_class(true).allow_unclosed_class(false);
+        assert_eq!(
+            builder.build().unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+        );
+    }
+}
+
+#[test]
+fn unclosed_classes_match_the_literal_tail() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[☃",
+        "[*?{a,b}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        assert!(matcher.is_match(pattern), "{pattern:?}");
+        assert!(set.is_match(pattern), "{pattern:?}");
+        for rejected in ["", "a", "abc", "xyz", "[arbitrary"] {
+            assert!(!matcher.is_match(rejected), "{pattern:?}: {rejected:?}");
+            assert!(!set.is_match(rejected), "{pattern:?}: {rejected:?}");
+        }
+    }
+}
+
+#[test]
+fn alternation_branches_handle_unclosed_classes() {
+    for (pattern, accepted, rejected) in [
+        ("{[abc,xyz}", vec!["[abc", "xyz"], vec!["a", "abc"]),
+        ("{[abc,[xyz}", vec!["[abc", "[xyz"], vec!["a", "xyz"]),
+        ("{[abc],[xyz}", vec!["a", "b", "c", "[xyz"], vec!["[abc]", "x"]),
+        ("{{a,b},[x*}", vec!["a", "b", "[x*"], vec!["[xyz", "x"]),
+        ("{[x*,[y?}", vec!["[x*", "[y?"], vec!["[xyz", "[ya"]),
+    ] {
+        let matcher = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap()
+            .compile_matcher();
+        for path in accepted {
+            assert!(matcher.is_match(path), "{pattern:?}: {path:?}");
+        }
+        for path in rejected {
+            assert!(!matcher.is_match(path), "{pattern:?}: {path:?}");
+        }
+    }
+}
+
+#[test]
+fn closed_classes_keep_existing_semantics() {
+    for (pattern, paths) in [
+        ("[a-c]", vec!["a", "b", "c"]),
+        ("[]]", vec!["]"]),
+        ("[!a]", vec!["b"]),
+        ("{[a,b],[}]}", vec!["a", ",", "b", "}"]),
+    ] {
+        for allow in [false, true] {
+            let matcher = GlobBuilder::new(pattern)
+                .allow_unclosed_class(allow)
+                .build()
+                .unwrap()
+                .compile_matcher();
+            for path in &paths {
+                assert!(matcher.is_match(path), "{pattern:?}: {path:?}");
+            }
+        }
+    }
+    for pattern in ["[z-a]", "[z--]"] {
+        for allow in [false, true] {
+            assert!(matches!(
+                GlobBuilder::new(pattern)
+                    .allow_unclosed_class(allow)
+                    .build()
+                    .unwrap_err()
+                    .kind(),
+                ErrorKind::InvalidRange(..),
+            ));
+        }
+    }
+}
+
+#[test]
+fn unclosed_classes_compose_with_builder_options() {
+    let matcher = GlobBuilder::new("*/[ABC?*")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(matcher.is_match("dir/[abc?*"));
+    assert!(!matcher.is_match("dir/subdir/[ABC?*"));
+    assert!(!matcher.is_match("dir/[ABCD"));
+}
+
+#[test]
+fn many_unclosed_classes_parse_without_repeated_scans() {
+    let pattern = "[".repeat(100_000);
+    let glob = GlobBuilder::new(&pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert!(glob.regex().starts_with("(?-u)^\\[\\["));
+
+    let branches = format!("{{{}}}", vec!["[abc"; 10_000].join(","));
+    let glob = GlobBuilder::new(&branches)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert!(glob.regex().ends_with("\\[abc)$"));
+}
