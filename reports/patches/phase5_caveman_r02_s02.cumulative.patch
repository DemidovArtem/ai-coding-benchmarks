index 0000000000000000000000000000000000000000..ea7bb75390a3e84835b64a7f3d124be22ff48140
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,165 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(pattern: &str, paths: &[&str], rejected: &[&str]) {
+    let glob = Glob::new(pattern).unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for path in paths {
+        assert!(matcher.is_match(path), "{pattern:?} should match {path:?}");
+        assert!(set.is_match(path), "{pattern:?} should match {path:?}");
+    }
+    for path in rejected {
+        assert!(!matcher.is_match(path), "{pattern:?} matched {path:?}");
+        assert!(!set.is_match(path), "{pattern:?} matched {path:?}");
+    }
+}
+
+#[test]
+fn regex_preserves_group_scope_and_branch_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("x{{a,b}c,d{e,f}}y", "x(?:(?:a|b)c|d(?:e|f))y"),
+        ("{a,b}{c,{d,e}}", "(?:a|b)(?:c|(?:d|e))"),
+    ] {
+        assert_eq!(
+            Glob::new(pattern).unwrap().regex(),
+            format!("(?-u)^{regex}$"),
+            "{pattern:?}",
+        );
+    }
+}
+
+#[test]
+fn nested_branches_match() {
+    assert_matches("{a,{b,c}}", &["a", "b", "c"], &["", "d", "ab"]);
+    assert_matches(
+        "{{a,b},{c,d}}",
+        &["a", "b", "c", "d"],
+        &["", "e", "ac"],
+    );
+    assert_matches("{a,b{c,d}}", &["a", "bc", "bd"], &["b", "be", "c"]);
+    assert_matches(
+        "x{{a,b}c,d{e,f}}y",
+        &["xacy", "xbcy", "xdey", "xdfy"],
+        &["acy", "xay", "xdcy", "xacey"],
+    );
+    assert_matches(
+        "{a,b}{c,{d,e}}",
+        &["ac", "ad", "ae", "bc", "bd", "be"],
+        &["a", "c", "abc", "af"],
+    );
+}
+
+#[test]
+fn unmatched_braces_report_the_correct_error() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b}", "{a,{b,{c,d}}"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(
+            error.kind(),
+            &ErrorKind::UnclosedAlternates,
+            "{pattern:?}",
+        );
+        assert_eq!(error.glob(), Some(pattern));
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}", "{{a,b},{c,d}}}"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(
+            error.kind(),
+            &ErrorKind::UnopenedAlternates,
+            "{pattern:?}",
+        );
+        assert_eq!(error.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn commas_outside_groups_remain_literal() {
+    assert_matches("a,b", &["a,b"], &["a", "b"]);
+    assert_matches(
+        ",{a,{b,c}},d",
+        &[",a,d", ",b,d", ",c,d"],
+        &["a", ",b", "c,d"],
+    );
+}
+
+#[test]
+fn nested_groups_compose_with_other_glob_syntax() {
+    assert_matches(
+        "src/{lib{[0-2],?},bin{a*,b}}.{rs,toml}",
+        &["src/lib0.rs", "src/libx.toml", "src/binaaa.rs", "src/binb.toml"],
+        &["src/lib.rs", "src/binc.rs", "src/binb.js", "lib0.rs"],
+    );
+    assert_matches("{[{],{[}],[,]}}", &["{", "}", ","], &["a", ""]);
+    let glob = GlobBuilder::new(r"{a,{b\,c,\{d\}}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    for path in ["a", "b,c", "{d}"] {
+        assert!(matcher.is_match(path));
+    }
+    for path in ["b", "c", "d"] {
+        assert!(!matcher.is_match(path));
+    }
+}
+
+#[test]
+fn nested_project_paths_match() {
+    let pattern = "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}";
+    for literal_separator in [false, true] {
+        let glob = GlobBuilder::new(pattern)
+            .literal_separator(literal_separator)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        let set = GlobSetBuilder::new().add(glob).build().unwrap();
+        for path in [
+            "node_modules/pkg/ts",
+            "app/node_modules/pkg/src/js",
+            "crates/lib.rs",
+            "project/crates/core/src/lib.rs",
+            "crates/core/Cargo.toml",
+        ] {
+            assert!(matcher.is_match(path), "{path:?}");
+            assert!(set.is_match(path), "{path:?}");
+        }
+        for path in ["node_modules/pkg/rs", "crates/lib.js", "src/lib.rs"] {
+            assert!(!matcher.is_match(path), "{path:?}");
+            assert!(!set.is_match(path), "{path:?}");
+        }
+    }
+}
+
+#[test]
+fn empty_alternates_keep_existing_semantics() {
+    for (pattern, without_empty, with_empty) in [
+        ("{a,{,b}}", "(?:a|(?:b))", "(?:a|(?:|b))"),
+        ("{{a,},b}", "(?:(?:a)|b)", "(?:(?:a|)|b)"),
+        ("{,{,}}", "", "(?:|(?:|))"),
+    ] {
+        for (empty_alternates, regex) in
+            [(false, without_empty), (true, with_empty)]
+        {
+            let glob = GlobBuilder::new(pattern)
+                .empty_alternates(empty_alternates)
+                .build()
+                .unwrap();
+            assert_eq!(glob.regex(), format!("(?-u)^{regex}$"));
+            let matcher = glob.compile_matcher();
+            assert_eq!(
+                matcher.is_match(""),
+                empty_alternates || regex.is_empty(),
+            );
+        }
+    }
+}
+
+#[test]
+fn deeply_nested_groups_match() {
+    let pattern = format!("{}a{}", "{".repeat(64), "}".repeat(64));
+    assert_matches(&pattern, &["a"], &["", "b", "aa"]);
+}
