+    #[test]
+    fn min_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        wfile(td.path().join("foo"), "");
+        wfile(td.path().join("a/foo"), "");
+        wfile(td.path().join("a/b/foo"), "");
+        wfile(td.path().join("a/b/c/foo"), "");
+
+        let all = &[
+            ("", 0),
+            ("a", 1),
+            ("foo", 1),
+            ("a/b", 2),
+            ("a/foo", 2),
+            ("a/b/c", 3),
+            ("a/b/foo", 3),
+            ("a/b/c/foo", 4),
+        ];
+        let mut builder = WalkBuilder::new(td.path());
+        assert_depth_entries(td.path(), &builder, all);
+        assert_depth_entries(td.path(), builder.min_depth(Some(0)), all);
+        assert_depth_entries(td.path(), builder.min_depth(Some(1)), &all[1..]);
+        assert_depth_entries(td.path(), builder.min_depth(Some(2)), &all[3..]);
+        assert_depth_entries(td.path(), builder.min_depth(Some(3)), &all[5..]);
+        assert_depth_entries(td.path(), builder.min_depth(Some(4)), &all[7..]);
+        assert_depth_entries(td.path(), builder.min_depth(Some(5)), &[]);
+        assert_depth_entries(
+            td.path(),
+            builder.min_depth(Some(usize::MAX)),
+            &[],
+        );
+        assert_depth_entries(td.path(), builder.min_depth(None), all);
+    }
+
+    #[test]
+    fn min_depth_with_max_depth() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        wfile(td.path().join("a/foo"), "");
+        wfile(td.path().join("a/b/c/foo"), "");
+
+        for (min, max, expected) in [
+            (0, 0, &[("", 0)][..]),
+            (1, 2, &[("a", 1), ("a/b", 2), ("a/foo", 2)][..]),
+            (2, 2, &[("a/b", 2), ("a/foo", 2)][..]),
+            (2, 1, &[("a/b", 2), ("a/foo", 2)][..]),
+            (3, 0, &[("a/b/c", 3)][..]),
+            (4, 1, &[("a/b/c/foo", 4)][..]),
+            (5, 1, &[][..]),
+            (usize::MAX, 0, &[][..]),
+        ] {
+            let mut builder = WalkBuilder::new(td.path());
+            builder.min_depth(Some(min)).max_depth(Some(max));
+            assert_depth_entries(td.path(), &builder, expected);
+            let mut builder = WalkBuilder::new(td.path());
+            builder.max_depth(Some(max)).min_depth(Some(min));
+            assert_depth_entries(td.path(), &builder, expected);
+        }
+
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(3)).max_depth(Some(1));
+        assert_depth_entries(td.path(), &builder, &[("a/b/c", 3)]);
+        assert_depth_entries(
+            td.path(),
+            builder.min_depth(None),
+            &[("", 0), ("a", 1)],
+        );
+        assert_depth_entries(
+            td.path(),
+            builder.min_depth(Some(3)).max_depth(None),
+            &[("a/b/c", 3), ("a/b/c/foo", 4)],
+        );
+    }
+
