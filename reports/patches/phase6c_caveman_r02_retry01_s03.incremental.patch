+    fn assert_depth_entries(
+        prefix: &Path,
+        builder: &WalkBuilder,
+        expected: &[(&str, usize)],
+    ) {
+        let normalize = |dent: DirEntry| {
+            let path = if dent.is_stdin() {
+                "<stdin>".to_string()
+            } else {
+                let path = dent.path().strip_prefix(prefix).unwrap();
+                normal_path(path.to_str().unwrap())
+            };
+            (path, dent.depth())
+        };
+        let mut expected: Vec<_> = expected
+            .iter()
+            .map(|&(path, depth)| (path.to_string(), depth))
+            .collect();
+        expected.sort();
+        let mut serial: Vec<_> =
+            builder.build().map(|dent| normalize(dent.unwrap())).collect();
+        serial.sort();
+        assert_eq!(serial, expected, "single threaded");
+        for threads in [1, 4] {
+            let entries = Mutex::new(vec![]);
+            builder.clone().threads(threads).build_parallel().run(|| {
+                Box::new(|dent| {
+                    entries.lock().unwrap().push(dent);
+                    WalkState::Continue
+                })
+            });
+            let mut parallel: Vec<_> = entries
+                .into_inner()
+                .unwrap()
+                .into_iter()
+                .map(|dent| normalize(dent.unwrap()))
+                .collect();
+            parallel.sort();
+            assert_eq!(parallel, expected, "parallel with {threads} threads");
+        }
+    }
