+    #[test]
+    fn buffer_short_reads_fill_capacity() {
+        let bytes = b"a\nbb\nccc\ndddd\n";
+        let mut reader = ShortReader { bytes, reads: 0 };
+        let mut linebuf = LineBufferBuilder::new().capacity(7).build();
+        assert!(linebuf.fill(&mut reader).unwrap());
+        assert_eq!(linebuf.buffer(), b"a\nbb\n");
+        assert_eq!(reader.reads, 4);
+        assert_eq!(reader.bytes, &bytes[7..]);
+        assert_eq!(linebuf.buf.len(), 7);
+
+        let mut got = linebuf.buffer().to_vec();
+        linebuf.consume_all();
+        while linebuf.fill(&mut reader).unwrap() {
+            got.extend_from_slice(linebuf.buffer());
+            linebuf.consume_all();
+        }
+        assert_eq!(got, bytes);
+        assert_eq!(linebuf.absolute_byte_offset(), bytes.len() as u64);
+        assert_eq!(linebuf.buf.len(), 7);
+    }
+
+    #[test]
+    fn buffer_short_reads_binary_detection() {
+        let mut reader = ShortReader { bytes: b"a\nb\0rest", reads: 0 };
+        let mut linebuf = LineBufferBuilder::new()
+            .capacity(32)
+            .binary_detection(BinaryDetection::Quit(0))
+            .build();
+        assert!(linebuf.fill(&mut reader).unwrap());
+        assert_eq!(linebuf.buffer(), b"a\nb");
+        assert_eq!(linebuf.binary_byte_offset(), Some(3));
+        assert_eq!(reader.reads, 2);
+        assert_eq!(reader.bytes, b"rest");
+        linebuf.consume_all();
+        assert!(!linebuf.fill(&mut reader).unwrap());
+        assert_eq!(reader.reads, 2);
+
+        let mut reader = ShortReader { bytes: b"a\0b\0c\0d\n", reads: 0 };
+        let mut linebuf = LineBufferBuilder::new()
+            .capacity(8)
+            .binary_detection(BinaryDetection::Convert(0))
+            .build();
+        assert!(linebuf.fill(&mut reader).unwrap());
+        assert_eq!(linebuf.buffer(), b"a\nb\nc\nd\n");
+        assert_eq!(linebuf.binary_byte_offset(), Some(1));
+        assert_eq!(reader.reads, 4);
+    }
