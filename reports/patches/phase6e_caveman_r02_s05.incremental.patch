+rgtest!(large_after_context_stdin, |dir: Dir, _: TestCommand| {
+    use std::fmt::Write;
+
+    let padding = format!("{}\n", "z".repeat(100));
+    let haystack = format!(
+        "needle\n{}needle\n{}",
+        padding.repeat(30_000),
+        padding.repeat(10_000),
+    );
+    dir.create("haystack", &haystack);
+    for (after, before) in [(1000, 0), (1000, 5), (10_000, 0), (10_000, 5)] {
+        let mut expected = "1:needle\n".to_string();
+        for line in 2..2 + after {
+            write!(expected, "{line}-{padding}").unwrap();
+        }
+        expected.push_str("--\n");
+        for line in 30_002 - before..30_002 {
+            write!(expected, "{line}-{padding}").unwrap();
+        }
+        expected.push_str("30002:needle\n");
+        for line in 30_003..30_003 + after {
+            write!(expected, "{line}-{padding}").unwrap();
+        }
+        let args = [
+            "--no-mmap",
+            "-n",
+            "-A",
+            &after.to_string(),
+            "-B",
+            &before.to_string(),
+            "needle",
+        ];
+        eqnice!(expected, dir.command().args(&args).arg("haystack").stdout());
+        eqnice!(expected, dir.command().args(&args).pipe(haystack.as_bytes()));
+    }
+});
