+            ),
+        ] {
+            let matcher = RegexMatcher::new("x");
+            let mut searcher = SearcherBuilder::new()
+                .line_number(false)
+                .after_context(1)
+                .heap_limit(Some(8))
+                .build();
+            let mut sink = KitchenSink::new();
+            searcher
