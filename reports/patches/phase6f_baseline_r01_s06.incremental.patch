+#[test]
+fn limited_after_context_crosses_buffer_boundaries() {
+    let mut haystack = "a\n".to_string();
+    haystack.push_str(&"b\n".repeat(40_000));
+    haystack.push_str("a\nc\n");
+    let matcher = RegexMatcherBuilder::new().build("a").unwrap();
+    let mut sink = Events::default();
+    SearcherBuilder::new()
+        .max_matches(Some(1))
+        .after_context(40_000)
+        .line_terminator(LineTerminator::byte(b'\n'))
+        .build()
+        .search_reader(&matcher, haystack.as_bytes(), &mut sink)
+        .unwrap();
+    assert_eq!(sink.lines.len(), 40_001);
+    assert_eq!(sink.lines.iter().filter(|(m, _)| *m).count(), 1);
+    assert_eq!(sink.byte_count, 80_002);
+}
