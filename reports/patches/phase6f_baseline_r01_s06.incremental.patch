+#[test]
+fn multiline_limit_counts_spans_before_grouping() {
+    for (limit, expected) in [
+        (1, vec![(true, "a\nb\n")]),
+        (2, vec![(true, "a\nb\na\nb\n")]),
+    ] {
+        let matcher = RegexMatcherBuilder::new().build("a\\nb").unwrap();
+        for reader in [false, true] {
+            let mut sink = Events::default();
+            let mut searcher = SearcherBuilder::new()
+                .multi_line(true)
+                .max_matches(Some(limit))
+                .build();
+            if reader {
+                searcher
+                    .search_reader(
+                        &matcher,
+                        &b"a\nb\na\nb\na\nb\n"[..],
+                        &mut sink,
+                    )
+                    .unwrap();
+            } else {
+                searcher
+                    .search_slice(&matcher, b"a\nb\na\nb\na\nb\n", &mut sink)
+                    .unwrap();
+            }
+            let expected: Vec<_> = expected
+                .iter()
+                .map(|&(m, s)| (m, s.as_bytes().to_vec()))
+                .collect();
+            assert_eq!(sink.lines, expected);
+        }
+    }
+    check(
+        SearcherBuilder::new()
+            .multi_line(true)
+            .max_matches(Some(1))
+            .after_context(1),
+        "a",
+        "a\nb\na\n",
+        &[(true, "a\n"), (false, "b\n")],
+    );
+}
