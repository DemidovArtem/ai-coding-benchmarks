+#[test]
+fn multiline_spans_with_inversion_and_passthru() {
+    let matcher = RegexMatcherBuilder::new().build("a\\nb").unwrap();
+    let haystack = b"a\nb\nc\nd\na\nb\n";
+    let cases: &[(bool, bool, &[(bool, &str)])] = &[
+        (false, false, &[(true, "a\nb\n")]),
+        (
+            false,
+            true,
+            &[
+                (true, "a\nb\n"),
+                (false, "c\n"),
+                (false, "d\n"),
+                (false, "a\n"),
+                (false, "b\n"),
+            ],
+        ),
+        (true, false, &[(true, "c\n")]),
+        (
+            true,
+            true,
+            &[
+                (false, "a\n"),
+                (false, "b\n"),
+                (true, "c\n"),
+                (false, "d\n"),
+                (false, "a\n"),
+                (false, "b\n"),
+            ],
+        ),
+    ];
+    for &(invert, passthru, expected) in cases {
+        let expected: Vec<_> = expected
+            .iter()
+            .map(|&(m, s)| (m, s.as_bytes().to_vec()))
+            .collect();
+        for reader in [false, true] {
+            let mut searcher = SearcherBuilder::new()
+                .multi_line(true)
+                .max_matches(Some(1))
+                .invert_match(invert)
+                .passthru(passthru)
+                .build();
+            let mut sink = Events::default();
+            if reader {
+                searcher
+                    .search_reader(&matcher, &haystack[..], &mut sink)
+                    .unwrap();
+            } else {
+                searcher.search_slice(&matcher, haystack, &mut sink).unwrap();
+            }
+            assert_eq!(sink.lines, expected);
+        }
+    }
+}
