new file mode 100644
index 0000000000000000000000000000000000000000..37a66c1e403a56f2c1f6332d08b655735c283fd9
--- /dev/null
+++ b/crates/searcher/tests/max_matches.rs
@@ -0,0 +1,351 @@
+use std::io;
+
+use grep_matcher::LineTerminator;
+use grep_regex::RegexMatcherBuilder;
+use grep_searcher::{
+    Searcher, SearcherBuilder, Sink, SinkContext, SinkFinish, SinkMatch,
+};
+
+#[derive(Default, Debug)]
+struct Events {
+    lines: Vec<(bool, Vec<u8>)>,
+    byte_count: u64,
+    began: bool,
+    finished: bool,
+}
+
+impl Sink for Events {
+    type Error = io::Error;
+
+    fn begin(&mut self, _: &Searcher) -> io::Result<bool> {
+        self.began = true;
+        Ok(true)
+    }
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        mat: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        self.lines.push((true, mat.bytes().to_vec()));
+        Ok(true)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        ctx: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.lines.push((false, ctx.bytes().to_vec()));
+        Ok(true)
+    }
+
+    fn finish(&mut self, _: &Searcher, end: &SinkFinish) -> io::Result<()> {
+        self.byte_count = end.byte_count();
+        self.finished = true;
+        Ok(())
+    }
+}
+
+fn check(
+    builder: &SearcherBuilder,
+    pattern: &str,
+    haystack: &str,
+    expected: &[(bool, &str)],
+) {
+    let expected: Vec<_> =
+        expected.iter().map(|&(m, s)| (m, s.as_bytes().to_vec())).collect();
+    for line_term in [None, Some(b'\n')] {
+        let matcher = RegexMatcherBuilder::new()
+            .multi_line(true)
+            .line_terminator(line_term)
+            .build(pattern)
+            .unwrap();
+        for reader in [false, true] {
+            let mut sink = Events::default();
+            let mut searcher = builder.build();
+            if reader {
+                searcher
+                    .search_reader(&matcher, haystack.as_bytes(), &mut sink)
+                    .unwrap();
+            } else {
+                searcher
+                    .search_slice(&matcher, haystack.as_bytes(), &mut sink)
+                    .unwrap();
+            }
+            assert_eq!(
+                sink.lines, expected,
+                "reader={reader}, term={line_term:?}",
+            );
+            assert!(sink.began && sink.finished);
+        }
+    }
+}
+
+#[test]
+fn limit_configuration_and_reused_searcher() {
+    assert_eq!(Searcher::new().max_matches(), None);
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(1));
+    assert_eq!(builder.build().max_matches(), Some(1));
+    check(
+        &builder,
+        "Sherlock",
+        "Sherlock\nSherlock\n",
+        &[(true, "Sherlock\n")],
+    );
+    builder.max_matches(None);
+    check(&builder, "a", "a\na\n", &[(true, "a\n"), (true, "a\n")]);
+
+    let matcher = RegexMatcherBuilder::new().build("a").unwrap();
+    let mut searcher = builder.max_matches(Some(1)).build();
+    for _ in 0..2 {
+        let mut sink = Events::default();
+        searcher.search_slice(&matcher, b"a\na\n", &mut sink).unwrap();
+        assert_eq!(sink.lines, vec![(true, b"a\n".to_vec())]);
+        assert_eq!(sink.byte_count, 2);
+    }
+}
+
+#[test]
+fn zero_limit_does_not_read_input() {
+    struct Unreadable;
+    impl io::Read for Unreadable {
+        fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+            panic!("zero-limit search read input");
+        }
+    }
+    for multi_line in [false, true] {
+        let matcher = RegexMatcherBuilder::new().build("a\\nb").unwrap();
+        let mut searcher = SearcherBuilder::new()
+            .multi_line(multi_line)
+            .max_matches(Some(0))
+            .build();
+        let mut sink = Events::default();
+        searcher.search_reader(&matcher, Unreadable, &mut sink).unwrap();
+        assert!(sink.began && sink.finished);
+        assert!(sink.lines.is_empty());
+        assert_eq!(sink.byte_count, 0);
+    }
+}
+
+#[test]
+fn after_context_matches_extend_the_window() {
+    for multi_line in [false, true] {
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .max_matches(Some(1))
+                .after_context(1),
+            "a",
+            "a\na\nb\na\n",
+            &[(true, "a\n"), (true, "a\n"), (false, "b\n")],
+        );
+    }
+    check(
+        SearcherBuilder::new()
+            .max_matches(Some(2))
+            .before_context(1)
+            .after_context(1),
+        "a",
+        "b\na\nb\nb\na\nb\na\n",
+        &[
+            (false, "b\n"),
+            (true, "a\n"),
+            (false, "b\n"),
+            (false, "b\n"),
+            (true, "a\n"),
+            (false, "b\n"),
+        ],
+    );
+}
+
+#[test]
+fn passthru_continues_after_match_discovery_stops() {
+    for multi_line in [false, true] {
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .max_matches(Some(1))
+                .passthru(true),
+            "a",
+            "b\na\na\nb\n",
+            &[(false, "b\n"), (true, "a\n"), (false, "a\n"), (false, "b\n")],
+        );
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .max_matches(Some(1))
+                .invert_match(true)
+                .passthru(true),
+            "a",
+            "b\na\nc\nb\n",
+            &[(true, "b\n"), (false, "a\n"), (false, "c\n"), (false, "b\n")],
+        );
+    }
+}
+
+#[test]
+fn inverted_limit_counts_non_matching_lines() {
+    for multi_line in [false, true] {
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .invert_match(true)
