+            "a",
+            "a\nb\nc\na\n",
+            &[(true, "b\n")],
+        );
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .invert_match(true)
+                .max_matches(Some(2))
+                .after_context(1),
+            "a",
+            "b\na\nc\na\nd\n",
+            &[(true, "b\n"), (false, "a\n"), (true, "c\n"), (false, "a\n")],
+        );
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .invert_match(true)
+                .max_matches(Some(1))
+                .after_context(1),
+            "a",
+            "b\nc\na\nd\n",
+            &[(true, "b\n"), (true, "c\n"), (false, "a\n")],
+        );
+        check(
+            SearcherBuilder::new()
+                .multi_line(multi_line)
+                .invert_match(true)
+                .max_matches(Some(1))
+                .before_context(2)
