diff --git a/crates/ignore/tests/unclosed_class.rs b/crates/ignore/tests/unclosed_class.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ad858f9271a293fa13d8536ead79f01ab4054da0
--- /dev/null
+++ b/crates/ignore/tests/unclosed_class.rs
@@ -0,0 +1,37 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    let mut builder = GitignoreBuilder::new("");
+    builder.add_line(None, "[abc").unwrap();
+    let matcher = builder.build().unwrap();
+    assert!(matcher.matched("[abc", false).is_ignore());
+    assert!(matcher.matched("subdir/[abc", false).is_ignore());
+    assert!(matcher.matched("abc", false).is_none());
+}
+
+#[test]
+fn gitignore_toggle_only_affects_later_patterns() {
+    let mut builder = GitignoreBuilder::new("");
+    builder.add_line(None, "[abc").unwrap();
+    assert!(builder
+        .allow_unclosed_class(false)
+        .add_line(None, "[xyz")
+        .is_err());
+    builder.allow_unclosed_class(true).add_line(None, "[xyz").unwrap();
+    let matcher = builder.build().unwrap();
+    assert!(matcher.matched("[abc", false).is_ignore());
+    assert!(matcher.matched("[xyz", false).is_ignore());
+}
+
+#[test]
+fn overrides_reject_unclosed_classes_by_default() {
+    let mut builder = OverrideBuilder::new("");
+    let error = builder.add("[abc").unwrap_err();
+    assert!(error.to_string().contains("unclosed character class"));
+    builder.allow_unclosed_class(true).add("[abc").unwrap();
+    assert!(builder.allow_unclosed_class(false).add("[xyz").is_err());
+    let matcher = builder.build().unwrap();
+    assert!(matcher.matched("[abc", false).is_whitelist());
+    assert!(matcher.matched("abc", false).is_ignore());
+}
