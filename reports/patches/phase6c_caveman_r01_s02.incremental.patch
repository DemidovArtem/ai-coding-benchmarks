index 0000000000000000000000000000000000000000..be64aad9617a21231b35fe12fc4c65909db2c50e
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,135 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(pattern: &str, matches: &[&str], misses: &[&str]) {
+    let glob = GlobBuilder::new(pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &(paths, expected) in &[(matches, true), (misses, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{pattern}: {path}");
+            assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+        }
+    }
+}
+
+#[test]
+fn strict_by_default_and_when_disabled() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        let error = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .allow_unclosed_class(false)
+            .build()
+            .unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnclosedClass, "{pattern}");
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^", "[^]", "[z-a", "[z--",
+        "prefix[abc", "[☃",
+    ] {
+        assert_matches(pattern, &[pattern], &["", "abc", "a", "z", "☃"]);
+    }
+}
+
+#[test]
+fn unclosed_tail_is_literal_including_metacharacters() {
+    assert_matches(
+        "[abc*?{x,y}\\",
+        &["[abc*?{x,y}\\"],
+        &["[abcfooax", "[abc*?x\\", "[abc*?{x,y}"],
+    );
+    assert_matches(
+        "*/[abc?*",
+        &["src/[abc?*", "other/[abc?*"],
+        &["src/[abcd", "src/[abc", "[abc?*"],
+    );
+}
+
+#[test]
+fn alternation_branches_fall_back_independently() {
+    assert_matches("{[abc,xyz}", &["[abc", "xyz"], &["a", "[abc,xyz"]);
+    assert_matches("{[abc,[xyz}", &["[abc", "[xyz"], &["abc", "xyz"]);
+    assert_matches(
+        "{[abc],[xyz}",
+        &["a", "b", "c", "[xyz"],
+        &["[abc]", "xyz", "x"],
+    );
+    assert_matches(
+        "{{[abc,x},[xyz}tail",
+        &["[abctail", "xtail", "[xyztail"],
+        &["atail", "[abc", "[xyz"],
+    );
+    assert_matches(
+        "{[a?*,xyz*}",
+        &["[a?*", "xyz", "xyzabc"],
+        &["[abc", "[a", "xy"],
+    );
+}
+
+#[test]
+fn closed_classes_keep_existing_syntax() {
+    for pattern in [
+        "[abc]", "[!abc]", "[^abc]", "[]]", "[!]]", "[[]", "[a-z]",
+        "{[}],foo}", "{[a,b],c}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        let strict = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), strict.regex(), "{pattern}");
+    }
+    assert_matches("[abc]*[xyz", &["abc[xyz", "c[xyz"], &["d[xyz", "a[xy"]);
+    for allow in [false, true] {
+        assert_eq!(
+            GlobBuilder::new("[z-a]")
+                .allow_unclosed_class(allow)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::InvalidRange('z', 'a'),
+        );
+    }
+}
+
+#[test]
+fn combines_with_other_builder_options() {
+    let glob = GlobBuilder::new("src/*/[ABC?")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap()
+        .compile_matcher();
+    assert!(glob.is_match("SRC/lib/[abc?"));
+    assert!(!glob.is_match("src/a/b/[abc?"));
+    assert!(!glob.is_match("src/lib/[abcd"));
+}
+
+#[test]
+fn many_opening_brackets_and_branches() {
+    let brackets = "[".repeat(100_000);
+    let glob = GlobBuilder::new(&brackets)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    assert_eq!(glob.glob(), brackets);
+
+    let branches = format!("{{{}}}", vec!["[abc"; 10_000].join(","));
+    assert!(GlobBuilder::new(&branches)
+        .allow_unclosed_class(true)
+        .build()
+        .is_ok());
+}
