+rgtest!(r3127_gitignore_allow_unclosed_class, |dir: Dir, mut cmd: TestCommand| {
+    dir.create_dir(".git");
+    dir.create(".gitignore", "[\n[abc\n[]\n[][\n[!\n[!]\n");
+    for name in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        dir.create(name, "");
+    }
+    dir.create_dir("nested");
+    dir.create("nested/[abc", "");
+    dir.create("nested/visible", "");
+    dir.create("visible", "");
+    let got = cmd.args(&["--files", "--sort", "path"]).stdout();
+    eqnice!("nested/visible\nvisible\n", got);
+});
+
+rgtest!(r3127_glob_unclosed_class_errors, |dir: Dir, _: TestCommand| {
+    dir.create("[abc", "");
+    for flag in ["-g", "--glob", "--iglob"] {
+        let mut cmd = dir.command();
+        cmd.args(&["--files", flag, "[abc"]).assert_err();
+        let output = cmd.raw_output();
