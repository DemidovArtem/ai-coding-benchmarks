+    #[test]
+    fn explicit_ignore_current_dir() {
+        let td = tmpdir();
+        let cwd = td.path().join("work");
+        let sibling = td.path().join("work-other");
+        mkdirp(cwd.join("nested"));
+        mkdirp(&sibling);
+        let igpath = td.path().join("patterns");
+        wfile(&igpath, "/haystack\n-other/haystack\n");
+        wfile(cwd.join("haystack"), "");
+        wfile(cwd.join("visible"), "");
+        wfile(cwd.join("nested/haystack"), "");
+        wfile(sibling.join("haystack"), "");
+
+        let mut builder = WalkBuilder::new(&cwd);
+        builder.standard_filters(false);
+        assert!(builder.add_ignore(&igpath).is_none());
+        // The context can be set after adding rules, and is shared by clones.
+        builder.current_dir(&cwd);
+        assert_paths(
+            &cwd,
+            &builder.clone(),
+            &["visible", "nested", "nested/haystack"],
+        );
+        // Anchors remain relative to the CWD, not each individual search root.
+        let mut nested = WalkBuilder::new(cwd.join("nested"));
+        nested.standard_filters(false).current_dir(&cwd);
+        assert!(nested.add_ignore(&igpath).is_none());
+        assert_paths(&cwd.join("nested"), &nested, &["haystack"]);
+
+        let mut outside = WalkBuilder::new(&sibling);
+        outside.standard_filters(false).current_dir(&cwd);
+        assert!(outside.add_ignore(&igpath).is_none());
+        assert_paths(&sibling, &outside, &["haystack"]);
+        // Updating context rebases existing rules without rebuilding them.
+        outside.current_dir(&sibling);
+        assert_paths(&sibling, &outside, &[]);
+    }
+
