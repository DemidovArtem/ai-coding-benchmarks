+    struct ShortReads<'a> {
+        bytes: &'a [u8],
+        calls: usize,
+    }
+
+    impl io::Read for ShortReads<'_> {
+        fn read(&mut self, dst: &mut [u8]) -> io::Result<usize> {
+            self.calls += 1;
+            let len = dst.len().min(self.bytes.len()).min(2);
+            dst[..len].copy_from_slice(&self.bytes[..len]);
