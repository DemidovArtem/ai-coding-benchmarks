+    #[test]
+    fn global_ignore_current_dir() {
+        let td = tmpdir();
+        let root = td.path().join("a/b/c");
+        let ignore = td.path().join(".globalignore");
+        mkdirp(root.join("deeper"));
+        wfile(&ignore, "/haystack\n*.log\n");
+        wfile(root.join("haystack"), "");
+        wfile(root.join("visible"), "");
+        wfile(root.join("debug.log"), "");
+        wfile(root.join("deeper/haystack"), "");
+
+        for set_context_first in [false, true] {
+            let mut builder = WalkBuilder::new(&root);
+            builder.git_global(false);
+            if set_context_first {
+                builder.current_dir(&root);
+            }
+            assert!(builder.add_ignore(&ignore).is_none());
+            if !set_context_first {
+                builder.current_dir(&root);
+            }
+            assert_paths(
+                &root,
+                &builder,
+                &["deeper", "deeper/haystack", "visible"],
+            );
+            builder.current_dir(td.path());
+            assert_paths(
+                &root,
+                &builder,
+                &["deeper", "deeper/haystack", "haystack", "visible"],
+            );
+        }
+    }
+
+    #[test]
+    #[cfg(unix)]
+    fn global_ignore_deleted_current_dir() {
+        const CHILD_ROOT: &str = "IGNORE_TEST_DELETED_CURRENT_DIR_ROOT";
+        if let Some(root) = std::env::var_os(CHILD_ROOT) {
+            let root = std::path::PathBuf::from(root);
+            std::env::set_current_dir(&root).unwrap();
+            let (global, err) = crate::gitignore::Gitignore::global();
+            assert!(err.is_none());
+            assert!(global.matched(root.join("haystack"), false).is_ignore());
+            let captured = WalkBuilder::new(&root);
+
+            let vanished = root.join("vanished");
+            std::env::set_current_dir(&vanished).unwrap();
+            fs::remove_dir(&vanished).unwrap();
+            assert!(std::env::current_dir().is_err());
+            assert_paths(&root, &captured, &["visible"]);
+
+            let (global, err) = crate::gitignore::Gitignore::global();
+            assert!(err.is_none());
+            assert!(global.is_empty());
+            let mut builder = WalkBuilder::new(&root);
+            assert!(builder.add_ignore(root.join(".globalignore")).is_none());
+            assert_paths(&root, &builder, &["haystack", "visible"]);
+            builder.current_dir(&root);
+            assert_paths(&root, &builder, &["visible"]);
+            return;
+        }
+
+        // Run in a subprocess so removing the working directory cannot
+        // interfere with other tests running on this process's threads.
+        let td = tmpdir();
+        mkdirp(td.path().join(".git"));
+        mkdirp(td.path().join(".home"));
+        mkdirp(td.path().join("vanished"));
+        wfile(td.path().join("haystack"), "");
+        wfile(td.path().join("visible"), "");
+        wfile(td.path().join(".globalignore"), "/haystack\n");
+        wfile(
+            td.path().join(".home/.gitconfig"),
+            &format!(
+                "[core]\nexcludesFile = {}\n",
+                td.path().join(".globalignore").display()
+            ),
+        );
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "walk::tests::global_ignore_deleted_current_dir",
+                "--nocapture",
+            ])
+            .env(CHILD_ROOT, td.path())
+            .env("HOME", td.path().join(".home"))
+            .env("XDG_CONFIG_HOME", td.path().join(".home"))
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{output:?}");
+    }
