+rgtest!(global_ignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    dir.create_dir(".home");
+    dir.create_dir("a/.git");
+    dir.create_dir("a/b/c/deeper");
+    dir.create(".globalignore", "/haystack\n");
+    dir.create("a/b/c/haystack", "test\n");
+    dir.create("a/b/c/visible", "test\n");
+    dir.create("a/b/c/deeper/haystack", "test\n");
+    let ignore = dir.path().join(".globalignore");
+    dir.create(
+        ".home/.gitconfig",
+        &format!("[core]\nexcludesFile = {}\n", ignore.display()),
+    );
+    let cwd = dir.path().join("a/b/c");
+    for global_config in [false, true] {
+        for absolute in [false, true] {
+            for threads in ["1", "4"] {
+                let mut cmd = dir.command();
+                cmd.current_dir(&cwd);
+                cmd.cmd().env("HOME", dir.path().join(".home"));
+                cmd.cmd().env("USERPROFILE", dir.path().join(".home"));
+                cmd.cmd().env("XDG_CONFIG_HOME", dir.path().join(".home"));
+                cmd.args(&["--files", "--threads", threads]);
+                if !global_config {
+                    cmd.arg("--no-ignore-global");
+                    cmd.arg("--ignore-file").arg(&ignore);
+                }
+                if absolute {
+                    cmd.arg(&cwd);
+                } else {
+                    cmd.arg(".");
+                }
+                let stdout = cmd.stdout();
+                let prefix = if absolute {
+                    format!("{}/", cwd.display()).replace('\\', "/")
+                } else {
+                    "./".to_string()
+                };
+                let mut relative: Vec<_> = stdout
+                    .lines()
+                    .map(|line| line.strip_prefix(&prefix).unwrap())
+                    .collect();
+                relative.sort();
+                assert_eq!(relative, vec!["deeper/haystack", "visible"]);
+            }
+        }
+    }
+});
