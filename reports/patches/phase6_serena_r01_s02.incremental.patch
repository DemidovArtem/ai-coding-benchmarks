+// See: https://github.com/BurntSushi/ripgrep/issues/3127
+rgtest!(
+    r3127_gitignore_allow_unclosed_class,
+    |dir: Dir, mut cmd: TestCommand| {
+        dir.create_dir(".git");
+        dir.create(".gitignore", "[\n[abc\n[]\n[][\n[!\n[!]\n");
+        for path in &["[", "[abc", "[]", "[][", "[!", "[!]", "keep"] {
+            dir.create(path, "test");
+        }
+        eqnice!("keep\n", cmd.arg("--files").stdout());
+    }
+);
+
+rgtest!(r3127_override_rejects_unclosed_class, |_: Dir, mut cmd: TestCommand| {
+    cmd.args(&["--files", "-g", "[abc"]);
+    let output = cmd.raw_output();
+    assert_eq!(output.status.code(), Some(2));
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(stderr.contains("unclosed character class"));
+});
