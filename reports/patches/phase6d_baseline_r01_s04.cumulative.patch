diff --git a/crates/globset/tests/alternates.rs b/crates/globset/tests/alternates.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ae5a208cd36b11405a4df646a9760c038e49c0a5
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,164 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn alternation_regex_preserves_scope_and_order() {
+    let cases = [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("x{a,{b,c}}y{d,e}", "x(?:a|(?:b|c))y(?:d|e)"),
+        ("{a,b},c", "(?:a|b),c"),
+        ("a,b", "a,b"),
+    ];
+    for (pattern, regex) in cases {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{regex}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn malformed_alternation_reports_unmatched_brace() {
+    let cases = [
+        ("{", ErrorKind::UnclosedAlternates),
+        ("{a,b", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c}", ErrorKind::UnclosedAlternates),
+        ("{{a,b},{c,d}", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c", ErrorKind::UnclosedAlternates),
+        ("}", ErrorKind::UnopenedAlternates),
+        ("a,b}", ErrorKind::UnopenedAlternates),
+        ("{a,b}}", ErrorKind::UnopenedAlternates),
+        ("{a,{b,c}}}", ErrorKind::UnopenedAlternates),
+        ("}{a,b}", ErrorKind::UnopenedAlternates),
+    ];
+    for (pattern, kind) in cases {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &kind, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+}
+
+fn assert_matches(builder: &GlobBuilder<'_>, yes: &[&str], no: &[&str]) {
+    let glob = builder.build().unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for &(paths, expected) in &[(yes, true), (no, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{path}");
+            assert_eq!(set.is_match(path), expected, "{path}");
+        }
+    }
+}
+
+#[test]
+fn nested_alternation_matches_complete_branches() {
+    assert_matches(
+        &GlobBuilder::new("{a,{b,c}}"),
+        &["a", "b", "c"],
+        &["", "ab", "d"],
+    );
+    assert_matches(
+        &GlobBuilder::new("{{a,b},{c,d}}"),
+        &["a", "b", "c", "d"],
+        &["", "ac", "e"],
+    );
+    assert_matches(
+        &GlobBuilder::new("{a,b{c,d}}"),
+        &["a", "bc", "bd"],
+        &["", "b", "be", "abc", "bcd"],
+    );
+    assert_matches(
+        &GlobBuilder::new("x{a,{b,c}}{d,e}y"),
+        &["xady", "xaey", "xbdy", "xbey", "xcdy", "xcey"],
+        &["xay", "xby", "xcy", "xadey", "xad"],
+    );
+    assert_matches(
+        &GlobBuilder::new("{a,{b,c}},d"),
+        &["a,d", "b,d", "c,d"],
+        &["a", "b", "c", "d"],
+    );
+}
+
+#[test]
+fn nested_alternation_combines_with_glob_features() {
+    assert_matches(
+        GlobBuilder::new("src/{lib{a,b},test[0-9]}/**/*.{rs,{toml,txt}}")
+            .literal_separator(true)
+            .case_insensitive(true),
+        &["src/liba/main.rs", "SRC/LIBB/sub/Cargo.TOML", "src/test3/a/b.txt"],
+        &["src/libc/main.rs", "src/testx/a.txt", "src/liba/main.js"],
+    );
+    assert_matches(
+        GlobBuilder::new(
+            "**/{node_modules/**/*.{ts,js},crates/**/*.{rs,toml}}",
+        )
+        .literal_separator(true),
+        &[
+            "node_modules/pkg/index.ts",
+            "app/node_modules/pkg/src/index.js",
+            "crates/core/src/lib.rs",
+            "project/crates/core/Cargo.toml",
+        ],
+        &["node_modules/pkg/lib.rs", "crates/core/index.js", "src/lib.rs"],
+    );
+    assert_matches(
+        &GlobBuilder::new(
+            "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+        ),
+        &[
+            "node_modules/pkg/ts",
+            "app/node_modules/pkg/src/js",
+            "crates/a.rs",
+        ],
+        &["node_modules/pkg/rs", "crates/a.js"],
+    );
+}
+
+#[test]
+fn nested_alternation_preserves_empty_branch_options() {
+    for empty in [false, true] {
+        let mut builder = GlobBuilder::new("{a,{,b}}{c,}");
+        builder.empty_alternates(empty);
+        if empty {
+            assert_matches(&builder, &["", "a", "b", "c", "ac", "bc"], &["ab"]);
+        } else {
+            assert_matches(&builder, &["ac", "bc"], &["", "a", "b", "c"]);
+        }
+    }
+    assert_matches(&GlobBuilder::new("{{},a}"), &["a"], &[""]);
+    assert_matches(
+        GlobBuilder::new("{{},a}").empty_alternates(true),
+        &["", "a"],
+        &["b"],
+    );
+    assert_matches(&GlobBuilder::new("{{}}"), &[""], &["a"]);
+}
+
+#[test]
+fn escaped_braces_and_commas_keep_their_literal_meaning() {
+    assert_matches(
+        GlobBuilder::new(r"{a,{b\,c,\{d\}}}").backslash_escape(true),
+        &["a", "b,c", "{d}"],
+        &["b", "c", "d"],
+    );
+    assert_matches(
+        &GlobBuilder::new("{a,{[{}],c}}"),
+        &["a", "{", "}", "c"],
+        &["b", "{}"],
+    );
+}
+
+#[test]
+fn deeply_nested_alternation() {
+    let mut pattern = "z".to_string();
+    for _ in 0..64 {
+        pattern = format!("{{a,{pattern}}}");
+    }
+    assert_matches(&GlobBuilder::new(&pattern), &["a", "z"], &["", "az"]);
+    pattern.pop();
+    assert_eq!(
+        Glob::new(&pattern).unwrap_err().kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
