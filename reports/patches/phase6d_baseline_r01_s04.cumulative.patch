+fn check_global_ignore_absolute_paths(dir: &Dir, git_config: bool) {
+    use std::path::Path;
+
+    dir.create_dir(".git");
+    dir.create_dir("a/b/c/child");
+    dir.create_dir("home");
+    dir.create(".global-ignore", "/haystack\n*.log\n");
+    for path in ["haystack", "visible", "child/haystack", "child/debug.log"] {
+        dir.create(format!("a/b/c/{path}"), "test\n");
+    }
+    let cwd = dir.path().join("a/b/c").canonicalize().unwrap();
+    let ignore = dir.path().join(".global-ignore");
+    let config = format!(
+        "[core]\nexcludesFile = \"{}\"\n",
+        ignore.to_str().unwrap().replace('\\', "/"),
+    );
+    dir.create("home/.gitconfig", &config);
+    let child = cwd.join("child");
+    for root in [Path::new("."), &cwd, Path::new("child"), &child] {
+        let mut cmd = dir.command();
+        cmd.current_dir(&cwd).arg("--files").arg(root);
+        cmd.cmd()
+            .env("HOME", dir.path().join("home"))
+            .env("USERPROFILE", dir.path().join("home"))
+            .env("XDG_CONFIG_HOME", dir.path().join("home/.config"));
+        if !git_config {
+            cmd.arg("--no-ignore-global").arg("--ignore-file").arg(&ignore);
+        }
+        let output = cmd.stdout();
+        let mut paths: Vec<_> = output
+            .lines()
+            .map(|p| {
+                Path::new(p)
+                    .strip_prefix(root)
+                    .unwrap()
+                    .to_str()
+                    .unwrap()
+                    .replace('\\', "/")
+            })
+            .collect();
+        paths.sort();
+        if root == Path::new("child") || root == child {
+            assert_eq!(vec!["haystack"], paths);
+        } else {
+            assert_eq!(vec!["child/haystack", "visible"], paths);
+        }
+    }
+}
+
+rgtest!(global_gitignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    check_global_ignore_absolute_paths(&dir, true);
+});
+
+rgtest!(explicit_ignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    check_global_ignore_absolute_paths(&dir, false);
+});
