--- /dev/null
+++ b/crates/globset/src/glob/tests.rs
@@ -0,0 +1,280 @@
+use super::{Glob, GlobBuilder, Token, Tokens};
+use crate::{ErrorKind, GlobSetBuilder};
+
+fn check_matches(glob: Glob, paths: &[&str], expected: bool) {
+    let matcher = glob.compile_matcher();
+    let strategic = glob.compile_strategic_matcher();
+    let set = GlobSetBuilder::new().add(glob.clone()).build().unwrap();
+    for path in paths {
+        assert_eq!(matcher.is_match(path), expected, "{glob}: {path}");
+        assert_eq!(strategic.is_match(path), expected, "{glob}: {path}");
+        assert_eq!(set.is_match(path), expected, "{glob}: {path}");
+    }
+}
+
+#[test]
+fn nested_alternate_tokens() {
+    use Token::{Alternates, Literal};
+
+    let glob = Glob::new("{a,b{c,d},e}").unwrap();
+    assert_eq!(
+        glob.tokens,
+        Tokens(vec![Alternates(vec![
+            Tokens(vec![Literal('a')]),
+            Tokens(vec![
+                Literal('b'),
+                Alternates(vec![
+                    Tokens(vec![Literal('c')]),
+                    Tokens(vec![Literal('d')]),
+                ]),
+            ]),
+            Tokens(vec![Literal('e')]),
+        ])])
+    );
+}
+
+#[test]
+fn alternate_regex_order_and_scope() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?-u)^(?:a|b)$"),
+        ("{a,{b,c}}", "(?-u)^(?:a|(?:b|c))$"),
+        ("{{a,b},{c,d}}", "(?-u)^(?:(?:a|b)|(?:c|d))$"),
+        ("{a,b{c,d}}", "(?-u)^(?:a|b(?:c|d))$"),
+        ("{a,{b,{c,d}},e}", "(?-u)^(?:a|(?:b|(?:c|d))|e)$"),
+        ("{a,b}{c,{d,e}}", "(?-u)^(?:a|b)(?:c|(?:d|e))$"),
+        ("a,b,{c,{d,e}},f", "(?-u)^a,b,(?:c|(?:d|e)),f$"),
+    ] {
+        assert_eq!(Glob::new(pattern).unwrap().regex(), regex, "{pattern}");
+    }
+}
+
+#[test]
+fn malformed_alternates() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b}", "{a,{b,c"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnclosedAlternates, "{pattern}");
+        assert_eq!(error.glob(), Some(pattern));
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}", "{a,b},}"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnopenedAlternates, "{pattern}");
+        assert_eq!(error.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn nested_alternate_matches() {
+    for (pattern, yes, no) in [
+        ("{a,{b,c}}", vec!["a", "b", "c"], vec!["", "d", "ab"]),
+        ("{{a,b},{c,d}}", vec!["a", "b", "c", "d"], vec!["", "e", "ac"]),
+        ("{a,b{c,d}}", vec!["a", "bc", "bd"], vec!["b", "be", "c"]),
+        (
+            "{a,{b,{c,d}},e}",
+            vec!["a", "b", "c", "d", "e"],
+            vec!["", "f", "cd"],
+        ),
+        ("{a,b}{c,{d,e}}", vec!["ac", "ad", "be"], vec!["a", "bcd"]),
+        ("{a,b},c", vec!["a,c", "b,c"], vec!["a", "c", "a,b,c"]),
+        (
+            "prefix/{a,b{c,d}}.rs",
+            vec!["prefix/a.rs", "prefix/bc.rs", "prefix/bd.rs"],
+            vec!["prefix/b.rs", "prefix/be.rs", "prefix/a.toml"],
+        ),
+    ] {
+        let glob = Glob::new(pattern).unwrap();
+        check_matches(glob.clone(), &yes, true);
+        check_matches(glob, &no, false);
+    }
+}
+
+#[test]
+fn nested_alternates_with_glob_features() {
+    for literal_separator in [false, true] {
+        let glob = GlobBuilder::new(
+            "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+        )
+        .literal_separator(literal_separator)
+        .build()
+        .unwrap();
+        check_matches(
+            glob.clone(),
+            &[
+                "node_modules/pkg/lib/ts",
+                "project/node_modules/pkg/lib/js",
+                "crates/example/src/lib.rs",
+                "project/crates/example/Cargo.toml",
+            ],
+            true,
+        );
+        check_matches(
+            glob,
+            &["node_modules/pkg/lib/py", "crates/example/src/lib.js"],
+            false,
+        );
+    }
+    let glob = Glob::new("{src/{[ab]*.rs,lib?.{c,h}},README}").unwrap();
+    check_matches(
+        glob.clone(),
+        &["src/apple.rs", "src/lib1.c", "src/lib2.h", "README"],
+        true,
+    );
+    check_matches(glob, &["src/carrot.rs", "src/lib.c", "README.md"], false);
+}
+
+#[test]
+fn alternate_literal_braces_and_commas() {
+    let glob = GlobBuilder::new(r"{a,{b\,c,[{}]}}\{x\}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    check_matches(glob.clone(), &["a{x}", "b,c{x}", "{{x}", "}{x}"], true);
+    check_matches(glob, &["b{x}", "c{x}"], false);
+    check_matches(Glob::new("a,b").unwrap(), &["a,b"], true);
+}
+
+#[test]
+fn nested_empty_alternates() {
+    for empty_alternates in [false, true] {
+        let glob = GlobBuilder::new("{a,{,b}}")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &["a", "b"], true);
+        check_matches(glob, &[""], empty_alternates);
+        let glob = GlobBuilder::new("{{},a}")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &["a"], true);
+        check_matches(glob, &[""], empty_alternates);
+    }
+    check_matches(Glob::new("{{},}").unwrap(), &[""], true);
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    let pattern = format!("{}a{}", "{".repeat(64), "}".repeat(64));
+    let glob = Glob::new(&pattern).unwrap();
+    check_matches(glob.clone(), &["a"], true);
+    check_matches(glob, &["", "b"], false);
+}
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]", "[^]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn unclosed_classes_match_literal_text() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^]", "[z-a", "[☃*?\\",
+        "prefix[abc*?{x,y}",
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &[pattern], true);
+        check_matches(glob, &["", "a", "abc", "prefixa"], false);
+    }
+}
+
+#[test]
+fn unclosed_classes_in_alternates() {
+    for (pattern, yes, no) in [
+        ("{[abc,xyz}", vec!["[abc", "xyz"], vec!["a", "abc", "[xyz"]),
+        ("{[abc,[xyz}", vec!["[abc", "[xyz"], vec!["a", "abc", "xyz"]),
+        ("{[abc],[xyz}", vec!["a", "b", "c", "[xyz"], vec!["[abc]", "x"]),
+        (
+            "{a,{[abc,xyz},[def}",
+            vec!["a", "[abc", "xyz", "[def"],
+            vec!["b", "d", "def"],
+        ),
+        ("{[a*,b?}", vec!["[a*", "bx"], vec!["[abc", "b"]),
+    ] {
+        let glob = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+        check_matches(glob.clone(), &yes, true);
+        check_matches(glob, &no, false);
+    }
+    assert_eq!(
+        GlobBuilder::new("{[abc")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
+
+#[test]
+fn unclosed_class_option_preserves_closed_classes() {
+    for pattern in ["[z-a]", "[z--]"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap_err(),
+            error,
+        );
+    }
+    for (pattern, path) in [
+        ("[abc]", "a"),
+        ("[!abc]", "x"),
+        ("[]]", "]"),
+        ("{[}],foo}", "}"),
+        ("{[a,b],foo}", ","),
+    ] {
+        check_matches(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap(),
+            &[path],
+            true,
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    let glob = GlobBuilder::new("src/*[ABC?")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    check_matches(glob.clone(), &["src/name[abc?"], true);
+    check_matches(glob, &["src/sub/name[abc?", "src/name[abcx"], false);
+}
+
+#[test]
+fn many_unclosed_classes() {
+    // Both a long literal tail and many branches must avoid repeated scans.
+    for pattern in ["[".repeat(20_000), format!("{{{}}}", "[,".repeat(5_000))]
+    {
+        GlobBuilder::new(&pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap();
+    }
+}
