+    #[test]
+    fn min_depth_bounds() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b/c"));
+        for path in &["top", "a/mid", "a/b/inner", "a/b/c/deep"] {
+            wfile(td.path().join(path), "");
+        }
+        let all = &[
+            ("", 0),
+            ("a", 1),
+            ("top", 1),
+            ("a/b", 2),
+            ("a/mid", 2),
+            ("a/b/c", 3),
+            ("a/b/inner", 3),
+            ("a/b/c/deep", 4),
+        ];
+        let cases = [
+            (None, None, &all[..]),
+            (Some(0), None, &all[..]),
+            (Some(1), None, &all[1..]),
+            (Some(2), None, &all[3..]),
+            (Some(3), None, &all[5..]),
+            (Some(5), None, &all[0..0]),
+            (None, Some(0), &all[..1]),
+            (Some(0), Some(0), &all[..1]),
+            (Some(1), Some(2), &all[1..5]),
+            (Some(2), Some(2), &all[3..5]),
+            (Some(3), Some(1), &all[5..7]),
+            (Some(3), Some(0), &all[5..7]),
+            (Some(usize::MAX), Some(0), &all[0..0]),
+        ];
+        for (min, max, expected) in cases {
+            for threads in [1, 4] {
+                let mut builder = WalkBuilder::new(td.path());
+                builder.threads(threads).min_depth(min).max_depth(max);
+                assert_depth_paths(td.path(), &builder, expected);
+                let mut builder = WalkBuilder::new(td.path());
+                builder.threads(threads).max_depth(max).min_depth(min);
+                assert_depth_paths(td.path(), &builder, expected);
+            }
+        }
+    }
+
+    #[test]
+    fn min_depth_reset_keeps_configured_maximum() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b"));
+        wfile(td.path().join("a/b/file"), "");
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(2)).max_depth(Some(0));
+        assert_depth_paths(td.path(), &builder, &[("a/b", 2)]);
+        // Building must not change the stored bounds.
+        builder.min_depth(None);
+        assert_depth_paths(td.path(), &builder, &[("", 0)]);
+        builder.min_depth(Some(2));
+        assert_depth_paths(td.path(), &builder, &[("a/b", 2)]);
+        builder.max_depth(None);
+        assert_depth_paths(
+            td.path(),
+            &builder,
+            &[("a/b", 2), ("a/b/file", 3)],
+        );
+    }
+
+    #[test]
+    fn min_depth_preserves_shallow_ignore_rules() {
+        let td = tmpdir();
+        mkdirp(td.path().join("a/b"));
+        mkdirp(td.path().join("ignored/b"));
+        wfile(td.path().join(".ignore"), "ignored/\nroot-ignored\n");
+        wfile(td.path().join("a/.ignore"), "child-ignored\n");
+        for path in &[
+            "a/b/keep",
+            "a/b/root-ignored",
+            "a/b/child-ignored",
+            "ignored/b/keep",
+        ] {
+            wfile(td.path().join(path), "");
+        }
+        let mut builder = WalkBuilder::new(td.path());
+        builder.min_depth(Some(3));
+        assert_depth_paths(td.path(), &builder, &[("a/b/keep", 3)]);
+    }
+
