+        let describe = |dent: DirEntry| {
+            let relative = dent.path().strip_prefix(prefix).unwrap();
+            (normal_path(relative.to_str().unwrap()), dent.depth())
+        };
+        let mut expected: Vec<_> =
+            expected.iter().map(|&(p, d)| (p.to_string(), d)).collect();
+        expected.sort();
+        let mut serial: Vec<_> =
+            builder.build().map(|dent| describe(dent.unwrap())).collect();
+        serial.sort();
+        assert_eq!(serial, expected, "serial");
+
+        let parallel = Arc::new(Mutex::new(vec![]));
+        builder.build_parallel().run(|| {
+            let parallel = parallel.clone();
+            let describe = &describe;
+            Box::new(move |dent| {
+                parallel.lock().unwrap().push(describe(dent.unwrap()));
+                WalkState::Continue
+            })
+        });
+        let mut parallel = parallel.lock().unwrap();
+        parallel.sort();
