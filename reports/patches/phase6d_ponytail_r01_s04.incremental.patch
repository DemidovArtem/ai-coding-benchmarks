+rgtest!(global_ignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    dir.create_dir(".git");
+    dir.create_dir("a/b/c/nested");
+    dir.create("global-ignore", "/haystack\n");
+    dir.create(".gitconfig", "[core]\nexcludesFile = ~/global-ignore\n");
+    for name in ["haystack", "visible", "nested/haystack"] {
+        dir.create(format!("a/b/c/{name}"), "test\n");
+    }
+    let root = dir.path().join("a/b/c");
+    for explicit in [false, true] {
+        for threads in ["1", "2"] {
+            for path in [std::path::Path::new("."), root.as_path()] {
+                let mut cmd = dir.command();
+                cmd.current_dir(&root).args(&["--files", "-j", threads]);
+                cmd.cmd()
+                    .env("HOME", dir.path())
+                    .env("USERPROFILE", dir.path())
+                    .env("XDG_CONFIG_HOME", dir.path().join("config"));
+                if explicit {
+                    cmd.arg("--no-ignore-global")
+                        .arg("--ignore-file")
+                        .arg(dir.path().join("global-ignore"));
+                }
+                cmd.arg(path);
+                let expected = format!(
+                    "{}\n{}\n",
+                    path.join("nested/haystack").display(),
+                    path.join("visible").display(),
+                )
+                .replace('\\', "/");
+                eqnice!(sort_lines(&expected), sort_lines(&cmd.stdout()));
+            }
+        }
+    }
+});
