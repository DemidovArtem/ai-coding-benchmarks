new file mode 100644
index 0000000000000000000000000000000000000000..bc428a159a72bcb9dfa54b2eb950671e89b2a691
--- /dev/null
+++ b/crates/globset/tests/nested_alternates.rs
@@ -0,0 +1,180 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(glob: Glob, matches: &[&str], misses: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob.clone()).build().unwrap();
+    for &(paths, expected) in &[(matches, true), (misses, false)] {
+        for path in paths {
+            assert_eq!(
+                matcher.is_match(path),
+                expected,
+                "glob {:?}, path {:?}",
+                glob.glob(),
+                path,
+            );
+            assert_eq!(
+                set.is_match(path),
+                expected,
+                "glob set {:?}, path {:?}",
+                glob.glob(),
+                path,
+            );
+        }
+    }
+}
+
+#[test]
+fn regex_preserves_alternation_scope_and_order() {
+    for (pattern, expected) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("{a,{b,c}},d", "(?:a|(?:b|c)),d"),
+        ("{a,b}{c,{d,e}}", "(?:a|b)(?:c|(?:d|e))"),
+    ] {
+        assert_eq!(
+            Glob::new(pattern).unwrap().regex(),
+            format!("(?-u)^{}$", expected),
+            "pattern {:?}",
+            pattern,
+        );
+    }
+}
+
+#[test]
+fn nested_branches_match() {
+    assert_matches(
+        Glob::new("{a,{b,c}}").unwrap(),
+        &["a", "b", "c"],
+        &["", "d", "ab", "bc"],
+    );
+    assert_matches(
+        Glob::new("{{a,b},{c,d}}").unwrap(),
+        &["a", "b", "c", "d"],
+        &["", "e", "ac", "bd"],
+    );
+    assert_matches(
+        Glob::new("{a,b{c,d}}").unwrap(),
+        &["a", "bc", "bd"],
+        &["", "b", "be", "c", "d", "abc"],
+    );
+}
+
+#[test]
+fn nested_groups_keep_prefixes_suffixes_and_adjacent_groups() {
+    assert_matches(
+        Glob::new("x{a,b{c,d}}{e,{f,g}}y").unwrap(),
+        &["xaey", "xafy", "xagy", "xbcey", "xbcfy", "xbdgy"],
+        &["aey", "xa", "xaeyz", "xbey", "xbcy", "xacey"],
+    );
+}
+
+#[test]
+fn deep_nesting() {
+    let pattern = format!("{}a{}", "{x,".repeat(64), "}".repeat(64));
+    assert_matches(
+        Glob::new(&pattern).unwrap(),
+        &["a", "x"],
+        &["", "b", "xa"],
+    );
+}
+
+#[test]
+fn malformed_braces() {
+    for pattern in ["{", "{a,b", "{a,{b,c}", "{{a,b}", "{a,{b,c"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnclosedAlternates, "{pattern}");
+        assert_eq!(error.glob(), Some(pattern));
+    }
+    for pattern in ["}", "a,b}", "{a,b}}", "{a,{b,c}}}", "{{a,b},c}}"] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &ErrorKind::UnopenedAlternates, "{pattern}");
+        assert_eq!(error.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn commas_outside_groups_are_literal() {
+    assert_matches(
+        Glob::new("a,b").unwrap(),
+        &["a,b"],
+        &["a", "b", "ab"],
+    );
+    assert_matches(
+        Glob::new("{a,{b,c}},d").unwrap(),
+        &["a,d", "b,d", "c,d"],
+        &["a", "b", "c", "d", "ad"],
+    );
+}
+
+#[test]
+fn character_classes_and_wildcards() {
+    for literal_separator in [false, true] {
+        let glob = GlobBuilder::new("src/{a?,{b[0-9],c*}}.rs")
+            .literal_separator(literal_separator)
+            .build()
+            .unwrap();
+        assert_matches(
+            glob,
+            &["src/ab.rs", "src/b0.rs", "src/b9.rs", "src/c.rs", "src/cde.rs"],
+            &["src/a.rs", "src/bx.rs", "src/d.rs", "src/c.txt"],
+        );
+    }
+    assert_matches(
+        Glob::new("{[{],{[}],a}}").unwrap(),
+        &["{", "}", "a"],
+        &["", "b", "{}"],
+    );
+}
+
+#[test]
+fn escaped_delimiters_are_literal() {
+    let glob = GlobBuilder::new(r"{a,{b\,c,\{d\}}}")
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    assert_matches(glob, &["a", "b,c", "{d}"], &["b", "c", "d"]);
+}
+
+#[test]
+fn recursive_project_patterns() {
+    for literal_separator in [false, true] {
+        let glob = GlobBuilder::new(
+            "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+        )
+        .literal_separator(literal_separator)
+        .build()
+        .unwrap();
+        assert_matches(
+            glob,
+            &[
+                "node_modules/pkg/ts",
+                "app/node_modules/pkg/src/js",
+                "crates/lib.rs",
+                "project/crates/core/src/lib.rs",
+                "crates/core/Cargo.toml",
+            ],
+            &["crates/lib.js", "node_modules/pkg/rs", "other/lib.rs"],
+        );
+    }
+}
+
+#[test]
+fn nested_empty_branches_respect_options() {
+    for pattern in ["{a,{,b}}", "{a,{b,}}"] {
+        assert_matches(
+            Glob::new(pattern).unwrap(),
+            &["a", "b"],
+            &["", "ab"],
+        );
+        assert_matches(
+            GlobBuilder::new(pattern).empty_alternates(true).build().unwrap(),
+            &["", "a", "b"],
+            &["ab"],
+        );
+    }
+    assert_matches(Glob::new("{a,{}}").unwrap(), &["a"], &["", "b"]);
+    assert_matches(Glob::new("{{}}").unwrap(), &[""], &["a"]);
+}
