+/// A reader that returns short chunks even when the destination has more room.
+pub(crate) struct ChunkedReader<'a> {
+    bytes: &'a [u8],
+    chunk_size: usize,
+    pub(crate) reads: usize,
+}
+
+impl<'a> ChunkedReader<'a> {
+    pub(crate) fn new(
+        bytes: &'a [u8],
+        chunk_size: usize,
+    ) -> ChunkedReader<'a> {
+        assert!(chunk_size > 0);
+        ChunkedReader { bytes, chunk_size, reads: 0 }
+    }
+}
+
+impl io::Read for ChunkedReader<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.reads += 1;
+        let len = buf.len().min(self.chunk_size);
+        self.bytes.read(&mut buf[..len])
+    }
+}
