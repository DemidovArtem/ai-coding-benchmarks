index 0000000000000000000000000000000000000000..fa16d21f70de28a8fb2e436994600343865aa129
--- /dev/null
+++ b/crates/ignore/tests/unclosed_class.rs
@@ -0,0 +1,44 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        let matcher = GitignoreBuilder::new("")
+            .add_line(None, pattern)
+            .unwrap()
+            .build()
+            .unwrap();
+        assert!(matcher.matched(pattern, false).is_ignore(), "{pattern}");
+        assert!(
+            matcher.matched(format!("sub/{pattern}"), false).is_ignore(),
+            "{pattern}",
+        );
+        assert!(matcher.matched("other", false).is_none());
+    }
+}
+
+#[test]
+fn gitignore_toggle_only_affects_subsequent_globs() {
+    let mut builder = GitignoreBuilder::new("");
+    builder.add_line(None, "[abc").unwrap();
+    builder.allow_unclosed_class(false);
+    assert!(builder.add_line(None, "[def").is_err());
+    builder.allow_unclosed_class(true).add_line(None, "[ghi").unwrap();
+    let matcher = builder.build().unwrap();
+    assert!(matcher.matched("[abc", false).is_ignore());
+    assert!(matcher.matched("[def", false).is_none());
+    assert!(matcher.matched("[ghi", false).is_ignore());
+}
+
+#[test]
+fn overrides_are_strict_by_default_and_can_opt_in() {
+    let mut builder = OverrideBuilder::new("");
+    assert!(builder.add("[abc").is_err());
+    builder.allow_unclosed_class(true).add("[abc").unwrap();
+    builder.allow_unclosed_class(false);
+    assert!(builder.add("[def").is_err());
+    let matcher = builder.build().unwrap();
+    assert!(matcher.matched("[abc", false).is_whitelist());
+    assert!(matcher.matched("sub/[abc", false).is_whitelist());
+    assert!(matcher.matched("[def", false).is_ignore());
+}
