+// See: https://github.com/BurntSushi/ripgrep/issues/3127
+rgtest!(r3127_gitignore_allow_unclosed_class, |dir: Dir, mut cmd: TestCommand| {
+    dir.create_dir(".git");
+    dir.create(".gitignore", "[abc\n[]\n[][\n[!\n[!]\n");
+    for name in ["[abc", "[]", "[][", "[!", "[!]"] {
+        dir.create(name, "ignored");
+    }
+    dir.create("visible", "visible");
+    cmd.arg("--files");
+    let output = cmd.output();
+    eqnice!("visible\n", String::from_utf8_lossy(&output.stdout));
+    assert!(output.stderr.is_empty());
+});
+
+rgtest!(r3127_override_rejects_unclosed_class, |dir: Dir, _: TestCommand| {
+    dir.create("[abc", "contents");
+    for flag in ["-g", "--glob"] {
+        let output =
+            dir.command().args(&["--files", flag, "[abc"]).raw_output();
+        assert_eq!(output.status.code(), Some(2));
+        assert!(String::from_utf8_lossy(&output.stderr)
+            .contains("unclosed character class"));
+    }
+});
