index 0000000000000000000000000000000000000000..caf9c010f7bba5e82a6196655b2aa35a5db3eef7
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,132 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn regex_preserves_alternation_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("{a,b}{c,d}", "(?:a|b)(?:c|d)"),
+        ("{a,{b,c}},d", "(?:a|(?:b|c)),d"),
+        ("a,b", "a,b"),
+    ] {
+        assert_eq!(
+            Glob::new(pattern).unwrap().regex(),
+            format!("(?-u)^{regex}$"),
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn malformed_alternation_groups() {
+    for (pattern, kind) in [
+        ("{a,{b,c}", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c", ErrorKind::UnclosedAlternates),
+        ("{{a,b},{c,d}", ErrorKind::UnclosedAlternates),
+        ("a,b}", ErrorKind::UnopenedAlternates),
+        ("{a,b}}", ErrorKind::UnopenedAlternates),
+        ("{a,{b,c}}}", ErrorKind::UnopenedAlternates),
+        ("}", ErrorKind::UnopenedAlternates),
+    ] {
+        let error = Glob::new(pattern).unwrap_err();
+        assert_eq!(error.kind(), &kind, "{pattern}");
+        assert_eq!(error.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn nested_alternation_matching() {
+    for (pattern, paths) in [
+        ("{a,{b,c}}", vec![("a", true), ("b", true), ("c", true)]),
+        (
+            "{{a,b},{c,d}}",
+            vec![("a", true), ("b", true), ("c", true), ("d", true)],
+        ),
+        (
+            "{a,b{c,d}}",
+            vec![
+                ("a", true),
+                ("bc", true),
+                ("bd", true),
+                ("b", false),
+                ("be", false),
+            ],
+        ),
+        (
+            "{a,{b,c}}{d,e}",
+            vec![
+                ("ad", true),
+                ("be", true),
+                ("cd", true),
+                ("ae", true),
+                ("ab", false),
+            ],
+        ),
+        (
+            "**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}",
+            vec![
+                ("node_modules/pkg/ts", true),
+                ("web/node_modules/pkg/lib/js", true),
+                ("crates/globset/src/lib.rs", true),
+                ("project/crates/globset/Cargo.toml", true),
+                ("crates/globset/lib.js", false),
+            ],
+        ),
+        (
+            "{src/{*.rs,[ab]?.txt},README}",
+            vec![
+                ("src/lib.rs", true),
+                ("src/a1.txt", true),
+                ("README", true),
+                ("src/c1.txt", false),
+            ],
+        ),
+        ("{[{}],{a,b}}", vec![("{", true), ("}", true), ("b", true)]),
+    ] {
+        for literal_separator in [false, true] {
+            let glob = GlobBuilder::new(pattern)
+                .literal_separator(literal_separator)
+                .build()
+                .unwrap();
+            let matcher = glob.compile_matcher();
+            let set = GlobSetBuilder::new().add(glob).build().unwrap();
+            for &(path, expected) in &paths {
+                assert_eq!(
+                    matcher.is_match(path),
+                    expected,
+                    "{pattern}: {path}",
+                );
+                assert_eq!(set.is_match(path), expected, "{pattern}: {path}");
+            }
+        }
+    }
+}
+
+#[test]
+fn nested_empty_alternates() {
+    for empty_alternates in [false, true] {
+        let glob = GlobBuilder::new("{a,{b,}}")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        assert!(matcher.is_match("a"));
+        assert!(matcher.is_match("b"));
+        assert_eq!(matcher.is_match(""), empty_alternates);
+    }
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    let mut pattern = "b".to_string();
+    for _ in 0..32 {
+        pattern = format!("{{a,{pattern}}}");
+    }
+    let matcher = Glob::new(&pattern).unwrap().compile_matcher();
+    assert!(matcher.is_match("a"));
+    assert!(matcher.is_match("b"));
+    assert!(!matcher.is_match("c"));
+}
