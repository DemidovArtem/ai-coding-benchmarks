+// See: https://github.com/BurntSushi/ripgrep/issues/3127
+rgtest!(
+    r3127_gitignore_allow_unclosed_class,
+    |dir: Dir, mut cmd: TestCommand| {
+        dir.create_dir(".git");
+        let names = ["[", "[abc", "[]", "[][", "[!", "[!]"];
+        dir.create(".gitignore", &names.join("\n"));
+        for name in names {
+            dir.create(name, "ignored");
+        }
+        dir.create("visible", "kept");
+        eqnice!("visible\n", cmd.arg("--files").stdout());
+    }
+);
+
+rgtest!(r3127_override_unclosed_class_error, |dir: Dir, _cmd: TestCommand| {
+    dir.create("[abc", "contents");
+    for flag in ["-g", "--glob"] {
+        let output =
+            dir.command().args(&["--files", flag, "[abc"]).raw_output();
+        assert_eq!(output.status.code(), Some(2));
+        assert!(String::from_utf8_lossy(&output.stderr)
+            .contains("unclosed character class"));
+    }
+});
