+            (Some(2), 0, false, "0:a\n4:a\n"),
+            (Some(1), 1, false, "0:a\n2-x\n"),
+            (Some(1), 2, false, "0:a\n2-x\n4:a\n6-x\n8:a\n10-z\n12-q\n"),
+            (Some(1), 0, true, "2:x\n"),
+            (Some(2), 1, true, "2:x\n4-a\n6:x\n8-a\n"),
+        ] {
+            for multiline in [false, true] {
