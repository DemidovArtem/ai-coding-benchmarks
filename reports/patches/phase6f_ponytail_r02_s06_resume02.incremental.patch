+                    let mut searcher = SearcherBuilder::new()
+                        .max_matches(limit)
+                        .after_context(after)
+                        .invert_match(invert)
+                        .multi_line(multiline)
+                        .line_number(false)
+                        .build();
+                    assert_eq!(searcher.max_matches(), limit);
+                    for reader in [false, true] {
+                        let mut sink = KitchenSink::new();
+                        if reader {
+                            searcher
+                                .search_reader(
