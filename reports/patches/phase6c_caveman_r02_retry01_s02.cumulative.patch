index 0000000000000000000000000000000000000000..cd83b90e49a23e03948bbec485f3352701ad3f97
--- /dev/null
+++ b/crates/globset/tests/alternates.rs
@@ -0,0 +1,196 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(glob: Glob, matches: &[&str], non_matches: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for path in matches {
+        assert!(matcher.is_match(path), "matcher should match {path:?}");
+        assert!(set.is_match(path), "set should match {path:?}");
+    }
+    for path in non_matches {
+        assert!(!matcher.is_match(path), "matcher should reject {path:?}");
+        assert!(!set.is_match(path), "set should reject {path:?}");
+    }
+}
+
+#[test]
+fn regex_preserves_alternate_scope_and_order() {
+    for (pattern, regex) in [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("x{a,{b,c}d,e}y", "x(?:a|(?:b|c)d|e)y"),
+        ("{a,b}{c,d}", "(?:a|b)(?:c|d)"),
+        ("{{{a,b},c},d}", "(?:(?:(?:a|b)|c)|d)"),
+        ("{a,{b,c}},d", "(?:a|(?:b|c)),d"),
+    ] {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{regex}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn malformed_alternates() {
+    for (pattern, kind) in [
+        ("{", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c}", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c", ErrorKind::UnclosedAlternates),
+        ("{{a,b},{c,d}", ErrorKind::UnclosedAlternates),
+        ("{a,b},{{c,d}", ErrorKind::UnclosedAlternates),
+        ("}", ErrorKind::UnopenedAlternates),
+        ("a,b}", ErrorKind::UnopenedAlternates),
+        ("{a,b}}", ErrorKind::UnopenedAlternates),
+        ("{a,{b,c}}}", ErrorKind::UnopenedAlternates),
+        ("}{a,b}", ErrorKind::UnopenedAlternates),
+    ] {
+        let err = Glob::new(pattern).unwrap_err();
+        assert_eq!(err.kind(), &kind, "{pattern}");
+        assert_eq!(err.glob(), Some(pattern));
+    }
+}
+
+#[test]
+fn nested_alternates_match() {
+    for (pattern, matches, non_matches) in [
+        ("{a,{b,c}}", &["a", "b", "c"][..], &["d"][..]),
+        ("{{a,b},{c,d}}", &["a", "b", "c", "d"][..], &["e"][..]),
+    ] {
+        assert_matches(Glob::new(pattern).unwrap(), matches, non_matches);
+    }
+    assert_matches(
+        Glob::new("{a,b{c,d}}").unwrap(),
+        &["a", "bc", "bd"],
+        &["", "b", "be", "c", "abc"],
+    );
+    assert_matches(
+        Glob::new("x{a,{b,c}d,e}y").unwrap(),
+        &["xay", "xbdy", "xcdy", "xey"],
+        &["xby", "xcy", "xady", "xy", "xbdey"],
+    );
+    assert_matches(
+        Glob::new("{a,{b,c}}{d,{e,f}}").unwrap(),
+        &["ad", "ae", "af", "bd", "be", "bf", "cd", "ce", "cf"],
+        &["a", "d", "ab", "de", "ade"],
+    );
+}
+
+#[test]
+fn nested_alternates_with_glob_features() {
+    assert_matches(
+        Glob::new("**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}")
+            .unwrap(),
+        &[
+            "node_modules/pkg/ts",
+            "app/node_modules/pkg/src/js",
+            "crates/globset/src/glob.rs",
+            "crates/globset/Cargo.toml",
+        ],
+        &["node_modules/pkg/rs", "crates/globset/lib.js"],
+    );
+    let glob = GlobBuilder::new(
+        "**/{node_modules/**/*.{ts,js},crates/**/*.{rs,toml}}",
+    )
+    .literal_separator(true)
+    .build()
+    .unwrap();
+    assert_matches(
+        glob,
+        &[
+            "node_modules/index.ts",
+            "app/node_modules/pkg/src/index.js",
+            "crates/lib.rs",
+            "project/crates/globset/src/glob.rs",
+            "project/crates/globset/Cargo.toml",
+        ],
+        &[
+            "node_modules/index.rs",
+            "crates/index.js",
+            "src/index.ts",
+            "project/crates/globset/Cargo.toml.bak",
+        ],
+    );
+    assert_matches(
+        GlobBuilder::new("{src/{[a-c]?,lib*},test/{unit,integration}}.rs")
+            .literal_separator(true)
+            .case_insensitive(true)
+            .build()
+            .unwrap(),
+        &[
+            "src/a1.rs",
+            "src/LIBRARY.RS",
+            "test/unit.rs",
+            "test/integration.rs",
+        ],
+        &["src/d1.rs", "src/a/b.rs", "src/lib/a.rs", "test/other.rs"],
+    );
+}
+
+#[test]
+fn literal_alternation_metacharacters() {
+    assert_matches(Glob::new("a,b").unwrap(), &["a,b"], &["a", "b"]);
+    assert_matches(
+        Glob::new("{a,{b,c}},d").unwrap(),
+        &["a,d", "b,d", "c,d"],
+        &["a", "b", "c", "d", "a,b,d"],
+    );
+    assert_matches(
+        Glob::new("{a,{[{}],b[,]c}}").unwrap(),
+        &["a", "{", "}", "b,c"],
+        &["b", "c", "{}"],
+    );
+    assert_matches(
+        GlobBuilder::new(r"{a,{\{b\,c\},d}}")
+            .backslash_escape(true)
+            .build()
+            .unwrap(),
+        &["a", "{b,c}", "d"],
+        &["b", "c", "{b", "c}"],
+    );
+}
+
+#[test]
+fn empty_alternates_keep_existing_semantics() {
+    for (pattern, matches, non_matches) in [
+        ("{,a}", &["a"][..], &[""][..]),
+        ("{}", &[""][..], &["a"][..]),
+        ("{,}", &[""][..], &["a"][..]),
+        ("x{,{,a}}y", &["xay"][..], &["xy"][..]),
+        ("x{{},a}y", &["xay"][..], &["xy"][..]),
+    ] {
+        assert_matches(Glob::new(pattern).unwrap(), matches, non_matches);
+    }
+    assert_matches(
+        GlobBuilder::new("x{,{,a}}y")
+            .empty_alternates(true)
+            .build()
+            .unwrap(),
+        &["xy", "xay"],
+        &["xaay", "x"],
+    );
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    let depth = 128;
+    let pattern = format!("{}a{}", "{b,".repeat(depth), "}".repeat(depth));
+    let regex =
+        format!("(?-u)^{}a{}$", "(?:b|".repeat(depth), ")".repeat(depth));
+    let glob = Glob::new(&pattern).unwrap();
+    assert_eq!(glob.regex(), regex);
+    assert_matches(glob, &["a", "b"], &["", "ab", "c"]);
+}
+
+#[test]
+fn sets_report_nested_patterns() {
+    let mut builder = GlobSetBuilder::new();
+    builder.add(Glob::new("{a,b{c,d}}").unwrap());
+    builder.add(Glob::new("{{a,b},{c,d}}").unwrap());
+    builder.add(Glob::new("b*").unwrap());
+    let set = builder.build().unwrap();
+    assert_eq!(set.matches("a"), vec![0, 1]);
+    assert_eq!(set.matches("bc"), vec![0, 2]);
+    assert_eq!(set.matches("b"), vec![1, 2]);
+    assert_eq!(set.matches("d"), vec![1]);
+    assert!(set.matches("e").is_empty());
+}
