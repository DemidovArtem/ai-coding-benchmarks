diff --git a/crates/ignore/tests/unclosed_class.rs b/crates/ignore/tests/unclosed_class.rs
new file mode 100644
index 0000000000000000000000000000000000000000..cf6b8278a310a47a334ca7ea9f322f486a2167fe
--- /dev/null
+++ b/crates/ignore/tests/unclosed_class.rs
@@ -0,0 +1,60 @@
+use ignore::{gitignore::GitignoreBuilder, overrides::OverrideBuilder};
+
+#[test]
+fn gitignore_allows_unclosed_classes_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        let gitignore = GitignoreBuilder::new(".")
+            .add_line(None, pattern)
+            .unwrap()
+            .build()
+            .unwrap();
+        assert!(gitignore.matched(pattern, false).is_ignore());
+        assert!(gitignore
+            .matched(format!("sub/{pattern}"), false)
+            .is_ignore());
+        assert!(gitignore.matched("other", false).is_none());
+    }
+}
+
+#[test]
+fn gitignore_toggle_only_affects_subsequent_patterns() {
+    let mut builder = GitignoreBuilder::new(".");
+    builder.add_line(None, "[abc").unwrap();
+    assert!(builder
+        .allow_unclosed_class(false)
+        .add_line(None, "[def")
+        .is_err());
+    builder
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .unwrap()
+        .add_line(None, "[GHI")
+        .unwrap();
+    let gitignore = builder.build().unwrap();
+    assert!(gitignore.matched("[abc", false).is_ignore());
+    assert!(gitignore.matched("[ghi", false).is_ignore());
+    assert!(gitignore.matched("[def", false).is_none());
+}
+
+#[test]
+fn overrides_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        let err = OverrideBuilder::new(".").add(pattern).unwrap_err();
+        assert!(err.to_string().contains("unclosed character class"));
+    }
+}
+
+#[test]
+fn overrides_can_allow_unclosed_classes() {
+    let mut builder = OverrideBuilder::new(".");
+    builder
+        .allow_unclosed_class(true)
+        .add("[abc")
+        .unwrap()
+        .add("![def")
+        .unwrap();
+    assert!(builder.allow_unclosed_class(false).add("[ghi").is_err());
+    let overrides = builder.build().unwrap();
+    assert!(overrides.matched("[abc", false).is_whitelist());
+    assert!(overrides.matched("[def", false).is_ignore());
+}
