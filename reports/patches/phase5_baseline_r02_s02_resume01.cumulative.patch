index 0000000000000000000000000000000000000000..f87bf68235a3bc3155a4614b0c0fbacbb6753bbc
--- /dev/null
+++ b/crates/globset/tests/nested_alternates.rs
@@ -0,0 +1,146 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+#[test]
+fn regex_preserves_alternation_scope_and_order() {
+    let cases = [
+        ("{a,b}", "(?:a|b)"),
+        ("{a,{b,c}}", "(?:a|(?:b|c))"),
+        ("{{a,b},{c,d}}", "(?:(?:a|b)|(?:c|d))"),
+        ("{a,b{c,d}}", "(?:a|b(?:c|d))"),
+        ("{a,{b,{c,d}},e}", "(?:a|(?:b|(?:c|d))|e)"),
+        ("x{a,{b,c}}y{d,e}", "x(?:a|(?:b|c))y(?:d|e)"),
+        ("{a,{b,c}d,e}", "(?:a|(?:b|c)d|e)"),
+        ("{a,b},c", "(?:a|b),c"),
+    ];
+    for (pattern, regex) in cases {
+        let glob = Glob::new(pattern).unwrap();
+        assert_eq!(glob.regex(), format!("(?-u)^{regex}$"), "{pattern}");
+    }
+}
+
+#[test]
+fn unmatched_braces_are_errors() {
+    let cases = [
+        ("{", ErrorKind::UnclosedAlternates),
+        ("{a,b", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c}", ErrorKind::UnclosedAlternates),
+        ("{a,{b,c", ErrorKind::UnclosedAlternates),
+        ("{{a,b},c", ErrorKind::UnclosedAlternates),
+        ("}", ErrorKind::UnopenedAlternates),
+        ("a,b}", ErrorKind::UnopenedAlternates),
+        ("{a,b}}", ErrorKind::UnopenedAlternates),
+        ("{{a,b},c}}", ErrorKind::UnopenedAlternates),
+        ("}{a,b}", ErrorKind::UnopenedAlternates),
+    ];
+    for (pattern, kind) in cases {
+        assert_eq!(Glob::new(pattern).unwrap_err().kind(), &kind, "{pattern}");
+    }
+}
+
+fn assert_matches(glob: Glob, matching: &[&str], nonmatching: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob.clone()).build().unwrap();
+    for &(paths, expected) in &[(matching, true), (nonmatching, false)] {
+        for path in paths {
+            assert_eq!(matcher.is_match(path), expected, "{}: {path}", glob);
+            assert_eq!(set.is_match(path), expected, "set {}: {path}", glob);
+        }
+    }
+}
+
+#[test]
+fn nested_alternates_match_complete_branches() {
+    assert_matches(
+        Glob::new("{a,b{c,d}}").unwrap(),
+        &["a", "bc", "bd"],
+        &["", "b", "be", "c", "abc", "bcd"],
+    );
+    assert_matches(
+        Glob::new("{{a,b},{c,d}}").unwrap(),
+        &["a", "b", "c", "d"],
+        &["", "ab", "e"],
+    );
+    assert_matches(
+        Glob::new("pre{a,{b,c}d,e}post{1,{2,3}}").unwrap(),
+        &["preapost1", "prebdpost2", "precdpost3", "preepost1"],
+        &["prebpost1", "precdpost4", "preabcdpost1"],
+    );
+}
+
+#[test]
+fn nested_alternates_combine_with_glob_features() {
+    assert_matches(
+        Glob::new("**/{node_modules/**/*/{ts,js},crates/**/*.{rs,toml}}")
+            .unwrap(),
+        &[
+            "node_modules/pkg/ts",
+            "project/node_modules/pkg/lib/js",
+            "crates/example/src/lib.rs",
+            "project/crates/example/Cargo.toml",
+        ],
+        &["node_modules/pkg/rs", "crates/example/lib.js"],
+    );
+    let pattern = "**/{node_modules/**/*.{ts,js},crates/**/*.{rs,toml}}";
+    let glob = GlobBuilder::new(pattern)
+        .literal_separator(true)
+        .build()
+        .unwrap();
+    assert_matches(
+        glob,
+        &[
+            "node_modules/index.ts",
+            "project/node_modules/pkg/lib/index.js",
+            "crates/lib.rs",
+            "project/crates/example/Cargo.toml",
+        ],
+        &["node_modules/index.rs", "crates/index.js", "src/lib.rs"],
+    );
+    assert_matches(
+        GlobBuilder::new("{src/{[ab]?,test*},docs/{*.md,*.txt}}")
+            .literal_separator(true)
+            .case_insensitive(true)
+            .build()
+            .unwrap(),
+        &["src/a1", "src/B2", "src/test_cases", "docs/README.md"],
+        &["src/c1", "src/a12", "docs/sub/readme.md", "docs/readme.rs"],
+    );
+}
+
+#[test]
+fn commas_and_escaped_braces_stay_literal_outside_groups() {
+    assert_matches(
+        Glob::new("x,{a,{b,c}},y").unwrap(),
+        &["x,a,y", "x,b,y", "x,c,y"],
+        &["xay", "x,,y", "x,a,b,y"],
+    );
+    assert_matches(
+        GlobBuilder::new(r"{a,\{b\,c\},[{]d[}]}")
+            .backslash_escape(true)
+            .build()
+            .unwrap(),
+        &["a", "{b,c}", "{d}"],
+        &["b", "c", "d"],
+    );
+}
+
+#[test]
+fn nested_empty_alternates_respect_options() {
+    for empty_alternates in [false, true] {
+        let glob = GlobBuilder::new("x{a,{,b}}y")
+            .empty_alternates(empty_alternates)
+            .build()
+            .unwrap();
+        let matcher = glob.compile_matcher();
+        assert!(matcher.is_match("xay"));
+        assert!(matcher.is_match("xby"));
+        assert_eq!(matcher.is_match("xy"), empty_alternates);
+    }
+    assert_matches(Glob::new("{{},{,}}").unwrap(), &[""], &["a"]);
+}
+
+#[test]
+fn deeply_nested_alternates() {
+    let depth = 64;
+    let pattern = format!("{}z{}", "{a,".repeat(depth), "}".repeat(depth));
+    assert_matches(Glob::new(&pattern).unwrap(), &["a", "z"], &["", "az"]);
+}
