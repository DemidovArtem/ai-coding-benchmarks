+/// A reader that simulates the short reads common on pipes and sockets.
+pub(crate) struct ShortReads<'a> {
+    bytes: &'a [u8],
+    max_read: usize,
+    pub(crate) reads: usize,
+}
+
+impl<'a> ShortReads<'a> {
+    pub(crate) fn new(bytes: &'a [u8], max_read: usize) -> ShortReads<'a> {
+        assert!(max_read > 0);
+        ShortReads { bytes, max_read, reads: 0 }
+    }
+}
+
+impl io::Read for ShortReads<'_> {
+    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+        self.reads += 1;
+        let len = buf.len().min(self.max_read);
+        io::Read::read(&mut self.bytes, &mut buf[..len])
+    }
+}
