 });
+
+fn check_anchored_global_ignores(dir: &Dir, global: bool) {
+    use std::path::{Path, PathBuf};
+
+    dir.create_dir("a/b/c/.git");
+    dir.create_dir("a/b/c/child");
+    dir.create_dir("home");
+    dir.create_dir("config");
+    dir.create("ignore", "/haystack");
+    dir.create("a/b/c/haystack", "ignored");
+    dir.create("a/b/c/keep", "visible");
+    dir.create("a/b/c/child/haystack", "visible");
+    let ignore = dir.path().join("ignore");
+    dir.create(
+        "home/.gitconfig",
+        &format!("[core]\nexcludesFile = {}\n", ignore.display()),
+    );
+    let cwd = dir.path().join("a/b/c");
+    for search in [
+        PathBuf::from("."),
+        PathBuf::from("./"),
+        cwd.clone(),
+        PathBuf::from("child"),
+        cwd.join("child"),
+    ] {
+        for serial in [false, true] {
+            let mut cmd = dir.command();
+            cmd.current_dir(&cwd).arg("--files");
+            cmd.cmd().env("HOME", dir.path().join("home"));
+            cmd.cmd().env("USERPROFILE", dir.path().join("home"));
+            cmd.cmd().env("XDG_CONFIG_HOME", dir.path().join("config"));
+            if !global {
+                cmd.arg("--no-ignore-global")
+                    .arg("--ignore-file")
+                    .arg(&ignore);
+            }
+            if serial {
+                cmd.args(&["--sort", "path"]);
+            } else {
+                cmd.args(&["-j", "2"]);
+            }
+            let output = cmd.arg(&search).output();
+            assert!(output.stderr.is_empty());
+            let searching_child =
+                search.file_name() == Some(Path::new("child").as_os_str());
+            let expected = if searching_child {
+                vec![search.join("haystack")]
+            } else {
+                vec![search.join("keep"), search.join("child/haystack")]
+            };
+            let expected = expected
+                .iter()
+                .map(|path| path.to_string_lossy().replace('\\', "/"))
+                .collect::<Vec<_>>()
+                .join("\n");
+            eqnice!(
+                sort_lines(&format!("{expected}\n")),
+                sort_lines(&String::from_utf8_lossy(&output.stdout))
+            );
+        }
+    }
+}
+
+rgtest!(global_gitignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    check_anchored_global_ignores(&dir, true);
+});
+
+rgtest!(explicit_ignore_absolute_paths, |dir: Dir, _: TestCommand| {
+    check_anchored_global_ignores(&dir, false);
+});
