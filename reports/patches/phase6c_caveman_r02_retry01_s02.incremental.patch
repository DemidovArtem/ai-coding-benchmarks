+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,118 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn assert_matches(pattern: &str, matches: &[&str], non_matches: &[&str]) {
+    let glob = GlobBuilder::new(pattern)
+        .allow_unclosed_class(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for path in matches {
+        assert!(matcher.is_match(path), "{pattern:?} should match {path:?}");
+        assert!(set.is_match(path), "{pattern:?} should match {path:?}");
+    }
+    for path in non_matches {
+        assert!(!matcher.is_match(path), "{pattern:?} matched {path:?}");
+        assert!(!set.is_match(path), "{pattern:?} matched {path:?}");
+    }
+}
+
+#[test]
+fn unclosed_classes_are_literal() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^", "[^]", "[z-a",
+        "[a*?", "[a{b,c}", "[abc\\", "[☃",
+    ] {
+        assert_matches(pattern, &[pattern], &["", "a", "abc", "☃"]);
+    }
+    assert_matches("prefix[abc", &["prefix[abc"], &["prefixa", "prefixabc"]);
+}
+
+#[test]
+fn unclosed_classes_are_strict_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        assert_eq!(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .allow_unclosed_class(false)
+                .build()
+                .unwrap_err()
+                .kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn closed_classes_keep_their_meaning() {
+    assert_matches("[abc]", &["a", "b", "c"], &["[abc]", "d"]);
+    assert_matches("[]]", &["]"], &["[]]", "["]);
+    assert_matches("[!]]", &["a", "["], &["]", "[!]]"]);
+    assert_matches("[a,b]", &["a", ",", "b"], &["[a,b]"]);
+    assert_matches("{[}],foo}", &["}", "foo"], &["[}", "bar"]);
+    assert_matches("[abc][xyz", &["a[xyz", "b[xyz"], &["[abc][xyz"]);
+    assert_eq!(
+        GlobBuilder::new("[z-a]")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::InvalidRange('z', 'a'),
+    );
+}
+
+#[test]
+fn unclosed_classes_in_alternation_branches() {
+    assert_matches("{[abc,xyz}", &["[abc", "xyz"], &["a", "[abc,xyz"]);
+    assert_matches("{[abc,[xyz}", &["[abc", "[xyz"], &["a", "xyz"]);
+    assert_matches("{[abc],[xyz}", &["a", "b", "c", "[xyz"], &["[abc]", "x"]);
+    assert_matches("{[abc,[xyz]}", &["[abc", "x", "y", "z"], &["a", "[xyz"]);
+    assert_matches(
+        "{[abc,*.rs}",
+        &["[abc", "lib.rs", ".rs"],
+        &["[abcd", "lib.js"],
+    );
+    assert_matches(
+        "{[abc,{[xyz,foo*}}",
+        &["[abc", "[xyz", "foo", "foobar"],
+        &["abc", "xyz", "bar"],
+    );
+    assert_matches("{[],[!],[][}", &["[]", "[!]", "[]["], &["", "]"]);
+    assert_eq!(
+        GlobBuilder::new("{[abc,xyz")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
+
+#[test]
+fn combines_with_other_builder_options() {
+    let glob = GlobBuilder::new("*/[AbC*?")
+        .allow_unclosed_class(true)
+        .case_insensitive(true)
+        .literal_separator(true)
+        .backslash_escape(true)
+        .build()
+        .unwrap();
+    let matcher = glob.compile_matcher();
+    assert!(matcher.is_match("dir/[abc*?"));
+    assert!(!matcher.is_match("dir/[abcZZ"));
+    assert!(!matcher.is_match("one/two/[abc*?"));
+}
+
+#[test]
+fn many_unclosed_brackets_and_branches() {
+    let pattern = "[".repeat(20_000);
+    assert_matches(&pattern, &[&pattern], &["["]);
+    let pattern = format!("{{{}}}", vec!["[abc"; 10_000].join(","));
+    assert_matches(&pattern, &["[abc"], &["abc"]);
+}
