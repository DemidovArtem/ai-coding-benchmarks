index 0000000000000000000000000000000000000000..9ff2c9abae1a2a725e05dd9508bc2ae0b9a4e3e8
--- /dev/null
+++ b/crates/globset/tests/unclosed_class.rs
@@ -0,0 +1,148 @@
+use globset::{ErrorKind, Glob, GlobBuilder, GlobSetBuilder};
+
+fn check_matches(glob: Glob, matches: &[&str], nonmatches: &[&str]) {
+    let matcher = glob.compile_matcher();
+    let set = GlobSetBuilder::new().add(glob).build().unwrap();
+    for path in matches {
+        assert!(matcher.is_match(path), "{path:?} should match {matcher:?}");
+        assert!(set.is_match(path), "{path:?} should match the glob set");
+    }
+    for path in nonmatches {
+        assert!(!matcher.is_match(path), "{path:?} matched {matcher:?}");
+        assert!(!set.is_match(path), "{path:?} matched the glob set");
+    }
+}
+
+#[test]
+fn unclosed_classes_are_errors_by_default() {
+    for pattern in ["[", "[abc", "[]", "[][", "[!", "[!]"] {
+        assert_eq!(
+            Glob::new(pattern).unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+        let mut builder = GlobBuilder::new(pattern);
+        builder.allow_unclosed_class(true).allow_unclosed_class(false);
+        assert_eq!(
+            builder.build().unwrap_err().kind(),
+            &ErrorKind::UnclosedClass,
+            "{pattern}",
+        );
+    }
+}
+
+#[test]
+fn unclosed_classes_and_their_contents_are_literal() {
+    for pattern in [
+        "[", "[abc", "[]", "[][", "[!", "[!]", "[^", "[^]", "[z-a",
+        "[abc*?{", "[☃",
+    ] {
+        check_matches(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap(),
+            &[pattern],
+            &["", "a", "abc", "z"],
+        );
+    }
+}
+
+#[test]
+fn unclosed_class_option_combines_with_other_options() {
+    check_matches(
+        GlobBuilder::new("src/*/[AbC?*")
+            .allow_unclosed_class(true)
+            .case_insensitive(true)
+            .literal_separator(true)
+            .build()
+            .unwrap(),
+        &["src/sub/[AbC?*", "SRC/sub/[abc?*"],
+        &["src/sub/deep/[AbC?*", "src/sub/[AbCx", "src/sub/a"],
+    );
+    check_matches(
+        GlobBuilder::new("[ab][cd")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap(),
+        &["a[cd", "b[cd"],
+        &["[ab][cd", "ac", "c[cd"],
+    );
+}
+
+#[test]
+fn unclosed_classes_respect_alternation_branches() {
+    for (pattern, matches, nonmatches) in [
+        ("{[abc,xyz}", &["[abc", "xyz"][..], &["a", "[abc,xyz}"][..]),
+        ("{[abc,[xyz}", &["[abc", "[xyz"][..], &["abc", "xyz"][..]),
+        ("{[abc],[xyz}", &["a", "b", "c", "[xyz"][..], &["[abc]", "x"][..]),
+        (
+            "pre{ok,{[abc,[xyz}}post*",
+            &["preokpost", "pre[abcpost", "pre[xyzpostfix"][..],
+            &["preapost", "pre[abc", "prexyzpost"][..],
+        ),
+    ] {
+        check_matches(
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap(),
+            matches,
+            nonmatches,
+        );
+    }
+}
+
+#[test]
+fn closed_classes_keep_existing_semantics() {
+    for pattern in [
+        "[abc]", "[]]", "[!]]", "[[]", "[!a-c]", "{[}],foo}",
+        "{[a,b],foo}", "[a-z][[]",
+    ] {
+        assert_eq!(
+            Glob::new(pattern).unwrap().regex(),
+            GlobBuilder::new(pattern)
+                .allow_unclosed_class(true)
+                .build()
+                .unwrap()
+                .regex(),
+            "{pattern}",
+        );
+    }
+    assert_eq!(
+        GlobBuilder::new("[z-a]")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::InvalidRange('z', 'a'),
+    );
+}
+
+#[test]
+fn unclosed_classes_do_not_hide_unclosed_alternation_groups() {
+    assert_eq!(
+        GlobBuilder::new("{[abc,xyz")
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap_err()
+            .kind(),
+        &ErrorKind::UnclosedAlternates,
+    );
+}
+
+#[test]
+fn many_unclosed_classes() {
+    let literal = "[".repeat(4096);
+    let branches = format!("{{{}}}", vec!["[abc"; 4096].join(","));
+    let cases = [(&literal, literal.as_str()), (&branches, "[abc")];
+    for (pattern, path) in cases {
+        let matcher = GlobBuilder::new(pattern)
+            .allow_unclosed_class(true)
+            .build()
+            .unwrap()
+            .compile_matcher();
+        assert!(matcher.is_match(path));
+        assert!(!matcher.is_match("abc"));
+    }
+}
