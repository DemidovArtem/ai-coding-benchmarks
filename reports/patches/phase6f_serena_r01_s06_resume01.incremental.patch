+#[test]
+fn limit_stops_matcher_calls() {
+    use std::cell::Cell;
+    use grep_matcher::{LineTerminator, Match, Matcher, NoCaptures, NoError};
+
+    struct Counted {
+        matcher: RegexMatcher,
+        calls: Cell<usize>,
+        fast: bool,
+    }
+    impl Matcher for Counted {
+        type Captures = NoCaptures;
+        type Error = NoError;
+
+        fn find_at(
+            &self,
+            haystack: &[u8],
+            at: usize,
+        ) -> Result<Option<Match>, NoError> {
+            self.calls.set(self.calls.get() + 1);
+            self.matcher.find_at(haystack, at)
+        }
+
+        fn new_captures(&self) -> Result<NoCaptures, NoError> {
+            Ok(NoCaptures::new())
+        }
+
+        fn line_terminator(&self) -> Option<LineTerminator> {
+            self.fast.then(|| LineTerminator::byte(b'\n'))
+        }
+    }
+
+    for (multiline, pattern, haystack) in [
+        (false, "hit", "hit\nhit\nhit\n"),
+        (true, r"a\nb", "a\nb\na\nb\n"),
+    ] {
+        for fast in [false, true] {
+            if multiline && fast {
+                continue;
+            }
+            let matcher = Counted {
+                matcher: RegexMatcher::new(pattern),
+                calls: Cell::new(0),
+                fast,
+            };
+            let mut searcher = SearcherBuilder::new()
+                .multi_line(multiline)
+                .max_matches(Some(1))
+                .build();
+            let mut sink = Recording::default();
+            searcher.search_slice(
+                &matcher, haystack.as_bytes(), &mut sink,
+            ).unwrap();
+            assert_eq!(matcher.calls.get(), 1);
+
+            matcher.calls.set(0);
+            let mut sink = Recording::default();
+            SearcherBuilder::new()
+                .multi_line(multiline)
+                .max_matches(Some(0))
+                .build()
+                .search_slice(&matcher, haystack.as_bytes(), &mut sink)
+                .unwrap();
+            assert_eq!(matcher.calls.get(), 0);
+        }
+    }
+}
+
+#[test]
+fn limit_stops_reader_at_a_buffer_boundary() {
+    struct ReadOnce(usize);
+    impl io::Read for ReadOnce {
+        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+            let bytes = b"other\nhit\n";
+            assert!(self.0 < bytes.len(), "read past the match limit");
+            // Permit the decoder to sniff the BOM using smaller reads.
+            let len = buf.len().min(bytes.len() - self.0);
+            buf[..len].copy_from_slice(&bytes[self.0..self.0 + len]);
+            self.0 += len;
+            Ok(len)
+        }
+    }
+    let matcher = RegexMatcher::new("hit");
+    let mut sink = Recording::default();
+    SearcherBuilder::new()
+        .heap_limit(Some(10))
+        .bom_sniffing(false)
+        .max_matches(Some(1))
+        .build()
+        .search_reader(&matcher, ReadOnce(0), &mut sink)
+        .unwrap();
+    assert_eq!(sink.events, vec![m(2, "hit\n")]);
+}
