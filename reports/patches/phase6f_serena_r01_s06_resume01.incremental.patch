index 0000000000000000000000000000000000000000..caf57b87a806e4232639b30053a3fa77cbaf48ff
--- /dev/null
+++ b/crates/searcher/src/searcher/max_matches.rs
@@ -0,0 +1,392 @@
+use std::io;
+
+use crate::{
+    testutil::RegexMatcher, Searcher, SearcherBuilder, Sink, SinkContext,
+    SinkFinish, SinkMatch,
+};
+
+#[derive(Debug, PartialEq)]
+enum Event {
+    Match(u64, String),
+    Context(u64, String),
+    Break,
+}
+
+#[derive(Default)]
+struct Recording {
+    events: Vec<Event>,
+    byte_count: u64,
+    stop_on_match: bool,
+}
+
+impl Sink for Recording {
+    type Error = io::Error;
+
+    fn matched(
+        &mut self,
+        _: &Searcher,
+        mat: &SinkMatch<'_>,
+    ) -> io::Result<bool> {
+        for (i, line) in mat.lines().enumerate() {
+            self.events.push(Event::Match(
+                mat.line_number().unwrap() + i as u64,
+                String::from_utf8(line.to_vec()).unwrap(),
+            ));
+        }
+        Ok(!self.stop_on_match)
+    }
+
+    fn context(
+        &mut self,
+        _: &Searcher,
+        context: &SinkContext<'_>,
+    ) -> io::Result<bool> {
+        self.events.push(Event::Context(
+            context.line_number().unwrap(),
+            String::from_utf8(context.bytes().to_vec()).unwrap(),
+        ));
+        Ok(true)
+    }
+
+    fn context_break(&mut self, _: &Searcher) -> io::Result<bool> {
+        self.events.push(Event::Break);
+        Ok(true)
+    }
+
+    fn finish(
+        &mut self,
+        _: &Searcher,
+        finish: &SinkFinish,
+    ) -> io::Result<()> {
+        self.byte_count = finish.byte_count();
+        Ok(())
+    }
+}
+
+fn m(number: u64, text: &str) -> Event {
+    Event::Match(number, text.to_string())
+}
+
+fn c(number: u64, text: &str) -> Event {
+    Event::Context(number, text.to_string())
+}
+
+fn check(
+    builder: &SearcherBuilder,
+    pattern: &str,
+    haystack: &str,
+    expected: &[Event],
+) {
+    for reader in [false, true] {
+        for fast in [false, true] {
+            if fast && pattern.contains("\\n") {
+                continue;
+            }
+            for candidates in [false, true] {
+                if candidates && !fast {
+                    continue;
+                }
+                let mut matcher = RegexMatcher::new(pattern);
+                if fast {
+                    matcher.set_line_term(Some(
+                        grep_matcher::LineTerminator::byte(b'\n'),
+                    ));
+                    matcher.every_line_is_candidate(candidates);
+                }
+                let mut sink = Recording::default();
+                let mut searcher = builder.build();
+                if reader {
+                    searcher
+                        .search_reader(
+                            &matcher,
+                            haystack.as_bytes(),
+                            &mut sink,
+                        )
+                        .unwrap();
+                } else {
+                    searcher
+                        .search_slice(&matcher, haystack.as_bytes(), &mut sink)
+                        .unwrap();
+                }
+                assert_eq!(
+                    sink.events, expected,
+                    "reader={reader}, fast={fast}, candidates={candidates}"
+                );
+            }
+        }
+    }
+}
+
+#[test]
+fn limit_configuration_and_line_searches() {
+    let mut builder = SearcherBuilder::new();
+    assert_eq!(builder.build().max_matches(), None);
+    let haystack = "Sherlock\nother\nSherlock again\nSherlock twice\n";
+    for multiline in [false, true] {
+        builder.multi_line(multiline);
+        builder.max_matches(Some(0));
+        assert_eq!(builder.build().max_matches(), Some(0));
+        check(&builder, "Sherlock", haystack, &[]);
+        builder.max_matches(Some(1));
+        check(&builder, "Sherlock", haystack, &[m(1, "Sherlock\n")]);
+        builder.max_matches(Some(2));
+        check(
+            &builder,
+            "Sherlock",
+            haystack,
+            &[m(1, "Sherlock\n"), m(3, "Sherlock again\n")],
+        );
+        builder.max_matches(None);
+        check(
+            &builder,
+            "Sherlock",
+            haystack,
+            &[
+                m(1, "Sherlock\n"),
+                m(3, "Sherlock again\n"),
+                m(4, "Sherlock twice\n"),
+            ],
+        );
+    }
+}
+
+#[test]
+fn multiline_counts_spans_before_grouping() {
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).max_matches(Some(1));
+    check(
+        &builder,
+        r"a\nb",
+        "skip\na\nb\na\nb\na\nb\n",
+        &[m(2, "a\n"), m(3, "b\n")],
+    );
+    builder.max_matches(Some(2));
+    check(
+        &builder,
+        r"a\nb",
+        "skip\na\nb\na\nb\na\nb\n",
+        &[m(2, "a\n"), m(3, "b\n"), m(4, "a\n"), m(5, "b\n")],
+    );
+    builder.max_matches(Some(1));
+    check(
+        &builder,
+        r"a\nb",
+        "a\nba\nb\n",
+        &[m(1, "a\n"), m(2, "ba\n")],
+    );
+}
+
+#[test]
+fn after_context_matches_extend_the_window() {
+    for multiline in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multiline).max_matches(Some(1)).after_context(2);
+        check(
+            &builder,
+            "hit",
+            "hit\na\nhit\nb\nhit\nc\nd\ngap\nhit\n",
+            &[
+                m(1, "hit\n"), c(2, "a\n"), m(3, "hit\n"),
+                c(4, "b\n"), m(5, "hit\n"), c(6, "c\n"), c(7, "d\n"),
+            ],
+        );
+    }
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).max_matches(Some(1)).after_context(1);
+    check(
+        &builder,
+        r"a\nb",
+        "a\nb\na\nb\nend\ngap\na\nb\n",
+        &[
+            m(1, "a\n"), m(2, "b\n"), m(3, "a\n"),
+            m(4, "b\n"), c(5, "end\n"),
+        ],
+    );
+}
+
+#[test]
+fn inverted_limits_count_nonmatching_lines() {
+    for multiline in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multiline).invert_match(true).max_matches(Some(1));
+        check(&builder, "hit", "hit\na\nb\nhit\n", &[m(2, "a\n")]);
+        builder.max_matches(Some(2)).after_context(1);
+        check(
+            &builder, "hit", "a\nhit\nb\nhit\nhit\nc\n",
+            &[m(1, "a\n"), c(2, "hit\n"), m(3, "b\n"), c(4, "hit\n")],
+        );
+        builder.max_matches(Some(1));
+        check(
+            &builder, "hit", "a\nb\nhit\nhit\nc\n",
+            &[m(1, "a\n"), m(2, "b\n"), c(3, "hit\n")],
+        );
+    }
+}
+
+#[test]
+fn context_and_limit_survive_buffer_rolls() {
+    let mut builder = SearcherBuilder::new();
+    builder.max_matches(Some(2)).before_context(1).after_context(1);
+    builder.heap_limit(Some(16));
+    check(
+        &builder, "hit", "0\nhit\na\ngap\nb\nhit\nc\ngap\nhit\n",
+        &[
+            c(1, "0\n"), m(2, "hit\n"), c(3, "a\n"), Event::Break,
+            c(5, "b\n"), m(6, "hit\n"), c(7, "c\n"),
+        ],
+    );
+}
+
+#[test]
+fn passthrough_emits_remaining_lines_without_more_matches() {
+    for multiline in [false, true] {
+        let mut builder = SearcherBuilder::new();
+        builder.multi_line(multiline).passthru(true).max_matches(Some(1));
+        check(
+            &builder, "hit", "first\nhit\nother\nhit\nlast\n",
+            &[
+                c(1, "first\n"), m(2, "hit\n"), c(3, "other\n"),
+                c(4, "hit\n"), c(5, "last\n"),
+            ],
+        );
+    }
+    let mut builder = SearcherBuilder::new();
+    builder.multi_line(true).passthru(true).max_matches(Some(1));
+    check(
+        &builder, r"a\nb", "a\nb\na\nb\nlast\n",
+        &[
+            m(1, "a\n"), m(2, "b\n"), c(3, "a\n"),
+            c(4, "b\n"), c(5, "last\n"),
+        ],
+    );
+}
+
+#[test]
+fn zero_limit_never_reads_input() {
+    struct Unreadable;
+    impl io::Read for Unreadable {
+        fn read(&mut self, _: &mut [u8]) -> io::Result<usize> {
+            panic!("zero-limit search must not read");
+        }
+    }
+    for multiline in [false, true] {
+        let matcher = RegexMatcher::new(r"a\nb");
+        let mut sink = Recording::default();
+        SearcherBuilder::new()
+            .multi_line(multiline)
+            .max_matches(Some(0))
+            .build()
+            .search_reader(&matcher, Unreadable, &mut sink)
+            .unwrap();
+        assert!(sink.events.is_empty());
+        assert_eq!(sink.byte_count, 0);
+    }
+}
+
+#[test]
+fn sink_can_stop_on_the_final_multiline_match() {
+    let matcher = RegexMatcher::new(r"a\nb");
+    let mut sink = Recording { stop_on_match: true, ..Recording::default() };
+    SearcherBuilder::new()
+        .multi_line(true)
+        .max_matches(Some(1))
+        .after_context(2)
+        .build()
+        .search_slice(&matcher, b"a\nb\ncontext\na\nb\n", &mut sink)
+        .unwrap();
+    assert_eq!(sink.events, vec![m(1, "a\n"), m(2, "b\n")]);
+}
