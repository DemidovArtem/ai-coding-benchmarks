diff --git a/tests/e2e/test_codex_framework.py b/tests/e2e/test_codex_framework.py
index 1be249f..0c8be4b 100644
--- a/tests/e2e/test_codex_framework.py
+++ b/tests/e2e/test_codex_framework.py
@@ -1,6 +1,36 @@
 """Focused tests for the Codex agent adapter."""
 
 from harness.e2e.agents.codex import CodexFramework
+from pathlib import Path
+from harness.e2e.agent_runner import AgentRunner
+
+
+def test_oauth_refresh_preserves_experiment_configuration(tmp_path, monkeypatch):
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    (tmp_path / ".codex").mkdir()
+    (tmp_path / ".codex/auth.json").write_text('{"tokens": {"access_token": "test"}}')
+    (tmp_path / ".codex/config.toml").write_text("private-global-settings")
+    runner = AgentRunner("test", agent_name="codex")
+    copied = []
+    monkeypatch.setattr(runner, "_copy_host_file_to_container", lambda src, dst: copied.append(dst) or True)
+    monkeypatch.setattr(runner, "_append_session_history", lambda event: None)
+    assert runner._refresh_codex_credentials()
+    assert copied == ["/home/fakeroot/.codex/auth.json"]
+
+
+def test_oauth_mount_never_exposes_host_configuration(tmp_path, monkeypatch):
+    monkeypatch.delenv("UNIFIED_API_KEY", raising=False)
+    monkeypatch.delenv("UNIFIED_BASE_URL", raising=False)
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    (tmp_path / ".codex").mkdir()
+    (tmp_path / ".codex/auth.json").write_text("secret-auth")
+    (tmp_path / ".codex/config.toml").write_text("secret-config")
+    framework = CodexFramework()
+    monkeypatch.setattr(framework, "get_quarantine_mounts", lambda: [])
+
+    assert framework.get_container_mounts() == [
+        "-v", f"{tmp_path}/.codex/auth.json:/tmp/host-codex/auth.json:ro",
+    ]
 
 
 def test_codex_oauth_reports_chatgpt_network_endpoint(monkeypatch):
